---
import type { Product } from "../data/Bestsellerdata";
import ProductCard from "./ProductCard.astro";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<div data-carousel-wrapper class="w-full">
  <div class="group relative">
  <div
    data-product-carousel
    class="cursor-grab overflow-hidden select-none touch-pan-y active:cursor-grabbing"
  >
    <div data-product-track class="flex gap-4 sm:gap-5 will-change-transform">
      {
        products.map((product) => (
          <div
            data-product-item
            class="w-full min-w-0 shrink-0 min-[360px]:w-[calc(50%-8px)] sm:w-[calc(50%-10px)] lg:w-[calc(25%-15px)]"
          >
            <ProductCard product={product} />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Navigation Buttons -->
  {
    products.length > 1 && (
      <>
        <button
          type="button"
          data-carousel-prev
          aria-label="Previous products"
          class="carousel-nav-btn absolute -left-3 sm:-left-4 md:-left-5 lg:-left-6 top-[28%] sm:top-[30%] lg:top-[198.5px] z-10 inline-flex size-8 sm:size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 backdrop-blur-sm border border-white/10 text-2xl leading-none text-white hover:bg-[#c5a259] hover:text-[#12221b] focus-visible:opacity-100 focus-visible:pointer-events-auto"
        >
          &lsaquo;
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Next products"
          class="carousel-nav-btn absolute -right-3 sm:-right-4 md:-right-5 lg:-right-6 top-[28%] sm:top-[30%] lg:top-[198.5px] z-10 inline-flex size-8 sm:size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/60 backdrop-blur-sm border border-white/10 text-2xl leading-none text-white hover:bg-[#c5a259] hover:text-[#12221b] focus-visible:opacity-100 focus-visible:pointer-events-auto"
        >
          &rsaquo;
        </button>
      </>
    )
  }
</div>

<!-- Pagination Dots -->
{
  products.length > 1 && (
    <div
      role="group"
      class="mt-8 flex justify-center gap-2"
      data-carousel-dots
      aria-label="Choose product page"
    />
  )
}
</div>

<script>
  interface PointerDragState {
    active: boolean;
    isHorizontal: boolean | undefined;
    startX: number;
    startY: number;
    startPage: number;
    startCurrentX: number;
    lastX: number;
    lastTime: number;
    velocity: number;
    lastDx: number;
    hasMoved: boolean;
  }

  const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
  const lcm = (a: number, b: number): number =>
    a === 0 || b === 0 ? 0 : Math.abs(a * b) / gcd(a, b);

  const setupSingleCarousel = (wrapper: HTMLElement) => {
    if (wrapper.dataset.carouselInit) return;
    wrapper.dataset.carouselInit = "true";

      const carousel = wrapper.querySelector<HTMLElement>("[data-product-carousel]");
      const track = wrapper.querySelector<HTMLElement>("[data-product-track]");
      const dotsContainer = wrapper.querySelector<HTMLElement>("[data-carousel-dots]");
      const previous = wrapper.querySelector<HTMLButtonElement>("[data-carousel-prev]");
      const next = wrapper.querySelector<HTMLButtonElement>("[data-carousel-next]");

      if (carousel && track) {
        const originalItems = Array.from(track.querySelectorAll<HTMLElement>("[data-product-item]"));
        const realCount = originalItems.length;

        if (realCount > 1) {
          // Build seamless buffer: baseCycleCount is LCM(realCount, 4)
          // Guarantees clean integer page steps on desktop (4 cards), tablet/mobile (2 cards), or small mobile (1 card)
          const baseCycleCount = lcm(realCount, 4);

          const createCycleFragment = (ariaHidden: boolean) => {
            const fragment = document.createDocumentFragment();
            for (let i = 0; i < baseCycleCount; i++) {
              const clone = originalItems[i % realCount].cloneNode(true) as HTMLElement;
              if (ariaHidden) {
                clone.setAttribute("aria-hidden", "true");
                clone.setAttribute("inert", "");
                clone.querySelectorAll<HTMLElement>("a, button, input, [tabindex]").forEach((el) => {
                  el.setAttribute("tabindex", "-1");
                });
              } else {
                clone.removeAttribute("aria-hidden");
                clone.removeAttribute("inert");
              }
              fragment.appendChild(clone);
            }
            return fragment;
          };

          track.innerHTML = "";
          track.appendChild(createCycleFragment(true));  // Set 0 (Clone before)
          track.appendChild(createCycleFragment(false)); // Set 1 (Center home set)
          track.appendChild(createCycleFragment(true));  // Set 2 (Clone after)

          const homeIndex = baseCycleCount;

          let cardStep = 0;
          let cardsPerPage = 2;
          let activeCycleCount = baseCycleCount;
          let totalPages = 4;
          let pageStep = 0;
          let cycleWidth = 0;
          let homeX = 0;
          let currentX = 0;
          let targetX = 0;
          let rafId: number | null = null;
          let dots: HTMLButtonElement[] = [];

          const measure = () => {
            cardsPerPage = window.innerWidth >= 1024 ? 4 : window.innerWidth < 360 ? 1 : 2;
            activeCycleCount = lcm(realCount, cardsPerPage);
            totalPages = activeCycleCount / cardsPerPage;

            const allItems = Array.from(track.querySelectorAll<HTMLElement>("[data-product-item]"));
            if (allItems.length > homeIndex + 1) {
              cardStep = allItems[homeIndex + 1].getBoundingClientRect().left - allItems[homeIndex].getBoundingClientRect().left;
            } else {
              const firstItem = track.querySelector<HTMLElement>("[data-product-item]");
              const gap = parseFloat(window.getComputedStyle(track).gap) || (window.innerWidth >= 640 ? 20 : 16);
              cardStep = (firstItem?.offsetWidth ?? 0) + gap;
            }

            cycleWidth = activeCycleCount * cardStep;
            pageStep = cardsPerPage * cardStep;
            homeX = -homeIndex * cardStep;
          };

          const renderDots = () => {
            if (!dotsContainer) return;
            if (totalPages <= 1) {
              dotsContainer.style.display = "none";
              return;
            }
            dotsContainer.style.display = "flex";
            dotsContainer.innerHTML = "";
            dots = [];

            for (let i = 0; i < totalPages; i++) {
              const dot = document.createElement("button");
              dot.type = "button";
              dot.setAttribute("data-carousel-dot", String(i));
              dot.setAttribute("aria-label", `Go to product page ${i + 1}`);
              dot.setAttribute("aria-current", i === 0 ? "true" : "false");
              dot.className = `size-2.5 rounded-full transition-colors ${
                i === 0 ? "bg-[#333333]" : "bg-[#d1d1d1]"
              }`;
              dot.addEventListener("click", () => {
                goToPage(i);
              });
              dotsContainer.appendChild(dot);
              dots.push(dot);
            }
          };

          measure();
          renderDots();
          currentX = homeX;
          targetX = homeX;
          track.style.transform = `translate3d(${currentX}px, 0, 0)`;

          const normalizeBounds = () => {
            const minX = homeX - cycleWidth;
            const maxX = homeX;
            while (currentX <= minX) {
              currentX += cycleWidth;
              targetX += cycleWidth;
            }
            while (currentX > maxX) {
              currentX -= cycleWidth;
              targetX -= cycleWidth;
            }
          };

          const updateDots = () => {
            if (!dots.length || pageStep === 0) return;
            const normOffset = ((homeX - currentX) % cycleWidth + cycleWidth) % cycleWidth;
            const activePage = Math.min(
              totalPages - 1,
              Math.max(0, Math.round(normOffset / pageStep) % totalPages)
            );

            dots.forEach((dot, i) => {
              if (i === activePage) {
                dot.classList.add("bg-[#333333]");
                dot.classList.remove("bg-[#d1d1d1]");
                dot.setAttribute("aria-current", "true");
              } else {
                dot.classList.remove("bg-[#333333]");
                dot.classList.add("bg-[#d1d1d1]");
                dot.setAttribute("aria-current", "false");
              }
            });
          };

          const tick = () => {
            const dist = targetX - currentX;
            if (Math.abs(dist) > 0.3) {
              currentX += dist * 0.18;
              normalizeBounds();
              track.style.transform = `translate3d(${currentX}px, 0, 0)`;
              updateDots();
              rafId = requestAnimationFrame(tick);
            } else {
              currentX = targetX;
              normalizeBounds();
              track.style.transform = `translate3d(${currentX}px, 0, 0)`;
              updateDots();
              rafId = null;
            }
          };

          const startAnimation = () => {
            if (rafId === null) {
              rafId = requestAnimationFrame(tick);
            }
          };

          // 5-second delay / idle visibility management for navigation buttons (Desktop only)
          const isDesktop = () => window.innerWidth >= 1024;
          const navButtons = [previous, next].filter(Boolean) as HTMLButtonElement[];
          let hideTimer: number | null = null;

          const showButtons = () => {
            navButtons.forEach((btn) => {
              btn.classList.add("is-active");
            });
          };

          const hideButtons = () => {
            if (!isDesktop()) return;
            navButtons.forEach((btn) => {
              btn.classList.remove("is-active");
            });
          };

          const startHideTimer = () => {
            // Only auto-hide on desktop (>= 1024px)
            if (!isDesktop()) {
              showButtons();
              return;
            }
            if (hideTimer !== null) {
              clearTimeout(hideTimer);
            }
            hideTimer = window.setTimeout(() => {
              hideButtons();
              hideTimer = null;
            }, 5000);
          };

          const pokeButtons = () => {
            showButtons();
            if (isDesktop()) {
              startHideTimer();
            }
          };

          const goNext = () => {
            pokeButtons();
            const currentPage = Math.round((homeX - targetX) / pageStep);
            targetX = homeX - (currentPage + 1) * pageStep;
            startAnimation();
          };

          const goPrev = () => {
            pokeButtons();
            const currentPage = Math.round((homeX - targetX) / pageStep);
            targetX = homeX - (currentPage - 1) * pageStep;
            startAnimation();
          };

          const goToPage = (i: number) => {
            pokeButtons();
            const normOffset = ((homeX - targetX) % cycleWidth + cycleWidth) % cycleWidth;
            const currentTargetPage = Math.round(normOffset / pageStep) % totalPages;
            let diff = i - currentTargetPage;
            if (diff > totalPages / 2) diff -= totalPages;
            if (diff < -totalPages / 2) diff += totalPages;

            const continuousPage = Math.round((homeX - targetX) / pageStep);
            targetX = homeX - (continuousPage + diff) * pageStep;
            startAnimation();
          };

          next?.addEventListener("click", goNext);
          previous?.addEventListener("click", goPrev);

          // On mobile & tablet: persistent. On desktop PC: start completely hidden on initial load / refresh.
          if (!isDesktop()) {
            showButtons();
          } else {
            hideButtons();
          }

          // User interaction on wrapper reveals buttons on desktop and starts 5s timer
          wrapper.addEventListener("pointerenter", () => {
            if (isDesktop()) pokeButtons();
            else showButtons();
          });
          wrapper.addEventListener("pointermove", () => {
            if (isDesktop()) pokeButtons();
            else showButtons();
          }, { passive: true });
          wrapper.addEventListener("touchstart", showButtons, { passive: true });
          wrapper.addEventListener("pointerleave", () => {
            if (isDesktop()) startHideTimer();
            else showButtons();
          });

          // Prevent hiding while directly hovering/focusing the button itself
          navButtons.forEach((btn) => {
            btn.addEventListener("pointerenter", () => {
              showButtons();
              if (hideTimer !== null) {
                clearTimeout(hideTimer);
                hideTimer = null;
              }
            });
            btn.addEventListener("pointerleave", () => {
              startHideTimer();
            });
            btn.addEventListener("focus", () => {
              showButtons();
              if (hideTimer !== null) {
                clearTimeout(hideTimer);
                hideTimer = null;
              }
            });
            btn.addEventListener("blur", () => {
              startHideTimer();
            });
          });

          const handleResizeOrLoad = () => {
            if (!isDesktop()) {
              if (hideTimer !== null) {
                clearTimeout(hideTimer);
                hideTimer = null;
              }
              showButtons();
            }
            let activePage = 0;
            if (pageStep > 0 && cycleWidth > 0) {
              const normOffset = ((homeX - currentX) % cycleWidth + cycleWidth) % cycleWidth;
              activePage = Math.round(normOffset / pageStep) % totalPages;
            }
            const prevTotalPages = totalPages;
            measure();
            if (prevTotalPages !== totalPages) {
              renderDots();
            }
            const clampedPage = Math.min(totalPages - 1, Math.max(0, activePage));
            currentX = homeX - clampedPage * pageStep;
            targetX = currentX;
            normalizeBounds();
            track.style.transform = `translate3d(${currentX}px, 0, 0)`;
            updateDots();
          };

          window.addEventListener("resize", handleResizeOrLoad);
          window.addEventListener("load", handleResizeOrLoad);
          document.fonts?.ready?.then(handleResizeOrLoad);

          const gestureState: PointerDragState = {
            active: false,
            isHorizontal: undefined,
            startX: 0,
            startY: 0,
            startPage: 0,
            startCurrentX: 0,
            lastX: 0,
            lastTime: 0,
            velocity: 0,
            lastDx: 0,
            hasMoved: false,
          };

          const handlePointerStart = (clientX: number, clientY: number) => {
            if (rafId !== null) {
              cancelAnimationFrame(rafId);
              rafId = null;
            }

            normalizeBounds();
            track.style.transform = `translate3d(${currentX}px, 0, 0)`;

            gestureState.active = true;
            gestureState.hasMoved = false;
            gestureState.isHorizontal = undefined;
            gestureState.startX = clientX;
            gestureState.startY = clientY;
            gestureState.lastX = clientX;
            gestureState.lastTime = performance.now();
            gestureState.startCurrentX = currentX;
            gestureState.startPage = Math.round((homeX - currentX) / pageStep);
            gestureState.velocity = 0;
            gestureState.lastDx = 0;
          };

          const handlePointerMove = (clientX: number, clientY: number, preventDefault?: () => void) => {
            if (!gestureState.active) return;

            const dx = clientX - gestureState.startX;
            const dy = clientY - gestureState.startY;

            if (gestureState.isHorizontal === undefined) {
              const absX = Math.abs(dx);
              const absY = Math.abs(dy);
              if (absX > 5 || absY > 5) {
                gestureState.isHorizontal = absX > absY;
              }
            }

            if (gestureState.isHorizontal === false) {
              gestureState.active = false;
              return;
            }

            if (gestureState.isHorizontal === true) {
              preventDefault?.();
              gestureState.hasMoved = true;
              gestureState.lastDx = dx;

              const now = performance.now();
              const dt = now - gestureState.lastTime;
              if (dt > 0) {
                const instantV = (clientX - gestureState.lastX) / dt;
                gestureState.velocity = 0.7 * gestureState.velocity + 0.3 * instantV;
              }
              gestureState.lastX = clientX;
              gestureState.lastTime = now;

              currentX = gestureState.startCurrentX + dx;
              targetX = currentX;

              track.style.transform = `translate3d(${currentX}px, 0, 0)`;
              updateDots();
            }
          };

          const handlePointerEnd = () => {
            if (!gestureState.active) return;
            gestureState.active = false;

            if (!gestureState.hasMoved) return;

            const threshold = pageStep * 0.18;
            let pageDiff = 0;

            if (gestureState.velocity < -0.22 || gestureState.lastDx < -threshold) {
              pageDiff = 1;
            } else if (gestureState.velocity > 0.22 || gestureState.lastDx > threshold) {
              pageDiff = -1;
            }

            const targetPage = gestureState.startPage + pageDiff;
            targetX = homeX - targetPage * pageStep;
            startAnimation();
          };

          // Touch Listeners
          carousel.addEventListener(
            "touchstart",
            (e) => handlePointerStart(e.touches[0].clientX, e.touches[0].clientY),
            { passive: false }
          );

          carousel.addEventListener(
            "touchmove",
            (e) => handlePointerMove(e.touches[0].clientX, e.touches[0].clientY, () => e.cancelable && e.preventDefault()),
            { passive: false }
          );

          carousel.addEventListener("touchend", handlePointerEnd, { passive: true });
          carousel.addEventListener("touchcancel", handlePointerEnd, { passive: true });

          // Mouse Listeners
          carousel.addEventListener("mousedown", (e) => {
            if (e.button !== 0 || (e.target as HTMLElement).closest("button, a")) return;
            handlePointerStart(e.pageX, e.pageY);
          });

          window.addEventListener("mousemove", (e) => {
            if (!gestureState.active) return;
            handlePointerMove(e.pageX, e.pageY, () => e.preventDefault());
          });

          window.addEventListener("mouseup", handlePointerEnd);

          carousel.addEventListener(
            "click",
            (e) => {
              if (gestureState.hasMoved) {
                e.preventDefault();
                e.stopPropagation();
                gestureState.hasMoved = false;
              }
            },
            true
          );
        }
      }
    };

    const initCarousels = () => {
      const wrappers = document.querySelectorAll<HTMLElement>("[data-carousel-wrapper]");
      if (!("IntersectionObserver" in window)) {
        wrappers.forEach(setupSingleCarousel);
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setupSingleCarousel(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "350px" }
      );

      wrappers.forEach((wrapper) => {
        if (!wrapper.dataset.carouselInit) {
          observer.observe(wrapper);
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initCarousels);
    } else {
      initCarousels();
    }
    document.addEventListener("astro:page-load", initCarousels);
</script>

<style>
  .carousel-nav-btn {
    transition: opacity 0.2s ease-in-out, background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  /* On mobile and tablet (< 1024px), navigation buttons stay permanently visible */
  @media (max-width: 1023px) {
    .carousel-nav-btn {
      opacity: 1 !important;
      pointer-events: auto !important;
    }
  }

  /* On desktop PC (>= 1024px): hidden by default on fresh load / refresh.
     Only shown when user moves mouse into the carousel cards (.is-active) */
  @media (min-width: 1024px) {
    .carousel-nav-btn {
      opacity: 0;
      pointer-events: none;
    }
    .carousel-nav-btn.is-active {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .carousel-nav-btn:focus-visible {
    opacity: 1 !important;
    pointer-events: auto !important;
  }
</style>

