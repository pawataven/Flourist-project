---
import type { Product } from "../Bestsellerdata";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article data-product-card class="group select-none">
  <div class="relative aspect-square w-full overflow-hidden rounded-xl bg-[#ead0ae]">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(255,255,255,0.55),transparent_34%),linear-gradient(145deg,#f4d8b1,#d8a874)]"></div>
    {product.image && (
      <img
        src={product.image.src}
        alt={product.title}
        loading="lazy"
        draggable="false"
        class="absolute inset-0 size-full object-cover"
      />
    )}

  </div>
  <div class="pt-4 text-[#171513]">
    
    <h2 class="font-sans text-[18px] font-bold leading-tight">{product.title}</h2>
    <dl class="mt-3 space-y-1 font-sans text-sm">
      {
        product.prices.map(({ size, price }) => (
          <div class="flex items-baseline justify-between gap-4">
            <dt class="font-bold text-[18px]">{size}</dt>
            <dd class="shrink-0 text-right text-[18px]">{price}</dd>
          </div>
        ))
      }
    </dl>
    {product.note && <p class="mt-5 font-sans text-base font-bold">{product.note}</p>}
    <p class:list={["mt-3 font-sans text-sm leading-relaxed", product.note && "mt-1"]}>
      {product.description}
    </p>
  </div>
</article>
