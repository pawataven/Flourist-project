---
import type { Product } from "../data/Bestsellerdata";
import { Image } from "astro:assets";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article data-product-card class="group w-full select-none">
  <div class="relative aspect-square w-full overflow-hidden rounded-xl bg-[#12221b] isolate">
    {product.image && (
      <Image
        src={product.image}
        alt={product.title}
        format="webp"
        quality={80}
        width={480}
        widths={[200, 320, 480, 640, 960]}
        sizes="(min-width: 1280px) 289px, (min-width: 1024px) calc(25vw - 31px), (min-width: 640px) calc(50vw - 42px), calc(50vw - 32px)"
        loading="lazy"
        draggable="false"
        class="absolute inset-0 size-full object-cover rounded-xl"
      />
    )}
  </div>
  <div class="pt-3 sm:pt-4 px-1 text-white">
    <h2 class="font-sans text-[14px] sm:text-[17px] font-bold leading-snug line-clamp-2 min-h-[2.5rem] sm:min-h-[2.75rem]">{product.title}</h2>
    <dl class="mt-2 space-y-1 font-sans">
      {
        product.prices.map(({ size, price }) => (
          <div class="flex items-baseline justify-between gap-1">
            <dt class="font-bold text-[13px] sm:text-[16px] text-[#c5a259] shrink-0">{size}</dt>
            <dd class="shrink-0 text-right text-[13px] sm:text-[16px] font-bold text-[#c5a259] whitespace-nowrap">{price}</dd>
          </div>
        ))
      }
    </dl>
    {product.note && <p class="mt-2 font-sans text-xs sm:text-sm font-semibold text-[#8c6b3f]">{product.note}</p>}
    <p class:list={["mt-2 font-sans text-xs sm:text-sm leading-relaxed text-white", product.note && "mt-1"]}>
      {product.description}
    </p>
  </div>
</article>
