---
import type { Boxset } from "../data/Boxsetdata";
import { Image } from "astro:assets";

interface Props {
  boxset: Boxset;
}

const { boxset } = Astro.props;
---

<article
  data-product-card
  class="group flex flex-col items-center w-full max-w-[640px] mx-auto select-none"
>
  <!-- Large Centered Image Showcase -->
  <div class="w-full flex flex-col justify-center">
    <div
      class="relative aspect-[3/4] w-full overflow-hidden rounded-xl sm:rounded-2xl bg-[#e5e5e5] border border-white/10 shadow-2xl"
    >
      {
        boxset.image && (
          <Image
            src={boxset.image}
            alt={boxset.title}
            format="webp"
            quality={90}
            width={1086}
            widths={[360, 540, 720, 960, 1086, 1440]}
            sizes="(min-width: 1024px) 768px, (min-width: 640px) 672px, calc(100vw - 32px)"
            loading="lazy"
            class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
          />
        )
      }
    </div>
  </div>

  <!-- Product Details & Description (Equal to ProductCard) -->
  <div class="w-full min-w-0 pt-3 text-white sm:pt-4">
    <h3
      class="whitespace-nowrap font-display pt-2 text-[14px] uppercase sm:text-[12px] font-bold leading-snug tracking-[0.12em] sm:tracking-[0.25em]"
    >
      {boxset.title}
    </h3>

    <dl class="mt-2 space-y-1 font-sans">
      {
        boxset.prices.map(({ size, price }) => (
          <div class="flex items-baseline justify-between gap-1">
            <dt class="font-bold text-[13px] sm:text-[16px] text-[#c5a259] shrink-0">
              {size}
            </dt>
            <dd class="shrink-0 text-right text-[13px] sm:text-[16px] font-bold text-[#c5a259] whitespace-nowrap">
              {price}
            </dd>
          </div>
        ))
      }
    </dl>

    {
      boxset.note && (
        <p class="mt-2 font-sans text-xs sm:text-sm font-semibold text-[#8c6b3f] text-center">
          {boxset.note}
        </p>
      )
    }

    <p
      lang="th"
      class:list={[
        "mt-2 min-w-0 font-sans text-xs sm:text-sm leading-relaxed text-center break-words [word-break:break-word] [text-wrap:pretty]",
        boxset.note && "mt-1",
      ]}
    >
      {boxset.description}
    </p>

    <div class="mt-4 sm:mt-6 pt-1">
      <button
        type="button"
        aria-controls="delivery-options"
        aria-expanded="false"
        aria-haspopup="dialog"
        class="delivery-trigger w-full cursor-pointer flex items-center justify-center rounded-md bg-[#c5a259] px-6 py-3 sm:py-3.5 font-sans text-sm sm:text-base font-bold text-[#12221b] transition-all hover:bg-[#b08d4a] active:scale-[0.99] shadow-md"
      >
        สั่งซื้อ
      </button>
    </div>
  </div>
</article>
