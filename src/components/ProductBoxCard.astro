---
import type { Boxset } from "../Boxsetdata";

interface Props {
  boxset: Boxset;
}

const { boxset } = Astro.props;
---

<article data-product-card class="group w-[400px] max-w-full select-none">
  <div class="relative aspect-square w-[400px] max-w-full overflow-hidden rounded-xl bg-[#ead0ae]">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(255,255,255,0.55),transparent_34%),linear-gradient(145deg,#f4d8b1,#d8a874)]"></div>
    {boxset.image && (
      <img
        src={boxset.image.src}
        alt={boxset.title}
        loading="lazy"
        draggable="false"
        class="absolute inset-0 size-full object-cover"
      />
    )}

  </div>
  <div class="pt-3 sm:pt-4 px-1 text-white">
    <h2 class="font-sans text-[14px] sm:text-[17px] font-bold leading-snug line-clamp-2 min-h-[2.5rem] sm:min-h-[2.75rem]">{boxset.title}</h2>
    <dl class="mt-2 space-y-1 font-sans">
      {
        boxset.prices.map(({ size, price }) => (
          <div class="flex items-baseline justify-between gap-1">
            <dt class="font-bold text-[13px] sm:text-[16px] text-[#c5a259] shrink-0">{size}</dt>
            <dd class="shrink-0 text-right text-[13px] sm:text-[16px] font-bold text-[#c5a259] whitespace-nowrap">{price}</dd>
          </div>
        ))
      }
    </dl>
    {boxset.note && <p class="mt-2 font-sans text-xs sm:text-sm font-semibold text-[#8c6b3f]">{boxset.note}</p>}
    <p class:list={["mt-2 font-sans text-xs sm:text-sm leading-relaxed text-white", boxset.note && "mt-1"]}>
      {boxset.description}
    </p>
  </div>
</article>
