                          </div>
                        ))}
                      </div>

                      <!-- Branch note -->
                      <!-- Branch note -->
                      <div class="pt-2 border-t border-[#c5a259]/20 text-center">
                        <p class="text-[9px] text-white/60 tracking-wider font-light">{page.data?.branchNotice || ''}</p>
