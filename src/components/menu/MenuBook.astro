                  {/* --- 8. BACK COVER --- */}
                  {page.type === 'back-cover' && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 md:p-10 bg-radial from-[#122e23] via-[#0b1c15] to-[#050e0a] border-l-2 border-white/5 overflow-hidden select-none">
