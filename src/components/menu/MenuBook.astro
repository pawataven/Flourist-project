<!-- Client Script: PageFlip initialization & Controls -->
<script>
  import { PageFlip } from "page-flip";


  document.addEventListener("DOMContentLoaded", () => {
    const bookEl = document.getElementById("flourist-flipbook");
    const container = document.getElementById("book-centering-container");
    const bookWrapper = document.getElementById("flourist-book-wrapper");
    if (!bookEl || !container) return;

    function getActualHeaderHeight(): number {
      const headerEl = document.querySelector(".site-header") as HTMLElement;
      if (headerEl) {
        const rect = headerEl.getBoundingClientRect();
        if (rect.height > 0) return Math.round(rect.height);
      }
      return window.innerWidth < 768 ? 112 : (window.innerWidth >= 1280 ? 64 : 124);
    }

    const actualHeaderHeight = getActualHeaderHeight();
    const spacer = document.getElementById("menu-nav-spacer");
    if (spacer) {
      spacer.style.height = `${actualHeaderHeight}px`;
    }

    // Available height strictly in the visible space below the navbar
    const availableHeight = window.innerHeight - actualHeaderHeight;
    const isMobile = window.innerWidth < 768;
    
    // Scale book height to ~94% of available space below navbar (almost touching top & bottom edges)
    // Leaves exactly equal small ~3% margin top and bottom (~25px each on 1080p)
    let targetHeight = isMobile
      ? Math.min(Math.round(availableHeight * 0.92), 680)
      : Math.min(Math.round(availableHeight * 0.94), 920);

    let targetPageWidth = Math.round(targetHeight / 1.414);
    let targetSpreadWidth = isMobile ? targetPageWidth : targetPageWidth * 2;

    const maxAllowedSpreadWidth = isMobile
      ? Math.round(window.innerWidth * 0.94)
      : Math.round(window.innerWidth * 0.94);

    if (targetSpreadWidth > maxAllowedSpreadWidth) {
      targetSpreadWidth = maxAllowedSpreadWidth;
      targetPageWidth = isMobile ? targetSpreadWidth : Math.round(targetSpreadWidth / 2);
      targetHeight = Math.round(targetPageWidth * 1.414);
    }

    const baseWidth = targetPageWidth;
    const baseHeight = targetHeight;
    const spreadWidth = targetSpreadWidth;
    const spreadHeight = targetHeight;

    // Set container & wrapper CSS variables so it fits the book dimensions down to the pixel
    if (bookWrapper) {
      bookWrapper.style.setProperty("--book-spread-width", `${spreadWidth}px`);
      bookWrapper.style.setProperty("--book-spread-height", `${spreadHeight}px`);
    }
    container.style.setProperty("--book-spread-width", `${spreadWidth}px`);
    container.style.setProperty("--book-spread-height", `${spreadHeight}px`);

    // Initialize PageFlip instance configured for comfortable viewport fit
    const pageFlip = new PageFlip(bookEl, {
      startPage: 0, // เริ่มต้นที่หน้าปก (Front Cover)
      width: baseWidth,
      height: baseHeight,
      size: "stretch",
      minWidth: isMobile ? targetPageWidth : 180,
      maxWidth: 900,
      minHeight: isMobile ? Math.round(targetHeight * 0.8) : 250,
      maxHeight: 1200,
      drawShadow: false,
      maxShadowOpacity: 0,
      showCover: true,
      mobileScrollSupport: false,
      swipeDistance: 25,
      usePortrait: isMobile,
      flippingTime: 700,
      useMouseEvents: true,
      showPageCorners: true,
    });

    const pageElements = document.querySelectorAll(".book-page-wrapper");
    pageFlip.loadFromHTML(pageElements as any);

    // Dom Elements
    const btnPrev = document.getElementById("btn-book-prev") as HTMLButtonElement;
    const btnNext = document.getElementById("btn-book-next") as HTMLButtonElement;
    const btnClose = document.getElementById("btn-book-close") as HTMLButtonElement;
    const btnFirst = document.getElementById("btn-book-first") as HTMLButtonElement;
    const btnLast = document.getElementById("btn-book-last") as HTMLButtonElement;
    const pageLabel = document.getElementById("book-page-label");
    const spreadLabel = document.getElementById("book-spread-label");
    const thumbsBtn = document.getElementById("btn-book-thumbs");
    const thumbsDrawer = document.getElementById("book-thumbs-drawer");
    const closeThumbsBtn = document.getElementById("btn-close-thumbs");
    const zoomBtn = document.getElementById("btn-book-zoom");
    const zoomModal = document.getElementById("book-zoom-modal");
    const closeZoomBtn = document.getElementById("btn-close-zoom");
    const zoomTarget = document.getElementById("zoom-target-content");
    const fullScreenBtn = document.getElementById("btn-book-fullscreen");

    const totalPages = pageFlip.getPageCount();

    // Update UI status on page change
    function updateBookState(pageIndex: number) {
      const orientation = pageFlip.getOrientation();
      const isLandscape = orientation === "landscape";
      const isAtEnd = pageIndex >= totalPages - 1;

      // Desktop shift & clipping effect for closed cover / back cover
      if (isLandscape) {
        if (pageIndex === 0) {
          container.setAttribute("data-state", "cover");
          container.className = "centering-box at-cover";
          if (bookWrapper) bookWrapper.setAttribute("data-book-state", "cover");
        } else if (pageIndex >= totalPages - 1) {
          container.setAttribute("data-state", "back");
          container.className = "centering-box at-back";
          if (bookWrapper) bookWrapper.setAttribute("data-book-state", "back");
        } else {
          container.setAttribute("data-state", "spread");
          container.className = "centering-box at-spread";
          if (bookWrapper) bookWrapper.setAttribute("data-book-state", "spread");
        }
      } else {
        container.removeAttribute("data-state");
        container.className = "centering-box";
        if (bookWrapper) bookWrapper.setAttribute("data-book-state", "portrait");
      }

      // Update Label
      if (pageIndex === 0) {
        if (pageLabel) pageLabel.textContent = "ปกหน้า (Front Cover)";
        if (spreadLabel) spreadLabel.textContent = `คลิกหรือลากมุมเพื่อเปิด • หน้า 1 จาก ${totalPages}`;
        if (btnPrev) btnPrev.disabled = true;
        if (btnFirst) btnFirst.disabled = true;
        if (btnNext) btnNext.disabled = false;
        if (btnLast) btnLast.disabled = false;
        if (btnClose) {
          btnClose.style.opacity = "0";
          btnClose.style.pointerEvents = "none";
          btnClose.style.visibility = "hidden";
        }
      } else if (isAtEnd) {
        if (pageLabel) pageLabel.textContent = "ปกหลัง (Back Cover)";
        if (spreadLabel) spreadLabel.textContent = `หน้า ${totalPages} จาก ${totalPages}`;
        if (btnNext) btnNext.disabled = true;
        if (btnLast) btnLast.disabled = true;
        if (btnPrev) btnPrev.disabled = false;
        if (btnFirst) btnFirst.disabled = false;
        if (btnClose) {
          btnClose.style.opacity = "1";
          btnClose.style.pointerEvents = "auto";
          btnClose.style.visibility = "visible";
        }
      } else {
        if (isLandscape) {
          const leftP = pageIndex;
          const rightP = pageIndex + 1 < totalPages ? pageIndex + 1 : pageIndex;
          if (pageLabel) pageLabel.textContent = `หน้า ${leftP} - ${rightP}`;
          if (spreadLabel) spreadLabel.textContent = `จากทั้งหมด ${totalPages} หน้า`;
        } else {
          if (pageLabel) pageLabel.textContent = `หน้าที่ ${pageIndex}`;
          if (spreadLabel) spreadLabel.textContent = `จาก ${totalPages} หน้า`;
        }
        if (btnPrev) btnPrev.disabled = false;
        if (btnFirst) btnFirst.disabled = false;
        if (btnNext) btnNext.disabled = false;
        if (btnLast) btnLast.disabled = false;
        if (btnClose) {
          btnClose.style.opacity = "1";
          btnClose.style.pointerEvents = "auto";
          btnClose.style.visibility = "visible";
        }
      }

      // Update thumbnail active states
      document.querySelectorAll(".thumb-item").forEach((el) => {
        const target = parseInt(el.getAttribute("data-target-page") || "0", 10);
        if (target === pageIndex || (isLandscape && target === pageIndex + 1 && pageIndex > 0)) {
          el.classList.add("active");
        } else {
          el.classList.remove("active");
        }
      });
    }

    // Event Listeners from PageFlip
    pageFlip.on("init", (e: any) => {
      updateBookState(e.data.page);
    });

    pageFlip.on("flip", (e: any) => {
      updateBookState(e.data);
    });

    pageFlip.on("changeOrientation", () => {
      updateBookState(pageFlip.getCurrentPageIndex());
    });

    // Unclip during page turns so the swinging page crosses the spine seamlessly
    pageFlip.on("changeState", (e: any) => {
      const state = e.data;
      if (state === "flipping" || state === "user_fold") {
        if (pageFlip.getOrientation() === "landscape") {
          container.setAttribute("data-state", "flipping");
          container.className = "centering-box at-flipping";
          if (bookWrapper) bookWrapper.setAttribute("data-book-state", "spread");
        }
      } else if (state === "read") {
        updateBookState(pageFlip.getCurrentPageIndex());
      }
    });

    // Return to Cover / Close Button Action
    btnClose?.addEventListener("click", (e) => {
      e.stopPropagation();
      try {
        pageFlip.flip(0);
      } catch (err) {}
    });

    // Control Buttons
    btnNext?.addEventListener("click", (e) => {
      e.stopPropagation();
      try {
        if (pageFlip.getCurrentPageIndex() < totalPages - 1) {
          pageFlip.flipNext();
        }
      } catch (err) {}
    });

    btnPrev?.addEventListener("click", (e) => {
      e.stopPropagation();
      try {
        if (pageFlip.getCurrentPageIndex() > 0) {
          pageFlip.flipPrev();
        }
      } catch (err) {}
    });

    btnFirst?.addEventListener("click", () => {
      try {
        pageFlip.flip(0);
      } catch (err) {}
    });

    btnLast?.addEventListener("click", () => {
      try {
        pageFlip.flip(totalPages - 1);
      } catch (err) {}
    });

    // Thumbnails Drawer
    thumbsBtn?.addEventListener("click", () => {
      thumbsDrawer?.classList.toggle("hidden");
    });

    closeThumbsBtn?.addEventListener("click", () => {
      thumbsDrawer?.classList.add("hidden");
    });

    document.querySelectorAll(".thumb-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = parseInt(btn.getAttribute("data-target-page") || "0", 10);
        try {
          if (target >= 0 && target < totalPages) {
            pageFlip.flip(target);
          }
        } catch (err) {}
      });
    });

    // Fullscreen Toggle
    fullScreenBtn?.addEventListener("click", () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen().catch(() => {});
        }
      }
    });

    // Zoom Lightbox Modal
    let currentZoomScale = 1;
    zoomBtn?.addEventListener("click", () => {
      if (!zoomModal || !zoomTarget) return;
      const currentIndex = pageFlip.getCurrentPageIndex();
      const currentSpreadPages = document.querySelectorAll(".book-page-wrapper");
      
      zoomTarget.innerHTML = "";
      currentZoomScale = 1;

      // Clone active page for inspection
      const pageToZoom = currentSpreadPages[currentIndex];
      if (pageToZoom) {
        const clone = pageToZoom.cloneNode(true) as HTMLElement;
        clone.style.width = "480px";
        clone.style.maxWidth = "90vw";
        clone.style.height = "680px";
        clone.style.maxHeight = "80vh";
        clone.style.display = "block";
        clone.style.position = "relative";
        clone.style.transform = `scale(${currentZoomScale})`;
        clone.style.transition = "transform 0.2s ease";
        clone.id = "zoomed-clone";
        zoomTarget.appendChild(clone);
      }

      zoomModal.classList.remove("hidden");
    });

    closeZoomBtn?.addEventListener("click", () => {
      zoomModal?.classList.add("hidden");
    });

    document.getElementById("btn-zoom-in")?.addEventListener("click", () => {
      const clone = document.getElementById("zoomed-clone");
      if (clone && currentZoomScale < 2.5) {
        currentZoomScale += 0.25;
        clone.style.transform = `scale(${currentZoomScale})`;
      }
    });

    document.getElementById("btn-zoom-out")?.addEventListener("click", () => {
      const clone = document.getElementById("zoomed-clone");
      if (clone && currentZoomScale > 0.75) {
        currentZoomScale -= 0.25;
        clone.style.transform = `scale(${currentZoomScale})`;
      }
    });

    document.getElementById("btn-zoom-reset")?.addEventListener("click", () => {
      const clone = document.getElementById("zoomed-clone");
      if (clone) {
        currentZoomScale = 1;
        clone.style.transform = `scale(1)`;
      }
    });

    // Keyboard Shortcuts
    window.addEventListener("keydown", (e) => {
      try {
        if (e.key === "ArrowRight" || e.key === "PageDown") {
          if (pageFlip.getCurrentPageIndex() < totalPages - 1) {
            pageFlip.flipNext();
          }
        } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
          if (pageFlip.getCurrentPageIndex() > 0) {
            pageFlip.flipPrev();
          }
        } else if (e.key === "Escape") {
          zoomModal?.classList.add("hidden");
          thumbsDrawer?.classList.add("hidden");
        }
      } catch (err) {}
    });

    function updateDimensions() {
      const actH = getActualHeaderHeight();
      const sp = document.getElementById("menu-nav-spacer");
      if (sp) sp.style.height = `${actH}px`;

      const isMob = window.innerWidth < 768;
      const availH = window.innerHeight - actH;
      let tH = isMob
        ? Math.min(Math.round(availH * 0.92), 680)
        : Math.min(Math.round(availH * 0.94), 920);

      let tPW = Math.round(tH / 1.414);
      let tSW = isMob ? tPW : tPW * 2;

      const maxSW = Math.round(window.innerWidth * 0.94);
      if (tSW > maxSW) {
        tSW = maxSW;
        tPW = isMob ? tSW : Math.round(tSW / 2);
        tH = Math.round(tPW * 1.414);
      }
      if (bookWrapper) {
        bookWrapper.style.setProperty("--book-spread-width", `${tSW}px`);
        bookWrapper.style.setProperty("--book-spread-height", `${tH}px`);
      }
      container.style.setProperty("--book-spread-width", `${tSW}px`);
      container.style.setProperty("--book-spread-height", `${tH}px`);
    }

    const headerElement = document.querySelector(".site-header");
    if (headerElement && typeof ResizeObserver !== "undefined") {
      const ro = new ResizeObserver(() => updateDimensions());
      ro.observe(headerElement);
    }

    let resizeTimer: any;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => updateDimensions(), 100);
    });
  });
</script>
