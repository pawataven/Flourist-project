---
import { menuBookPages } from "../../data/MenuBookData";
import defaultLogo from "../../assets/Logo-5.png";
import defaultWatermark from "../../assets/index/Logo-web.png";
---

<div id="flourist-book-wrapper" data-book-state="cover" class="relative w-full h-full flex flex-col items-center justify-center select-none">
  <!-- Interactive Book Stage Area -->
  <div class="book-stage relative w-full h-full flex items-center justify-center overflow-visible">
    


    <!-- Navigation Buttons Beside the Book -->
    <button
      id="btn-book-prev"
      type="button"
      aria-label="Previous Page"
      title="หน้าก่อนหน้า (Previous)"
      class="book-nav-btn book-nav-prev group"
      disabled
    >
      <svg class="w-6 h-6 sm:w-7 sm:h-7 -translate-x-0.5 transition-transform duration-200 group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <button
      id="btn-book-next"
      type="button"
      aria-label="Next Page"
      title="หน้าถัดไป (Next)"
      class="book-nav-btn book-nav-next group"
    >
      <svg class="w-6 h-6 sm:w-7 sm:h-7 translate-x-0.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <!-- Return to Cover / Close Button (Top-Right of Book) -->
    <button
      id="btn-book-close"
      type="button"
      aria-label="กลับเมนูหน้าแรก (Return to Cover)"
      title="กลับเมนูหน้าแรก (Return to Cover)"
      class="book-close-btn group opacity-0 pointer-events-none invisible"
    >
      <svg class="w-5 h-5 transition-transform duration-300 group-hover:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Book Transform Container (Shifts to center cover on desktop) -->
    <div id="book-centering-container" data-state="cover" class="at-cover centering-box">
      
      <!-- StPageFlip Target Element without leftover shadows -->
      <div id="flourist-flipbook" class="flipbook-root">
        
        {menuBookPages.map((page, index) => (
          <div
            class={`book-page-wrapper ${page.density === 'hard' ? 'page-hard' : 'page-soft'}`}
            data-density={page.density}
            data-page-index={index}
            data-title={page.title}
          >
            <div class="page-content-box w-full h-full relative overflow-hidden bg-black text-white">
              
              {/* IF CUSTOM IMAGE PROVIDED */}
              {page.customImage ? (
                <div class="w-full h-full relative bg-black">
                  <img
                    src={page.customImage}
                    alt={page.title}
                    class="menu-page-img w-full h-full object-cover select-none pointer-events-none"
                    loading={index <= 2 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <!-- Page Number for soft pages -->
                  {page.density !== 'hard' && (
                    <span class={`absolute bottom-3 text-[10px] tracking-widest text-[#c5a259]/75 font-sans ${index % 2 === 1 ? 'left-4' : 'right-4'}`}>
                      {page.pageNumberLabel}
                    </span>
                  )}
                  <!-- Click to open hint pill on Front Cover -->
                  {index === 0 && (
                    <div class="absolute bottom-[13%] left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-[#c5a259]/60 text-[#c5a259] text-[11px] sm:text-xs tracking-wider flex items-center gap-2 pointer-events-none shadow-xl animate-pulse z-20 whitespace-nowrap">
                      <span>คลิกหรือลากเพื่อเปิด &bull; Click to open</span>
                      <span class="text-sm">&rarr;</span>
                    </div>
                  )}

                  {/* Flyleaf / Closing Page Design (Page 8) */}
                  {page.data?.isEnding && (
                    <div class="absolute inset-0 flex flex-col items-center justify-between p-8 sm:p-10 text-center select-none pointer-events-none z-10 bg-black">
                      <div class="pt-4 sm:pt-6">
                        <p class="font-sans text-[10px] sm:text-[11px] tracking-[0.35em] text-[#c5a259] uppercase font-semibold">
                          {page.data.brandName}
                        </p>
                        <p class="font-serif text-xs tracking-[0.25em] text-[#c5a259]/80 mt-0.5">
                          {page.data.subBrand}
                        </p>
                      </div>

                      <div class="flex flex-col items-center my-auto px-4 max-w-xs">
                        <p class="font-serif text-2xl sm:text-3xl tracking-[0.3em] text-[#c5a259] font-light mb-2">
                          {page.data.kanji}
                        </p>
                        <p class="font-serif text-xs tracking-wider text-[#c5a259]/80 italic mb-3 leading-relaxed">
                          {page.data.kanjiMeaning}
                        </p>
                        <div class="w-14 h-px bg-gradient-to-r from-transparent via-[#c5a259]/50 to-transparent my-1"></div>
                        <p class="font-sans text-xs tracking-wide text-white/85 mt-2 leading-relaxed">
                          {page.data.message}
                        </p>
                      </div>

                      <div class="pb-4 sm:pb-6">
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-[#c5a259]/60 text-[#c5a259] text-[11px] sm:text-xs tracking-wider shadow-xl animate-pulse whitespace-nowrap">
                          <span>คลิกเพื่อปิดสมุด &bull; Close</span>
                          <span class="text-sm">&rarr;</span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* Click to open hint pill on Back Cover (Page 9) */}
                  {index === menuBookPages.length - 1 && (
                    <div class="absolute bottom-[13%] left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-[#c5a259]/60 text-[#c5a259] text-[11px] sm:text-xs tracking-wider flex items-center gap-2 pointer-events-none shadow-xl animate-pulse z-20 whitespace-nowrap">
                      <span class="text-sm">&larr;</span>
                      <span>คลิกเพื่อเปิดสมุด &bull; Click to open</span>
                    </div>
                  )}
                </div>
              ) : (
                /* TEMPLATE HIGH-FIDELITY DESIGN */
                <>
                  {/* --- 1. COVER PAGE (INDEX 0) --- */}
                  {page.type === 'cover' && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 md:p-10 bg-radial from-[#122e23] via-[#0b1c15] to-[#050e0a] border-r-2 border-white/5 overflow-hidden select-none">
                      <!-- Leather Texture Overlay -->
                      <div class="absolute inset-0 opacity-25 bg-[radial-gradient(#c5a259_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
                      
                      <!-- Big Watermark Motif on the left -->
                      <div class="absolute -left-16 sm:-left-20 top-1/2 -translate-y-1/2 w-72 sm:w-80 h-72 sm:h-80 opacity-15 pointer-events-none">
                        <img src={page.data?.watermark?.src || defaultWatermark.src} alt="Watermark" class="w-full h-full object-contain pointer-events-none" />
                      </div>



                      <!-- Top Header: MENU -->
                      <div class="text-center pt-3 sm:pt-4 relative z-10">
                        <h2 class="font-display text-4xl sm:text-5xl md:text-6xl tracking-[0.25em] text-[#c5a259] drop-shadow-[0_2px_14px_rgba(197,162,89,0.35)]">
                          MENU
                        </h2>
                      </div>

                      <!-- Center Brand Emblem & Gold Typography -->
                      <div class="my-auto flex flex-col items-center justify-center text-center relative z-10 py-3 sm:py-5">
                        <!-- Floral Emblem -->
                        <div class="w-18 h-18 sm:w-20 sm:h-20 md:w-24 md:h-24 mb-3 sm:mb-4 drop-shadow-[0_4px_16px_rgba(197,162,89,0.4)]">
                          <img src={page.data?.logo?.src || defaultLogo.src} alt="Flourist Logo" class="w-full h-full object-contain pointer-events-none" />
                        </div>

                        <!-- Brand Title -->
                        <h1 class="font-sans text-xl sm:text-2xl md:text-3xl tracking-[0.35em] uppercase text-[#c5a259] font-medium">
                          {page.data?.brandName || "FLOURIST"}
                        </h1>
                        <p class="font-serif text-xs sm:text-sm tracking-[0.25em] text-[#c5a259]/90 mt-1">
                          {page.data?.subBrand || "抹茶ハウス"}
                        </p>

                        <!-- Est & Year -->
                        <div class="mt-4 sm:mt-5 flex flex-col items-center">
                          <span class="font-serif text-[11px] sm:text-xs tracking-[0.3em] uppercase text-[#c5a259]/80">
                            {page.data?.est || "EST. 2020"}
                          </span>
                          <div class="w-px h-6 bg-gradient-to-b from-[#c5a259]/80 to-[#c5a259]/20 my-1"></div>
                          <span class="font-sans text-[11px] sm:text-xs tracking-[0.3em] uppercase text-[#c5a259]/80">
                            {page.data?.location || "BANGKOK"}
                          </span>
                        </div>
                      </div>

                      <!-- Bottom Tagline & Click to Open Pill -->
                      <div class="text-center pb-2 relative z-10 flex flex-col items-center gap-3">
                        <p class="font-serif text-[11px] sm:text-xs tracking-[0.2em] text-[#c5a259]/75 italic">
                          {page.data?.tagline || "The Art of Ceremonial Matcha."}
                        </p>
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-[#c5a259]/60 text-[#c5a259] text-[11px] sm:text-xs tracking-wider shadow-lg animate-pulse pointer-events-none">
                          <span>คลิกหรือลากเพื่อเปิด &bull; Click to open</span>
                          <span class="text-sm">&rarr;</span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* --- 2. BRAND STORY PAGE (INDEX 1 - LEFT SPREAD) --- */}
                  {page.type === 'story' && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 bg-[#0b120e] text-white border-l border-white/5">


                      <!-- Header with Logo -->
                      <div class="flex items-center gap-3 border-b border-[#c5a259]/20 pb-3">
                        <div class="w-6 h-6">
                          <img src={page.data.logo?.src || "/src/assets/Logo-5.png"} alt="Flourist" class="w-full h-full object-contain" />
                        </div>
                        <div>
                          <p class="font-sans text-[10px] tracking-[0.25em] text-[#c5a259] uppercase font-semibold">
                            FLOURIST 抹茶ハウス
                          </p>
                          <h3 class="font-serif text-xs sm:text-sm tracking-wide text-white/90">
                            {page.data.headline}
                          </h3>
                        </div>
                      </div>

                      <!-- Tea Farmers Image -->
                      <div class="my-3 relative rounded-lg overflow-hidden border border-[#c5a259]/30 shadow-lg group">
                        <img
                          src={page.data.teamImage?.src}
                          alt="Tea plantation farmers"
                          class="w-full h-28 sm:h-36 object-cover"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                      </div>

                      <!-- Thai Brand Story Text -->
                      <div class="my-auto">
                        <p class="font-sans text-[10.5px] sm:text-[11.5px] md:text-xs text-white/80 leading-relaxed font-light text-justify indent-4">
                          {page.data.storyText}
                        </p>
                      </div>

                      <!-- Bottom Photo & Contact Footer -->
                      <div class="mt-3 pt-3 border-t border-[#c5a259]/20">
                        <div class="flex items-center gap-3">
                          <div class="w-20 h-14 sm:w-24 sm:h-16 rounded overflow-hidden border border-[#c5a259]/30 shrink-0">
                            <img src={page.data.whiskImage?.src} alt="Matcha bowl & whisk" class="w-full h-full object-cover" />
                          </div>
                          <div class="text-[9px] sm:text-[10px] text-white/60 font-sans space-y-0.5">
                            <p class="text-[#c5a259] font-medium tracking-wide">CONNECT WITH US</p>
                            <p>IG: <span class="text-white/80">{page.data.contacts.ig}</span></p>
                            <p>Line: <span class="text-white/80">{page.data.contacts.line}</span></p>
                            <p>Tel: <span class="text-white/80">{page.data.contacts.phone}</span></p>
                          </div>
                        </div>

                        <!-- Left Page Number -->
                        <div class="mt-3 flex justify-between items-center text-[9px] text-[#c5a259]/60 font-sans">
                          <span>1</span>
                          <span class="tracking-widest uppercase">Flourist Origins</span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* --- 3. MOTORO SIGNATURE PAGE (INDEX 2 - RIGHT SPREAD) --- */}
                  {page.type === 'product-spotlight' && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 bg-radial from-[#151f19] via-[#0d1612] to-[#070c09] text-white border-r border-white/5">


                      <!-- Product Header -->
                      <div class="text-center pt-2 relative z-10">
                        <div class="inline-block px-2.5 py-0.5 rounded-full border border-[#c5a259]/40 bg-[#c5a259]/10 text-[#c5a259] text-[9px] tracking-[0.2em] uppercase font-medium mb-1">
                          {page.data.badge}
                        </div>
                        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl tracking-[0.1em] text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.7)]">
                          {page.data.title}
                        </h2>
                        <p class="font-serif text-[11px] sm:text-xs text-white/75 mt-1 italic tracking-wide">
                          {page.data.description}
                        </p>
                        
                        <!-- Price Badge -->
                        <div class="mt-2 inline-flex items-center gap-1.5 px-4 py-1 rounded border border-[#c5a259] bg-[#0c1913]/90 shadow-[0_0_15px_rgba(197,162,89,0.2)]">
                          <span class="font-sans text-[10px] tracking-widest text-[#c5a259] uppercase font-light">PRICE</span>
                          <span class="font-serif text-lg sm:text-xl font-bold text-[#c5a259]">{page.data.price}</span>
                          <span class="font-sans text-[10px] text-[#c5a259]/80">THB</span>
                        </div>
                      </div>

                      <!-- Product Center Visual -->
                      <div class="my-auto relative flex items-center justify-center py-2">
                        <!-- Soft Backlight Circle -->
                        <div class="absolute w-44 h-44 sm:w-56 sm:h-56 rounded-full bg-[#c5a259]/15 blur-2xl pointer-events-none"></div>
                        <div class="relative w-44 h-44 sm:w-52 sm:h-52 md:w-56 md:h-56 rounded-2xl overflow-hidden border border-[#c5a259]/30 shadow-2xl">
                          <img
                            src={page.data.image?.src}
                            alt={page.data.title}
                            class="w-full h-full object-cover"
                          />
                        </div>
                      </div>

                      <!-- Thai Description & Footer -->
                      <div class="text-center relative z-10 pt-2 border-t border-[#c5a259]/20">
                        <p class="font-sans text-[10.5px] sm:text-xs text-white/75 font-light leading-relaxed max-w-xs mx-auto">
                          {page.data.thaiNote}
                        </p>

                        <!-- Brand Mini Logo Footer -->
                        <div class="mt-3 flex items-center justify-between text-[9px] text-[#c5a259]/60 font-sans">
                          <div class="flex items-center gap-1.5">
                            <div class="w-3.5 h-3.5">
                              <img src={page.data.logo?.src || "/src/assets/Logo-5.png"} alt="Flourist" class="w-full h-full object-contain" />
                            </div>
                            <span class="tracking-widest uppercase">FLOURIST 抹茶ハウス</span>
                          </div>
                          <span>2</span>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* --- 4. SIGNATURE CATALOG (INDEX 3) --- */}
                  {page.type === 'catalog' && page.pageIndex === 3 && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 bg-[#0b120e] text-white border-l border-white/5">

                      
                      <!-- Header -->
                      <div class="border-b border-[#c5a259]/20 pb-2 mb-3 text-center">
                        <p class="font-sans text-[10px] tracking-[0.3em] uppercase text-[#c5a259]">{page.data.category}</p>
                        <h3 class="font-display text-xl sm:text-2xl tracking-wider text-white">Signature Crafted Drinks</h3>
                      </div>

                      <!-- 3 Drinks list -->
                      <div class="space-y-3.5 my-auto">
                        {page.data.items?.map((item: any) => (
                          <div class="flex items-center gap-3 p-2 rounded-lg bg-[#111c16]/80 border border-[#c5a259]/20 shadow-sm">
                            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded overflow-hidden border border-[#c5a259]/30 shrink-0">
                              <img src={item.image?.src} alt={item.name} class="w-full h-full object-cover" />
                            </div>
                            <div class="flex-1 min-w-0">
                              <div class="flex items-baseline justify-between gap-2">
                                <h4 class="font-sans text-xs sm:text-sm font-semibold tracking-wider text-white truncate">{item.name}</h4>
                                <span class="font-serif text-xs sm:text-sm font-bold text-[#c5a259] shrink-0">{item.price} ฿</span>
                              </div>
                              <p class="font-sans text-[10px] sm:text-[10.5px] text-white/70 line-clamp-2 mt-0.5 leading-snug">{item.desc}</p>
                            </div>
                          </div>
                        ))}
                      </div>

                      <!-- Footer -->
                      <div class="pt-2 border-t border-[#c5a259]/20 flex justify-between items-center text-[9px] text-[#c5a259]/60 font-sans">
                        <span>3</span>
                        <span class="tracking-widest uppercase">House Signatures</span>
                      </div>
                    </div>
                  )}

                  {/* --- 5. REFRESH & CEREMONIAL (INDEX 4) --- */}
                  {page.type === 'catalog' && page.pageIndex === 4 && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 bg-[#0d1612] text-white border-r border-white/5">

                      
                      <!-- Header -->
                      <div class="border-b border-[#c5a259]/20 pb-2 mb-3 text-center">
                        <p class="font-sans text-[10px] tracking-[0.3em] uppercase text-[#c5a259]">{page.data.category}</p>
                        <h3 class="font-display text-xl sm:text-2xl tracking-wider text-white">Cold Whisk & Modern Flavors</h3>
                      </div>

                      <!-- 3 Drinks list -->
                      <div class="space-y-3.5 my-auto">
                        {page.data.items?.map((item: any) => (
                          <div class="flex items-center gap-3 p-2 rounded-lg bg-[#111c16]/80 border border-[#c5a259]/20 shadow-sm">
                            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded overflow-hidden border border-[#c5a259]/30 shrink-0">
                              <img src={item.image?.src} alt={item.name} class="w-full h-full object-cover" />
                            </div>
                            <div class="flex-1 min-w-0">
                              <div class="flex items-baseline justify-between gap-2">
                                <h4 class="font-sans text-xs sm:text-sm font-semibold tracking-wider text-white truncate">{item.name}</h4>
                                <span class="font-serif text-xs sm:text-sm font-bold text-[#c5a259] shrink-0">{item.price} ฿</span>
                              </div>
                              <p class="font-sans text-[10px] sm:text-[10.5px] text-white/70 line-clamp-2 mt-0.5 leading-snug">{item.desc}</p>
                            </div>
                          </div>
                        ))}
                      </div>

                      <!-- Footer -->
                      <div class="pt-2 border-t border-[#c5a259]/20 flex justify-between items-center text-[9px] text-[#c5a259]/60 font-sans">
                        <span class="tracking-widest uppercase">Ceremonial Selection</span>
                        <span>4</span>
                      </div>
                    </div>
                  )}

                  {/* --- 6. DESSERTS & DAIFUKU (INDEX 5) --- */}
                  {page.type === 'dessert' && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 bg-[#0b120e] text-white border-l border-white/5">

                      
                      <!-- Header -->
                      <div class="border-b border-[#c5a259]/20 pb-2 mb-2 text-center">
                        <p class="font-sans text-[10px] tracking-[0.3em] uppercase text-[#c5a259]">{page.data.category}</p>
                        <h3 class="font-display text-xl sm:text-2xl tracking-wider text-white">Artisanal Daifuku & Sweets</h3>
                      </div>

                      <!-- Hero Daifuku Visual -->
                      <div class="relative rounded-lg overflow-hidden border border-[#c5a259]/30 h-28 sm:h-32 mb-2">
                        <img src={page.data.heroImage?.src} alt="Fresh strawberry daifuku" class="w-full h-full object-cover" />
                      </div>

                      <!-- Dessert Items list -->
                      <div class="space-y-1.5 my-auto">
                        {page.data.items?.map((item: any) => (
                          <div class="flex items-start justify-between border-b border-white/5 pb-1">
                            <div>
                              <p class="font-sans text-xs font-medium text-white tracking-wide">{item.name}</p>
                              <p class="font-sans text-[9.5px] text-white/60">{item.thaiName} &bull; {item.desc}</p>
                            </div>
                            <span class="font-serif text-xs font-bold text-[#c5a259] shrink-0 ml-2">{item.price} ฿</span>
                          </div>
                        ))}
                      </div>

                      <!-- Footer -->
                      <div class="pt-2 border-t border-[#c5a259]/20 flex justify-between items-center text-[9px] text-[#c5a259]/60 font-sans">
                        <span>5</span>
                        <span class="tracking-widest uppercase">Handcrafted Sweets</span>
                      </div>
                    </div>
                  )}

                  {/* --- 7. CULTIVARS & SINGLE ORIGIN (INDEX 6) --- */}
                  {page.type === 'catalog' && page.pageIndex === 6 && (
                    <div class="w-full h-full relative flex flex-col justify-between p-6 sm:p-8 bg-[#0d1612] text-white border-r border-white/5">

                      
                      <!-- Header -->
                      <div class="border-b border-[#c5a259]/20 pb-2 mb-2 text-center">
                        <p class="font-sans text-[10px] tracking-[0.3em] uppercase text-[#c5a259]">{page.data.category}</p>
                        <h3 class="font-display text-xl sm:text-2xl tracking-wider text-white">Single Cultivars & Origin</h3>
                      </div>

                      <!-- Table Header -->
                      <div class="flex items-center text-[9px] text-[#c5a259] uppercase tracking-wider font-semibold px-1 pb-1 border-b border-[#c5a259]/20">
                        <span class="w-1/2">Cultivar / Terroir</span>
                        <span class="w-1/4 text-right">Latte</span>
                        <span class="w-1/4 text-right">Clear</span>
                      </div>

                      <!-- Cultivars List -->
                      <div class="space-y-2 my-auto">
                        {page.data.cultivars?.map((c: any) => (
                          <div class="flex items-center justify-between text-xs px-1 border-b border-white/5 pb-1.5">
                            <div class="w-1/2 pr-2">
                              <span class="font-display text-sm text-[#c5a259] font-bold block">{c.code}</span>
                              <span class="text-[9px] text-white/50 block font-serif">{c.region}</span>
                              <span class="text-[9px] text-white/70 block leading-tight">{c.notes}</span>
                            </div>
