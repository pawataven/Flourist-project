---
import { Image } from "astro:assets";
import { specialSelections } from "../data/SpecailSelectiondata";
import logoWeb from "../assets/index/Logo-web.png";

const slideCount = specialSelections.length;
const visibleDotCount = Math.min(slideCount, 5);
---
<script>
  const root = document.querySelector<HTMLElement>("[data-special-selection]");
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-special-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-special-dot]"));
    const previous = root.querySelector<HTMLButtonElement>("[data-special-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-special-next]");
    let activeIndex = 0;
    let timer: number | undefined;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("opacity-100", isActive);
        slide.classList.toggle("opacity-0", !isActive);
        slide.classList.toggle("pointer-events-auto", isActive);
        slide.classList.toggle("pointer-events-none", !isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex % dots.length;
        dot.classList.toggle("bg-[#C5A259]", isActive);
        dot.classList.toggle("bg-[#FFFFFF]/35", !isActive);
        dot.setAttribute("aria-current", String(isActive));
      });
    };

    const restartTimer = () => {
      window.clearInterval(timer);
      if (slides.length > 1) timer = window.setInterval(() => showSlide(activeIndex + 1),10000);
    };

    previous?.addEventListener("click", () => { showSlide(activeIndex - 1); restartTimer(); });
    next?.addEventListener("click", () => { showSlide(activeIndex + 1); restartTimer(); });
    dots.forEach((dot, index) => dot.addEventListener("click", () => { showSlide(index); restartTimer(); }));
    restartTimer();
  }
</script>
<section
  id="special-selection"
  aria-labelledby="special-selection-title"
  class="relative overflow-hidden border-y border-[#C5A259] bg-[#12221B] text-[#FFFFFF]"
  data-special-selection
>
  <!-- Decorative Left Logo peeking from edge -->
  <div
    class="pointer-events-none absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none z-0 hidden md:block opacity-65 lg:opacity-80"
    aria-hidden="true"
  >
    <Image
      src={logoWeb}
      alt=""
      width={720}
      height={900}
      class="h-auto w-[460px] md:w-[580px] lg:w-[680px] xl:w-[780px] max-w-none object-contain"
      loading="lazy"
    />
  </div>

  <!-- Decorative Right Logo peeking from edge -->
  <div
    class="pointer-events-none absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2 select-none z-0 hidden md:block opacity-65 lg:opacity-80"
    aria-hidden="true"
  >
    <Image
      src={logoWeb}
      alt=""
      width={720}
      height={900}
      class="h-auto w-[460px] md:w-[580px] lg:w-[680px] xl:w-[780px] max-w-none object-contain"
      loading="lazy"
    />
  </div>

  <div class="page-container relative z-10 mx-auto max-w-5xl py-10 sm:py-12 lg:py-16">
    <div class="relative">
      <div class="relative grid overflow-hidden rounded-sm border border-[#C5A259]/70 bg-[#0e1b15] shadow-2xl">
        {
          specialSelections.map((selection, index) => (
            <div
              data-special-slide
              data-slide-index={index}
              class:list={[
                "col-start-1 row-start-1 grid min-w-0 grid-rows-[auto_1fr] items-stretch opacity-0 pointer-events-none transition-opacity duration-700 ease-in-out md:grid-cols-12 md:grid-rows-1",
                index === 0 && "opacity-100 pointer-events-auto"
              ]}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div class="relative flex min-w-0 items-center aspect-[2480/3508] md:col-span-5 md:aspect-auto md:border-r md:border-[#C5A259]/60">
                <Image
                  src={selection.image}
                  alt={selection.imageAlt}
                  format="webp"
                  quality={85}
                  width={720}
                  widths={[360, 540, 720, 900]}
                  sizes="(min-width: 1280px) 440px, (min-width: 768px) 42vw, calc(100vw - 48px)"
                  loading={index === 0 ? "eager" : "lazy"}
                  class="block size-full object-cover object-center"
                />
              </div>

              <div class="min-w-0 flex flex-col justify-start border-t border-[#C5A259]/60 p-7 sm:p-9 md:col-span-7 md:justify-center md:border-t-0 md:p-10 lg:p-12 xl:p-14">
                <p class="font-sans text-[11px] tracking-[0.28em] text-[#C5A259] uppercase sm:text-xs">
                  {selection.eyebrow}
                </p>
                <h2
                  id={index === 0 ? "special-selection-title" : `special-selection-title-${index}`}
                  class="mt-4 sm:mt-5 max-w-full font-display text-xl sm:text-2xl md:text-[1.65rem] lg:text-[1.85rem] xl:text-[2rem] uppercase leading-tight tracking-normal text-[#FFFFFF] whitespace-normal wrap-break-word"
                >
                  {selection.title.filter(Boolean).join(" ")}
                </h2>
                <div class="mt-5 sm:mt-6 h-px w-12 sm:w-14 bg-[#C5A259]"></div>
                <p class="mt-5 sm:mt-6 max-w-md font-sans text-sm sm:text-base leading-relaxed text-[#FFFFFF]/90">
                  {selection.description}
                </p>
                <div class="mt-7 sm:mt-8 flex flex-wrap items-baseline gap-x-5 gap-y-2 border-t border-[#C5A259]/60 pt-5 sm:pt-6">
                  <span class="font-sans text-2xl sm:text-3xl font-light text-[#FFFFFF]">{selection.price}</span>
                  <span class="font-sans text-xs sm:text-sm text-[#FFFFFF]/80">{selection.availability}</span>
                </div>
                <div class="mt-7 sm:mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                  <a
                    href={selection.branchHref}
                    class="inline-flex min-h-10 w-fit items-center gap-2.5 border-b border-[#C5A259] py-1.5 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]"
                  >
                    Find a branch <span aria-hidden="true">↗</span>
                  </a>
                  <button
                    type="button"
                    aria-controls="delivery-options"
                    aria-expanded="false"
                    aria-haspopup="dialog"
                    class="delivery-trigger inline-flex min-h-10 w-fit cursor-pointer items-center gap-2.5 border-b border-[#C5A259] bg-transparent py-1.5 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]"
                  >
                    Order delivery <span aria-hidden="true">↗</span>
                  </button>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {
        slideCount > 1 && (
          <>
            <button
              type="button"
              data-special-prev
              aria-label="Previous special selection"
              class="absolute -left-3 sm:-left-4 md:-left-5 lg:-left-6 top-1/2 z-10 inline-flex size-9 sm:size-10 -translate-y-1/2 items-center justify-center rounded-full border border-[#C5A259] bg-[#12221B] text-2xl text-[#FFFFFF] shadow-md transition hover:bg-[#C5A259] hover:text-[#12221B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]"
            >
              &lsaquo;
            </button>
            <button
              type="button"
              data-special-next
              aria-label="Next special selection"
              class="absolute -right-3 sm:-right-4 md:-right-5 lg:-right-6 top-1/2 z-10 inline-flex size-9 sm:size-10 -translate-y-1/2 items-center justify-center rounded-full border border-[#C5A259] bg-[#12221B] text-2xl text-[#FFFFFF] shadow-md transition hover:bg-[#C5A259] hover:text-[#12221B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]"
            >
              &rsaquo;
            </button>
          </>
        )
      }
    </div>

    {
      slideCount > 1 && (
        <div class="mt-5 sm:mt-6 flex justify-center gap-2" aria-label="Choose special selection">
          {
            specialSelections.map((selection, index) => (
              <button
                type="button"
                data-special-dot={index}
                aria-label={`Go to ${selection.title.join(" ")}`}
                aria-current={index === 0 ? "true" : "false"}
                class:list={["h-1.5 w-7 sm:w-8 bg-[#FFFFFF]/35 transition-colors cursor-pointer", index === 0 && "bg-[#C5A259]"]}
              />
            ))
          }
        </div>
      )
    }
  </div>
</section>


