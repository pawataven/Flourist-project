---
import { Image } from "astro:assets";
import { specialSelections } from "../data/SpecailSelectiondata";

const slideCount = specialSelections.length;
const visibleDotCount = Math.min(slideCount, 5);
---
<script>
  const root = document.querySelector<HTMLElement>("[data-special-selection]");
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-special-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-special-dot]"));
    const previous = root.querySelector<HTMLButtonElement>("[data-special-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-special-next]");
    let activeIndex = 0;
    let timer: number | undefined;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("opacity-100", isActive);
        slide.classList.toggle("opacity-0", !isActive);
        slide.classList.toggle("pointer-events-auto", isActive);
        slide.classList.toggle("pointer-events-none", !isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
      });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex % dots.length;
        dot.classList.toggle("bg-[#C5A259]", isActive);
        dot.classList.toggle("bg-[#FFFFFF]/35", !isActive);
        dot.setAttribute("aria-current", String(isActive));
      });
    };

    const restartTimer = () => {
      window.clearInterval(timer);
      if (slides.length > 1) timer = window.setInterval(() => showSlide(activeIndex + 1),10000);
    };

    previous?.addEventListener("click", () => { showSlide(activeIndex - 1); restartTimer(); });
    next?.addEventListener("click", () => { showSlide(activeIndex + 1); restartTimer(); });
    dots.forEach((dot, index) => dot.addEventListener("click", () => { showSlide(index); restartTimer(); }));
    restartTimer();
  }
</script>
<section
  id="special-selection"
  aria-labelledby="special-selection-title"
  class="border-y border-[#C5A259] bg-[#12221B] text-[#FFFFFF]"
  data-special-selection
>
  <div class="page-container mx-auto max-w-7xl py-12 sm:py-16 lg:py-20">
    <div class="relative grid">
      {
        specialSelections.map((selection, index) => (
          <div
            data-special-slide
            data-slide-index={index}
            class:list={["col-start-1 row-start-1 grid min-w-0 items-stretch gap-6 opacity-0 pointer-events-none transition-opacity duration-700 ease-in-out lg:grid-cols-12 lg:gap-0", index === 0 && "opacity-100 pointer-events-auto"]}
            aria-hidden={index === 0 ? "false" : "true"}
          >
            <div class="min-w-0 bg-[#080A09] p-2 sm:p-3 lg:col-span-7 lg:p-4">
              <Image
                src={selection.image}
                alt={selection.imageAlt}
                format="webp"
                quality={82}
                width={900}
                widths={[360, 540, 720, 900, 1200]}
                sizes="(min-width: 1280px) 700px, (min-width: 1024px) 58vw, calc(100vw - 40px)"
                loading={index === 0 ? "eager" : "lazy"}
                class="block h-auto w-full"
              />
            </div>

            <div class="min-w-0 flex flex-col justify-center border border-[#C5A259] p-6 sm:p-8 md:p-10 lg:col-span-5 lg:border-l-0 lg:p-10 xl:p-14">
              <p class="font-sans text-[10px] tracking-[0.28em] text-[#C5A259] uppercase sm:text-xs">
                {selection.eyebrow}
              </p>
              <h2
                id={index === 0 ? "special-selection-title" : `special-selection-title-${index}`}
                class="mt-6 max-w-full break-words font-display text-[clamp(2.25rem,9vw,3.5rem)] uppercase leading-[0.95] tracking-normal text-[#FFFFFF] sm:mt-7 sm:text-[clamp(2.75rem,6vw,4rem)] lg:text-[clamp(2.75rem,3.5vw,4rem)]"
              >
                <span class="block">{selection.title[0]}</span>
                <span class="mt-3 block sm:mt-4">{selection.title[1]}</span>
              </h2>
              <div class="mt-9 h-px w-14 bg-[#C5A259]"></div>
              <p class="mt-7 max-w-sm font-sans text-sm leading-7 text-[#FFFFFF] sm:text-base sm:leading-8">
                {selection.description}
              </p>
              <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-[#C5A259] pt-5">
                <span class="font-sans text-2xl font-light text-[#FFFFFF]">{selection.price}</span>
                <span class="font-sans text-xs text-[#FFFFFF] sm:text-sm">{selection.availability}</span>
              </div>
              <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
                <a href={selection.branchHref} class="inline-flex min-h-11 w-fit items-center gap-3 border-b border-[#C5A259] py-2 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">
                  Find a branch <span aria-hidden="true">↗</span>
                </a>
                <button type="button" aria-controls="delivery-options" aria-expanded="false" aria-haspopup="dialog" class="delivery-trigger inline-flex min-h-11 w-fit cursor-pointer items-center gap-3 border-b border-[#C5A259] bg-transparent py-2 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">
                  Order delivery <span aria-hidden="true">↗</span>
                </button>
              </div>
            </div>
          </div>
        ))
      }

      {
        slideCount > 1 && (
          <>
            <button type="button" data-special-prev aria-label="Previous special selection" class="absolute left-2 top-1/2 z-10 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-[#C5A259] bg-[#12221B]/80 text-2xl text-[#FFFFFF] transition hover:bg-[#C5A259] hover:text-[#12221B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">&lsaquo;</button>
            <button type="button" data-special-next aria-label="Next special selection" class="absolute right-2 top-1/2 z-10 inline-flex size-10 -translate-y-1/2 items-center justify-center rounded-full border border-[#C5A259] bg-[#12221B]/80 text-2xl text-[#FFFFFF] transition hover:bg-[#C5A259] hover:text-[#12221B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">&rsaquo;</button>
          </>
        )
      }
    </div>

    {
      slideCount > 1 && (
        <div class="mt-6 flex justify-center gap-2" aria-label="Choose special selection">
          {
            specialSelections.map((selection, index) => (
              <button
                type="button"
                data-special-dot={index}
                aria-label={`Go to ${selection.title.join(" ")}`}
                aria-current={index === 0 ? "true" : "false"}
                class:list={["h-1.5 w-8 bg-[#FFFFFF]/35 transition-colors", index === 0 && "bg-[#C5A259]" ]}
              />
            ))
          }
        </div>
      )
    }
  </div>
</section>


