---
import { Image } from "astro:assets";
import { specialSelections } from "../data/SpecailSelectiondata";
import logoWeb from "../assets/index/Logo-web.png";

const slideCount = specialSelections.length;
---

<script>
  const root = document.querySelector<HTMLElement>("[data-special-selection]");
  if (root) {
    const slides = Array.from(
      root.querySelectorAll<HTMLElement>("[data-special-slide]"),
    );
    const dots = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-special-dot]"),
    );
    const previous = root.querySelector<HTMLButtonElement>(
      "[data-special-prev]",
    );
    const next = root.querySelector<HTMLButtonElement>("[data-special-next]");
    let activeIndex = 0;
    let timer: number | undefined;

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.classList.toggle("opacity-100", isActive);
        slide.classList.toggle("opacity-0", !isActive);
        slide.classList.toggle("pointer-events-auto", isActive);
        slide.classList.toggle("pointer-events-none", !isActive);
        slide.setAttribute("aria-hidden", String(!isActive));
        if (isActive) {
          slide.removeAttribute("inert");
          slide.querySelectorAll<HTMLElement>("a, button, input").forEach((el) => {
            el.removeAttribute("tabindex");
          });
        } else {
          slide.setAttribute("inert", "");
          slide.querySelectorAll<HTMLElement>("a, button, input").forEach((el) => {
            el.setAttribute("tabindex", "-1");
          });
        }
      });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex % dots.length;
        dot.classList.toggle("bg-[#C5A259]", isActive);
        dot.classList.toggle("bg-[#FFFFFF]/35", !isActive);
        dot.setAttribute("aria-current", String(isActive));
      });
    };

    const restartTimer = () => {
      window.clearInterval(timer);
      if (slides.length > 1)
        timer = window.setInterval(() => showSlide(activeIndex + 1), 8000);
    };

    previous?.addEventListener("click", () => {
      showSlide(activeIndex - 1);
      restartTimer();
    });
    next?.addEventListener("click", () => {
      showSlide(activeIndex + 1);
      restartTimer();
    });
    dots.forEach((dot, index) =>
      dot.addEventListener("click", () => {
        showSlide(index);
        restartTimer();
      }),
    );
    restartTimer();
  }
</script>
<section
  id="special-selection"
  aria-labelledby="special-selection-title"
  class="relative overflow-hidden border-y border-[#C5A259] bg-[#12221B] text-[#FFFFFF]"
  data-special-selection
>
  <!-- Decorative Left Logo peeking from edge -->
  <div
    class="pointer-events-none absolute left-0 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none z-0 hidden md:block opacity-65 lg:opacity-80"
    aria-hidden="true"
  >
    <Image
      src={logoWeb}
      alt=""
      width={720}
      height={900}
      class="h-auto w-[460px] md:w-[580px] lg:w-[680px] xl:w-[780px] max-w-none object-contain"
      loading="lazy"
    />
  </div>

  <!-- Decorative Right Logo peeking from edge -->
  <div
    class="pointer-events-none absolute right-0 top-1/2 translate-x-1/2 -translate-y-1/2 select-none z-0 hidden md:block opacity-65 lg:opacity-80"
    aria-hidden="true"
  >
    <Image
      src={logoWeb}
      alt=""
      width={720}
      height={900}
      class="h-auto w-[460px] md:w-[580px] lg:w-[680px] xl:w-[780px] max-w-none object-contain"
      loading="lazy"
    />
  </div>

  <div
    class="special-selection-container relative z-10 mx-auto w-full px-4 sm:px-8 md:px-14 lg:px-[262px] py-10 sm:py-16 lg:py-[125px]"
  >
    <div class="relative">
      <div
        class="relative grid grid-cols-1 grid-rows-1 items-start overflow-hidden rounded-sm border border-[#C5A259]/70 bg-[#0e1b15] shadow-2xl md:items-stretch"
      >
        {
          specialSelections.map((selection, index) => (
            <div
              data-special-slide
              data-slide-index={index}
              class:list={[
                "col-start-1 row-start-1 grid min-w-0 content-start grid-rows-[auto_auto] items-start transition-opacity duration-700 ease-in-out md:grid-cols-12 md:grid-rows-1 md:items-stretch md:content-stretch",
                index === 0
                  ? "opacity-100 pointer-events-auto"
                  : "opacity-0 pointer-events-none",
              ]}
              aria-hidden={index === 0 ? "false" : "true"}
              inert={index === 0 ? undefined : true}
            >
              <div class="relative flex min-w-0 items-center aspect-[2480/3508] md:col-span-5 md:aspect-auto md:border-r md:border-[#C5A259]/60">
                <Image
                  src={selection.image}
                  alt={selection.imageAlt}
                  format="webp"
                  quality={85}
                  width={720}
                  widths={[360, 540, 720, 900]}
                  sizes="(min-width: 1280px) 440px, (min-width: 768px) 42vw, calc(100vw - 48px)"
                  loading={index === 0 ? "eager" : "lazy"}
                  class="block size-full object-cover object-center"
                />
              </div>

              <div class="min-w-0 flex flex-col justify-start border-t border-[#C5A259]/60 p-7 sm:p-9 md:col-span-7 md:justify-center md:border-t-0 md:py-10 md:pr-10 md:pl-12 lg:py-12 lg:pr-12 lg:pl-[117px] xl:py-14 xl:pr-14 xl:pl-[117px]">
                <p class="font-sans text-[11px] tracking-[0.28em] text-[#C5A259] uppercase sm:text-xs">
                  {selection.eyebrow}
                </p>
                <h2
                  id={
                    index === 0
                      ? "special-selection-title"
                      : `special-selection-title-${index}`
                  }
                  class="mt-4 sm:mt-5 max-w-full font-display text-xl sm:text-2xl md:text-[1.65rem] lg:text-[1.85rem] xl:text-[2rem] uppercase leading-tight tracking-normal text-[#FFFFFF] whitespace-normal wrap-break-word"
                >
                  {selection.title.filter(Boolean).join(" ")}
                </h2>
                <div class="mt-5 sm:mt-6 h-px w-12 sm:w-14 bg-[#C5A259]" />
                <p
                  lang="th"
                  class="mt-5 sm:mt-6 max-w-md font-sans text-sm sm:text-base leading-relaxed text-[#FFFFFF]/90 [text-wrap:pretty]"
                >
                  {
                    selection.descriptionLines ? (
                      selection.descriptionLines.map((line) => (
                        <span class="block">{line}</span>
                      ))
                    ) : (
                      selection.description
                    )
                  }
                </p>
                <div class="mt-7 sm:mt-8 border-t border-[#C5A259]/60 pt-5 sm:pt-6">
                  <div class="flex flex-col items-start gap-2.5 sm:grid sm:w-fit sm:max-w-full sm:grid-cols-[auto_auto] sm:items-baseline sm:gap-x-10 md:gap-x-12 sm:gap-y-4">
                    <div class="flex w-full items-baseline justify-between gap-4 sm:contents">
                      <span class="text-xl sm:text-2xl md:text-[1.65rem] lg:text-[1.85rem] xl:text-[2rem] uppercase font-light leading-none text-[#FFFFFF]">
                        {selection.price}
                      </span>
                      <span class="text-right font-sans text-sm sm:text-base text-[#FFFFFF]/80 whitespace-nowrap shrink-0 sm:justify-self-end">
                        {selection.availability}
                      </span>
                    </div>
                    <a
                      href={selection.branchHref}
                      tabindex={index === 0 ? undefined : -1}
                      class="inline-flex min-h-10 w-fit items-center gap-2.5 border-b border-[#C5A259] py-1.5 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]"
                    >
                      Find a branch{" "}
                      <svg
                        aria-hidden="true"
                        width="10"
                        height="10"
                        viewBox="0 0 10 10"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        class="inline-block"
                      >
                        <path
                          d="M1 9L9 1M9 1H3M9 1V7"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                    <button
                      type="button"
                      tabindex={index === 0 ? undefined : -1}
                      aria-controls="delivery-options"
                      aria-expanded="false"
                      aria-haspopup="dialog"
                      class="delivery-trigger inline-flex min-h-10 w-fit cursor-pointer items-center gap-2.5 border-b border-[#C5A259] bg-transparent py-1.5 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259] sm:justify-self-end"
                    >
                      Order delivery{" "}
                      <svg
                        aria-hidden="true"
                        width="10"
                        height="10"
                        viewBox="0 0 10 10"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        class="inline-block"
                      >
                        <path
                          d="M1 9L9 1M9 1H3M9 1V7"
                          stroke="currentColor"
                          stroke-width="1.4"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {
        slideCount > 1 && (
          <>
            <button
              type="button"
              data-special-prev
              aria-label="Previous special selection"
              class="cursor-pointer absolute -left-3 sm:-left-4 md:-left-5 lg:-left-6 top-1/2 z-10 inline-flex size-9 sm:size-10 -translate-y-1/2 items-center justify-center rounded-full border border-[#C5A259] bg-[#12221B] text-2xl text-[#FFFFFF] shadow-md transition hover:bg-[#C5A259] hover:text-[#12221B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]"
            >
              &lsaquo;
            </button>
            <button
              type="button"
              data-special-next
              aria-label="Next special selection"
              class="absolute cursor-pointer -right-3 sm:-right-4 md:-right-5 lg:-right-6 top-1/2 z-10 inline-flex size-9 sm:size-10 -translate-y-1/2 items-center justify-center rounded-full border border-[#C5A259] bg-[#12221B] text-2xl text-[#FFFFFF] shadow-md transition hover:bg-[#C5A259] hover:text-[#12221B] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]"
            >
              &rsaquo;
            </button>
          </>
        )
      }
    </div>

    {
      slideCount > 1 && (
        <div
          role="group"
          class="mt-5 sm:mt-6 flex justify-center gap-2"
          aria-label="Choose special selection"
        >
          {specialSelections.map((selection, index) => (
            <button
              type="button"
              data-special-dot={index}
              aria-label={`Go to ${selection.title.join(" ")}`}
              aria-current={index === 0 ? "true" : "false"}
              class:list={[
                "h-1.5 w-7 sm:w-8 transition-colors cursor-pointer",
                index === 0 ? "bg-[#C5A259]" : "bg-[#FFFFFF]/35",
              ]}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .special-selection-container {
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .special-selection-container {
      padding-top: 125px !important;
      padding-bottom: 125px !important;
      padding-left: 262px !important;
      padding-right: 262px !important;
    }
  }
</style>
