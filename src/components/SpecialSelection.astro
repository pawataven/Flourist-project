---
import { Image } from "astro:assets";
import cocoaDutch from "../assets/Cocoa Dutch.jpg";
---

<section id="special-selection" aria-labelledby="special-selection-title" class="border-y border-[#C5A259] bg-[#12221B] text-[#FFFFFF]">
  <div class="page-container mx-auto max-w-7xl py-12 sm:py-16 lg:py-20">
    <div class="grid min-w-0 items-stretch gap-6 lg:grid-cols-12 lg:gap-0">
      <div class="min-w-0 bg-[#080A09] p-2 sm:p-3 lg:col-span-7 lg:p-4">
        <Image
          src={cocoaDutch}
          alt="Cocoa Dutch by Flourist, a Dutch cocoa drink priced at 100 THB"
          format="webp"
          quality={82}
          width={900}
          widths={[360, 540, 720, 900, 1200]}
          sizes="(min-width: 1280px) 700px, (min-width: 1024px) 58vw, calc(100vw - 40px)"
          loading="lazy"
          class="block h-auto w-full"
        />
      </div>

      <div class="min-w-0 flex flex-col justify-center border border-[#C5A259] p-6 sm:p-8 md:p-10 lg:col-span-5 lg:border-l-0 lg:p-10 xl:p-14">
        <p class="font-sans text-[10px] tracking-[0.28em] text-[#C5A259] uppercase sm:text-xs">
          Flourist / Special Selection
        </p>
        <h2 id="special-selection-title" class="mt-6 max-w-full break-words font-display text-[clamp(2.25rem,9vw,3.5rem)] uppercase leading-[0.95] tracking-normal text-[#FFFFFF] sm:mt-7 sm:text-[clamp(2.75rem,6vw,4rem)] lg:text-[clamp(2.75rem,3.5vw,4rem)]">
          <span class="block">Cocoa</span>
          <span class="mt-3 block sm:mt-4">Dutch</span>
        </h2>
        <div class="mt-9 h-px w-14 bg-[#C5A259]"></div>
        <p class="mt-7 max-w-sm font-sans text-sm leading-7 text-[#FFFFFF] sm:text-base sm:leading-8">
          Deep Dutch cocoa, poured slowly. A rich and velvety house special for unhurried afternoons.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-[#C5A259] pt-5">
          <span class="font-sans text-2xl font-light text-[#FFFFFF]">100 THB</span>
          <span class="font-sans text-xs text-[#FFFFFF] sm:text-sm">Available at all branches</span>
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href="/map" class="inline-flex min-h-11 w-fit items-center gap-3 border-b border-[#C5A259] py-2 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">
            Find a branch <span aria-hidden="true">↗</span>
          </a>
          <button type="button" aria-controls="delivery-options" aria-expanded="false" aria-haspopup="dialog" class="delivery-trigger inline-flex min-h-11 w-fit cursor-pointer items-center gap-3 border-b border-[#C5A259] bg-transparent py-2 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">
            Order delivery <span aria-hidden="true">↗</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
