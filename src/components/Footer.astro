---
// src/components/Footer.astro
import { Image } from "astro:assets";
import logo from "../assets/Asset 2-8.png";
---

<footer
  class="bg-[#080a09] text-white border-t border-white/10 selection:bg-[#c5a259] selection:text-[#080a09]"
>
  <!-- Main Footer Content -->
  <div
    class="footer-container w-full px-4 sm:px-8 md:px-14 lg:px-[120px] pt-16 sm:pt-20 lg:pt-24 pb-12 sm:pb-16"
  >
    <!-- Top Brand Statement -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-12 sm:pb-16 border-b border-white/10"
    >
      <div>
        <a
          href="/"
          class="inline-block focus-visible:outline-none"
          aria-label="FLOURIST Matchahouse Home"
        >
          <Image
            src={logo}
            alt="FLOURIST Matchahouse"
            class="h-11 sm:h-13 md:h-14 lg:h-16 w-auto object-contain"
          />
        </a>
        <p
          class="font-sans font-light text-xs sm:text-sm text-white/60 mt-3.5 sm:mt-4 tracking-wide max-w-xl leading-relaxed"
        >
          <span class="block">A little pause. A finer daily ritual.</span>
          <span class="inline-block">จากแหล่งปลูกชาชั้นนำในญี่ปุ่น</span>
          <span class="inline-block">สู่สุนทรียภาพแห่งการดื่ม<span class="whitespace-nowrap">มัทฉะ</span>ในทุกวันของคุณ</span>
        </p>
      </div>

      <div
        class="flex items-center gap-2 sm:gap-3 text-[clamp(9.5px,2.6vw,14px)] text-[#c5a259] font-light tracking-wider sm:tracking-widest uppercase whitespace-nowrap"
      >
        <span>Flourist Matchahouse</span>
        <span
          class="w-1 h-1 sm:w-1.5 sm:h-1.5 rounded-full bg-[#c5a259] shrink-0"
          aria-hidden="true"></span>
        <span>Made for slow moments</span>
      </div>
    </div>

    <!-- Navigation Columns Grid -->
    <div
      class="mt-12 sm:mt-16 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-10 lg:gap-8"
    >
      <!-- Col 1: Explore & Menu -->
      <div class="col-span-1">
        <h3
          class="font-sans text-[12px] sm:text-sm tracking-[0.2em] uppercase text-[#c5a259] font-medium mb-4 sm:mb-5"
        >
          Explore
        </h3>
        <ul
          class="space-y-2.5 sm:space-y-3 font-sans text-xs sm:text-[13px] font-light text-white/70"
        >
          <li>
            <a href="/" class="hover:text-[#c5a259] transition-colors">
              หน้าแรก (Home)
            </a>
          </li>
          <li>
            <a href="/menu" class="hover:text-[#c5a259] transition-colors">
              เมนูมัทฉะ (Matcha Menu)
            </a>
          </li>
          <li>
            <a
              href="/menu#signature"
              class="hover:text-[#c5a259] transition-colors"
            >
              ซิกเนเจอร์ (Signature)
            </a>
          </li>
          <li>
            <a
              href="/menu#dessert"
              class="hover:text-[#c5a259] transition-colors"
            >
              ขนมและเบเกอรี (Desserts)
            </a>
          </li>
          <li>
            <a
              href="/#best-sellers"
              class="hover:text-[#c5a259] transition-colors"
            >
              สินค้าขายดี (Best Sellers)
            </a>
          </li>
          <li>
            <a
              href="/#flourist-collection"
              class="hover:text-[#c5a259] transition-colors"
            >
              เซ็ตของขวัญ (Gift Boxset)
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 2: About & Philosophy -->
      <div class="col-span-1">
        <h3
          class="font-sans text-[12px] sm:text-sm tracking-[0.2em] uppercase text-[#c5a259] font-medium mb-4 sm:mb-5"
        >
          Philosophy
        </h3>
        <ul
          class="space-y-2.5 sm:space-y-3 font-sans text-xs sm:text-[13px] font-light text-white/70"
        >
          <li>
            <a href="/about" class="hover:text-[#c5a259] transition-colors">
              เรื่องราวของเรา (Our Story)
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-[#c5a259] transition-colors">
              ที่มาของชื่อแบรนด์ (Meaning)
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-[#c5a259] transition-colors">
              ปรัชญาและความใส่ใจ (Core Values)
            </a>
          </li>
          <li>
            <a href="/about" class="hover:text-[#c5a259] transition-colors">
              แหล่งวัตถุดิบ (Terroir &amp; Origin)
            </a>
          </li>
          <li>
            <a href="/events" class="hover:text-[#c5a259] transition-colors">
              กิจกรรมและป๊อปอัป (Events)
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Locations & Delivery -->
      <div class="col-span-1">
        <h3
          class="font-sans text-[12px] sm:text-sm tracking-[0.2em] uppercase text-[#c5a259] font-medium mb-4 sm:mb-5"
        >
          Locations
        </h3>
        <ul
          class="space-y-2.5 sm:space-y-3 font-sans text-xs sm:text-[13px] font-light text-white/70"
        >
          <li>
            <a href="/map" class="hover:text-[#c5a259] transition-colors">
              ค้นหาสาขาทั้งหมด (All Stores)
            </a>
          </li>
          <li>
            <a href="/map" class="hover:text-[#c5a259] transition-colors">
              สาขาวิทยุ (Witthayu)
            </a>
          </li>
          <li>
            <a href="/map" class="hover:text-[#c5a259] transition-colors">
              สาขาราชปรารภ (Ratchaprarop)
            </a>
          </li>
          <li>
            <a href="/map" class="hover:text-[#c5a259] transition-colors">
              สาขาราชพฤกษ์ (Ratchaphruek)
            </a>
          </li>
          <li>
            <a href="/map" class="hover:text-[#c5a259] transition-colors">
              สาขาเอกมัย (Ekkamai)
            </a>
          </li>
          <li>
            <button
              type="button"
              class="delivery-trigger text-left hover:text-[#c5a259] transition-colors cursor-pointer bg-transparent border-0 p-0 text-inherit font-light"
            >
              สั่งซื้อเดลิเวอรี (Delivery)
            </button>
          </li>
        </ul>
      </div>

      <!-- Col 4 & 5 Combined Wrapper: Customer Care, Ritual & Hours, and Social Links -->
      <div
        class="col-span-2 md:col-span-4 lg:col-span-2 pt-6 md:pt-0 border-t border-white/5 md:border-0"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 lg:gap-8">
          <!-- Customer Care -->
          <div>
            <h3
              class="font-sans text-[12px] sm:text-sm tracking-[0.2em] uppercase text-[#c5a259] font-medium mb-4 sm:mb-5"
            >
              Customer Care
            </h3>
            <ul
              class="space-y-2.5 sm:space-y-3 font-sans text-xs sm:text-[13px] font-light text-white/70"
            >
              <li>
                <a
                  href="/contactUs"
                  class="hover:text-[#c5a259] transition-colors"
                >
                  ศูนย์บริการลูกค้า (Contact Us)
                </a>
              </li>
              <li>
                <a
                  href="tel:0615120465"
                  class="hover:text-[#c5a259] transition-colors"
                >
                  061 512 0465
                </a>
              </li>
              <li>
                <a
                  href="https://line.me/R/ti/p/@737nbfqd?ts=10040200&oat_content=url"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-[#c5a259] transition-colors"
                >
                  LINE: @737nbfqd
                </a>
              </li>
              <li>
                <a
                  href="mailto:flourist.bakehouse@gmail.com"
                  class="hover:text-[#c5a259] transition-colors break-all"
                >
                  flourist.bakehouse@gmail.com
                </a>
              </li>
            </ul>
          </div>

          <!-- Ritual & Hours -->
          <div>
            <h3
              class="font-sans text-[12px] sm:text-sm tracking-[0.2em] uppercase text-[#c5a259] font-medium mb-4 sm:mb-5"
            >
              Ritual &amp; Hours
            </h3>
            <div
              class="space-y-3 font-sans text-xs sm:text-[13px] font-light text-white"
            >
              <p class="leading-relaxed">
                <span class="text-white font-normal">เปิดให้บริการ:</span><br />
                วันจันทร์ &ndash; วันอาทิตย์<br />
                เวลา 10:00 น. &ndash; 20:00 น.
              </p>
            </div>
          </div>
        </div>

        <!-- Social Links: ติดตามข่าวสาร Flourist (Centered beneath Customer Care & Ritual Hours) -->
        <div
          class="pt-6 sm:pt-7 pb-6 sm:pb-7 lg:pb-0 flex flex-col items-center justify-center text-center"
        >
          <h3
            class="font-sans text-[12px] sm:text-sm tracking-[0.2em] uppercase text-[#c5a259] font-medium mb-3 sm:mb-3.5 text-center"
          >
            ติดตามข่าวสาร
          </h3>
          <div class="flex items-center justify-center gap-3.5 sm:gap-4">
            <!-- Facebook -->
            <a
              href="https://www.facebook.com/profile.php?id=61568691261547"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook Flourist"
              title="Facebook"
              class="text-[#c5a259] hover:text-white transition-all duration-200 hover:-translate-y-0.5 inline-flex items-center justify-center"
            >
              <svg
                fill="#c5a259"
                height="30px"
                width="30px"
                version="1.1"
                id="Icons"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                viewBox="0 0 32 32"
                xml:space="preserve"
              >
                <path
                  d="M23,0H9C4,0,0,4,0,9v14c0,5,4,9,9,9h7V20h-4c-0.6,0-1-0.4-1-1v-3c0-0.6,0.4-1,1-1h4v-3c0-3.3,1.7-6,5-6h4c0.6,0,1,0.4,1,1v3
	c0,0.6-0.4,1-1,1h-3.8c-0.1,0-0.2,0.1-0.2,0.2V15h5c0.3,0,0.6,0.2,0.8,0.4s0.2,0.6,0.1,0.9l-2,3C24.8,19.8,24.4,20,24,20h-3v12h2
	c5,0,9-4,9-9V9C32,4,28,0,23,0z"
                ></path>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href="https://www.instagram.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram Flourist"
              title="Instagram"
              class="text-[#c5a259] hover:text-white transition-all duration-200 hover:-translate-y-0.5 inline-flex items-center justify-center"
            >
              <svg
                fill="#c5a259"
                width="38px"
                height="38px"
                viewBox="-2 -2 24 24"
                xmlns="http://www.w3.org/2000/svg"
                preserveAspectRatio="xMinYMin"
                class="jam jam-instagram"
                ><path
                  d="M14.017 0h-8.07A5.954 5.954 0 0 0 0 5.948v8.07a5.954 5.954 0 0 0 5.948 5.947h8.07a5.954 5.954 0 0 0 5.947-5.948v-8.07A5.954 5.954 0 0 0 14.017 0zm3.94 14.017a3.94 3.94 0 0 1-3.94 3.94h-8.07a3.94 3.94 0 0 1-3.939-3.94v-8.07a3.94 3.94 0 0 1 3.94-3.939h8.07a3.94 3.94 0 0 1 3.939 3.94v8.07z"
                ></path><path
                  d="M9.982 4.819A5.17 5.17 0 0 0 4.82 9.982a5.17 5.17 0 0 0 5.163 5.164 5.17 5.17 0 0 0 5.164-5.164A5.17 5.17 0 0 0 9.982 4.82zm0 8.319a3.155 3.155 0 1 1 0-6.31 3.155 3.155 0 0 1 0 6.31z"
                ></path><circle cx="15.156" cy="4.858" r="1.237"></circle></svg
              >
            </a>

            <!-- LINE -->
            <a
              href="https://line.me/R/ti/p/@737nbfqd?ts=10040200&oat_content=url"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LINE Official Flourist"
              title="LINE Official"
              class="text-[#c5a259] hover:text-white transition-all duration-200 hover:-translate-y-0.5 inline-flex items-center justify-center"
            >
              <svg
                fill="#c5a259"
                width="38px"
                height="38px"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                data-name="Layer 1"
                ><path
                  d="M13.78,9.46h0a.38.38,0,0,0-.38.38v1.67L12,9.65a.4.4,0,0,0-.33-.19h0a.38.38,0,0,0-.38.38v2.84a.38.38,0,0,0,.38.38h0a.38.38,0,0,0,.38-.38V11l1.39,1.91,0,0h0a.27.27,0,0,0,.15.11.32.32,0,0,0,.14,0h0A.33.33,0,0,0,14,13l.1-.07h0a.39.39,0,0,0,.11-.27V9.84A.38.38,0,0,0,13.78,9.46ZM9.2,12.27H8.14V9.84a.38.38,0,0,0-.38-.38h0a.38.38,0,0,0-.38.38v2.84a.38.38,0,0,0,.38.38H9.2a.39.39,0,0,0,.39-.38v0A.39.39,0,0,0,9.2,12.27Zm1.11-2.81h0a.39.39,0,0,0-.39.38v2.84a.39.39,0,0,0,.39.38h0a.38.38,0,0,0,.38-.38V9.84A.38.38,0,0,0,10.31,9.46ZM17.91,2H6.09A4.1,4.1,0,0,0,2,6.09V17.91A4.1,4.1,0,0,0,6.09,22H17.91A4.1,4.1,0,0,0,22,17.91V6.09A4.1,4.1,0,0,0,17.91,2Zm.31,12.28a1.55,1.55,0,0,1-.13.17h0a5.5,5.5,0,0,1-.8.8c-2,1.87-5.36,4.11-5.81,3.76s.64-1.76-.53-2a1,1,0,0,1-.25,0h0c-3.44-.48-6-2.89-6-5.78,0-3.25,3.29-5.88,7.34-5.88s7.34,2.63,7.34,5.88A5,5,0,0,1,18.22,14.28ZM16.51,9.47H15a.38.38,0,0,0-.38.38v2.84a.38.38,0,0,0,.38.38h1.48a.38.38,0,0,0,.38-.38v0a.38.38,0,0,0-.38-.38H15.45v-.6h1.06a.39.39,0,0,0,.38-.39v0a.38.38,0,0,0-.38-.38H15.45v-.61h1.06a.38.38,0,0,0,.38-.38v0A.38.38,0,0,0,16.51,9.47Z"
                ></path></svg
              >
            </a>
          </div>
        </div>
      </div>
    </div>
    <!-- Bottom Legal & Copyright Bar -->
    <div
      class="mt-0 lg:mt-20 pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-[10px] sm:text-[11px] font-sans font-light text-white/50"
    >
      <!-- Copyright -->
      <div>
        <p>
          &copy; {new Date().getFullYear()} SOFT Z All rights reserved.
        </p>
      </div>

      <!-- Tagline -->
      <div class="text-white/40">
        <span>From Japan’s Finest Terroir to Your Daily Ritual</span>
      </div>

      <!-- Legal Links -->
      <div class="flex items-center gap-6">
        <a href="/contactUs" class="hover:text-white transition-colors">
          Customer Care
        </a>
        <a href="/map" class="hover:text-white transition-colors">
          Store Locator
        </a>
        <span class="cursor-default text-white/30"> Bangkok, Thailand </span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-container {
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .footer-container {
      padding-left: 120px !important;
      padding-right: 120px !important;
      max-width: 100% !important;
    }
  }
</style>
