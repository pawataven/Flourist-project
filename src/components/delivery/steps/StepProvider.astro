---
import type { ImageMetadata } from "astro";

interface Props {
    lineManLogo: ImageMetadata;
    grabLogo: ImageMetadata;
}

const { lineManLogo, grabLogo } = Astro.props;
---

<div class="delivery-step [&[hidden]]:!hidden" data-delivery-step="provider">
    <p class="mt-[22px] text-[#6b7066] text-xs leading-relaxed">เลือกแพลตฟอร์มที่ต้องการสั่ง</p>
    <div class="grid gap-3 pt-6">
        <button
            type="button"
            class="flex w-full items-center justify-between gap-4.5 min-h-[64px] px-4 py-3.5 border border-[#dcd5c6] bg-transparent text-[#172d23] text-left cursor-pointer transition-all duration-200 hover:border-[#a68241] hover:bg-[#eae5d9] hover:translate-x-[3px]"
            data-provider="lineMan"
            data-provider-logo={lineManLogo.src}
        >
            <span class="flex items-center gap-3.5">
                <img
                    src={lineManLogo.src}
                    width="40"
                    height="40"
                    alt="LINE MAN Logo"
                    class="size-10 object-contain rounded-lg shrink-0 shadow-[0_2px_6px_rgba(0,0,0,0.1)]"
                />
                <span class="text-[11px] tracking-[0.12em] uppercase font-medium">สั่งผ่าน LINE MAN</span>
            </span>
            <svg
                class="shrink-0 text-[#8b724b]"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                aria-hidden="true"
            >
                <path d="M4 12h15m-6-6 6 6-6 6" />
            </svg>
        </button>
        <button
            type="button"
            class="flex w-full items-center justify-between gap-4.5 min-h-[64px] px-4 py-3.5 border border-[#dcd5c6] bg-transparent text-[#172d23] text-left cursor-pointer transition-all duration-200 hover:border-[#a68241] hover:bg-[#eae5d9] hover:translate-x-[3px]"
            data-provider="grab"
            data-provider-logo={grabLogo.src}
        >
            <span class="flex items-center gap-3.5">
                <img
                    src={grabLogo.src}
                    width="40"
                    height="40"
                    alt="Grab Logo"
                    class="size-10 object-contain rounded-lg shrink-0 shadow-[0_2px_6px_rgba(0,0,0,0.1)]"
                />
                <span class="text-[11px] tracking-[0.12em] uppercase font-medium">สั่งผ่าน Grab</span>
            </span>
            <svg
                class="shrink-0 text-[#8b724b]"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                aria-hidden="true"
            >
                <path d="M4 12h15m-6-6 6 6-6 6" />
            </svg>
        </button>
    </div>
</div>
