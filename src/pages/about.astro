---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import { Image } from "astro:assets";
import pic1 from "../assets/About/pic1.jpg";
import pic2 from "../assets/About/p2.jpg";
---

<Layout>
  <Navbar />
  
  <main class="relative min-h-screen bg-[#080a09] text-white pt-[92px] overflow-hidden">
    <!-- Ambient Background Glows -->
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-[#12221b]/40 blur-[140px] rounded-full"></div>
    <div class="pointer-events-none absolute top-[40%] -right-40 w-[600px] h-[600px] bg-[#c5a259]/10 blur-[160px] rounded-full"></div>
    <div class="pointer-events-none absolute bottom-[20%] -left-40 w-[600px] h-[600px] bg-[#12221b]/50 blur-[150px] rounded-full"></div>

    <!-- ──────── HERO / INTRO SECTION ──────── -->
    <section class="relative px-6 py-16 sm:px-10 sm:py-24 lg:px-16">
      <div class="mx-auto max-w-5xl text-center">

        <h1 class="font-display text-4xl sm:text-5xl lg:text-4xl uppercase tracking-wider text-[#c5a259] [-webkit-text-stroke:1px_#c5a259] leading-tight">
          Our Story & Philosophy
        </h1>

        <!-- Lead Narrative Box (without text-justify) -->
        <div class="relative mt-12 overflow-hidden rounded-2xl border border-[#c5a259]/25 bg-gradient-to-b from-[#12221b]/60 to-[#0d1712]/40 p-8 sm:p-12 lg:p-14 shadow-2xl backdrop-blur-md">
          <div class="absolute -top-10 -left-10 text-7xl text-[#c5a259]/10 font-serif select-none pointer-events-none">“</div>
          <div class="absolute -bottom-14 -right-10 text-7xl text-[#c5a259]/10 font-serif select-none pointer-events-none">”</div>
          
          <p
            lang="th"
            class="relative z-10 font-sans text-base sm:text-lg leading-relaxed sm:leading-loose text-white/90 font-light text-justify [text-align-last:left] [text-justify:inter-word] max-w-4xl mx-auto break-words"
          >
            <span class="text-[#c5a259] font-medium font-sans">Flourist Matchahouse</span> เริ่มต้น<wbr>เส้นทาง<wbr>ธุรกิจ<wbr>จาก<wbr>ความ<wbr>ชื่นชอบ<wbr>ใน<wbr>ขนมหวาน<wbr>โฮมเมด โดยเฉพาะ<wbr>ไดฟูกุ ก่อนจะ<wbr>ขยาย<wbr>มิติ<wbr>ของ<wbr>แบรนด์<wbr>เข้าสู่<wbr>วัฒนธรรม<wbr>ชาเขียว<wbr>อย่าง<wbr>เต็ม<wbr>รูปแบบ ด้วย<wbr>การ<wbr>คัดสรร<wbr>ผงมัทฉะ<wbr>คุณภาพ<wbr>สูง<wbr>จาก<wbr>หลาก<wbr>หลาย<wbr>แหล่ง<wbr>ปลูก<wbr>ใน<wbr>ประเทศ<wbr>ญี่ปุ่น เพื่อ<wbr>สร้าง<wbr>สุนทรียภาพ<wbr>ใน<wbr>การ<wbr>จับคู่<wbr>รสชาติ<wbr>ระหว่าง<wbr>มัทฉะ<wbr>และ<wbr>ขนมหวาน จาก<wbr>จุด<wbr>เริ่มต้น<wbr>สาขา<wbr>แรก<wbr>สู่<wbr>การ<wbr>ขยาย<wbr>สาขา<wbr>ใน<wbr>เขต<wbr>เมือง แบรนด์<wbr>ยังคง<wbr>ยึดมั่น<wbr>ใน<wbr>ความ<wbr>พิถีพิถัน ละเมียดละไม และ<wbr>การ<wbr>ส่งมอบ<wbr>ประสบการณ์<wbr>มัทฉะ<wbr>ระดับ<wbr>สเปเชียลตี<wbr>ให้แก่<wbr>ผู้บริโภค
          </p>

          <div class="mt-8 flex items-center justify-center gap-3 text-[#c5a259]/50">
            <div class="h-[1px] w-12 bg-gradient-to-r from-transparent to-[#c5a259]/60"></div>
            <span class="text-xs uppercase tracking-widest text-[#c5a259]">Specialty Matcha & Homemade Craft</span>
            <div class="h-[1px] w-12 bg-gradient-to-l from-transparent to-[#c5a259]/60"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ──────── SECTION 1: BRAND ORIGIN & JOURNEY (IMAGE 1) ──────── -->
    <section class="relative px-6 py-16 sm:px-10 lg:px-16 border-t border-white/5">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Image 1 Column -->
          <div class="lg:col-span-6 order-2 lg:order-1">
            <div class="relative group">
              <!-- Decorative Frame Offset -->
              <div class="absolute -inset-2 rounded-2xl border border-[#c5a259]/30 translate-x-2 translate-y-2 transition-transform duration-500 group-hover:translate-x-3 group-hover:translate-y-3 pointer-events-none"></div>
              
              <div class="relative overflow-hidden rounded-xl border border-white/15 bg-[#121915] shadow-2xl">
                <Image
                  src={pic1}
                  alt="FLOURIST Matchahouse Brand Journey & Craft"
                  quality={100}
                  class="w-full h-auto max-h-[580px] object-cover object-center transition duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#080a09]/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs text-white/80 bg-[#080a09]/70 backdrop-blur-sm px-4 py-2 rounded-lg border border-white/10">
                  <span class="text-[#c5a259] font-medium font-serif">FLOURIST ORIGIN</span>
                  <span class="text-white/60">Crafted with Devotion</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Narrative Column -->
          <div class="lg:col-span-6 order-1 lg:order-2 space-y-8">
            <div>
              <span class="text-xs font-semibold uppercase tracking-widest text-[#c5a259]">Chapter 01</span>
              <h2 class="mt-2 font-display text-3xl sm:text-4xl text-white uppercase tracking-wide">
                1. จุดเริ่มต้นและการเติบโต
              </h2>
              <p class="mt-1 font-serif text-sm text-[#c5a259]/80 tracking-wider">
                Brand Origin & Journey
              </p>
            </div>

            <!-- Milestone 1 -->
            <div class="relative pl-7 border-l-2 border-[#c5a259]/40 space-y-1.5 transition hover:border-[#c5a259]">
              <div class="absolute -left-[9px] top-0 h-4 w-4 rounded-full border-2 border-[#c5a259] bg-[#080a09]"></div>
              <h3 class="text-lg font-semibold text-[#c5a259]">
                จุดเริ่มต้นจากขนมหวาน:
              </h3>
              <p class="font-sans text-sm sm:text-[15px] text-white/80 leading-relaxed font-light text-left">
                FLOURIST ไม่ได้เริ่มจากการเป็นร้านชาเขียวเพียวๆ ตั้งแต่แรก แต่เริ่มต้นจากการทำ "ไดฟูกุ (Signature Daifuku)" และเบเกอรีโฮมเมด
              </p>
            </div>

            <!-- Milestone 2 -->
            <div class="relative pl-7 border-l-2 border-[#c5a259]/40 space-y-1.5 transition hover:border-[#c5a259]">
              <div class="absolute -left-[9px] top-0 h-4 w-4 rounded-full border-2 border-[#c5a259] bg-[#080a09]"></div>
              <h3 class="text-lg font-semibold text-[#c5a259]">
                ก้าวสู่ Matcha Specialty:
              </h3>
              <p class="font-sans text-sm sm:text-[15px] text-white/80 leading-relaxed font-light text-left">
                ด้วยความหลงใหลในวัตถุดิบและความลงตัวเมื่อทานขนมคู่กับมัทฉะ จึงได้พัฒนาและคัดสรรผงมัทฉะเกรดพรีเมียมจากญี่ปุ่นอย่างจริงจัง จนเติบโตกลายมาเป็น Matcha Specialty House เต็มตัว
              </p>
            </div>

            <!-- Milestone 3 -->
            <div class="relative pl-7 border-l-2 border-[#c5a259]/40 space-y-1.5 transition hover:border-[#c5a259]">
              <div class="absolute -left-[9px] top-0 h-4 w-4 rounded-full border-2 border-[#c5a259] bg-[#080a09]"></div>
              <h3 class="text-lg font-semibold text-[#c5a259]">
                สาขาแรกตั้งต้น:
              </h3>
              <p class="font-sans text-sm sm:text-[15px] text-white/80 leading-relaxed font-light text-left">
                ปักหลักสาขาแรกที่ย่าน สามโคก ปทุมธานี ด้วยบรรยากาศสไตล์คาเฟ่โฮมเมด ล้อมรอบด้วยต้นไม้และดอกไม้ ก่อนจะขยายตัวและปักหมุด Pop-up Store เข้าสู่ใจกลางเมืองและขยายสาขารูปแบบ Grab & Go / Flagship กระจายตามมุมเมือง
              </p>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- ──────── SECTION 2: BRAND NAME MEANING ──────── -->
    <section class="relative px-6 py-20 sm:px-10 lg:px-16 bg-gradient-to-b from-[#080a09] via-[#0d1612] to-[#080a09] border-t border-b border-white/5">
      <div class="mx-auto max-w-5xl text-center">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#c5a259]">Chapter 02</span>
        <h2 class="mt-2 font-display text-3xl sm:text-4xl text-white uppercase tracking-wide">
          2. ที่มาของชื่อแบรนด์
        </h2>
        <p class="mt-1 font-serif text-sm text-[#c5a259]/80 tracking-wider">
          Brand Name Meaning
        </p>

        <!-- Big Typography Equation -->
        <div class="mt-10 mb-6 flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-2xl sm:text-4xl lg:text-5xl font-display uppercase tracking-widest text-white">
          <span class="text-[#c5a259] drop-shadow-[0_0_25px_rgba(197,162,89,0.3)]">FLOURIST</span>
          <span class="text-white/30">=</span>
          <span class="text-white/90">FLOUR</span>
          <span class="text-[#c5a259] font-serif font-light text-2xl sm:text-3xl">+</span>
          <span class="text-white/90">FLORIST</span>
        </div>

        <p class="font-sans text-base sm:text-lg text-white/85 mb-10 font-light">
          FLOURIST = Flour (แป้ง) + Florist (คนขายดอกไม้ / ความเบ่งบาน):
        </p>

        <!-- 2 Meaning Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 text-left">
          
          <!-- Card 1: Flour -->
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#121915]/60 p-8 sm:p-10 transition duration-500 hover:border-[#c5a259]/50 hover:bg-[#121915] hover:shadow-[0_10px_35px_-10px_rgba(197,162,89,0.2)]">
            <div class="flex items-center justify-between mb-4">
              <span class="font-display text-3xl text-[#c5a259] tracking-wider">FLOUR</span>
              <span class="text-xs tracking-widest uppercase text-white/50 border border-white/15 px-2.5 py-1 rounded-full">แป้ง</span>
            </div>
            <h3 class="font-serif text-xl text-white font-medium mb-3">
              Flour (แป้ง)
            </h3>
            <p class="font-sans text-sm sm:text-[15px] text-white/80 leading-relaxed font-light text-left">
              สะท้อนถึงรากเหง้าของแบรนด์ที่เริ่มต้นจากการทำขนมหวาน เบเกอรี และไดฟูกุ
            </p>
            <div class="mt-6 h-[1px] w-16 bg-[#c5a259]/40 transition-all duration-300 group-hover:w-full"></div>
          </div>

          <!-- Card 2: Florist -->
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-[#121915]/60 p-8 sm:p-10 transition duration-500 hover:border-[#c5a259]/50 hover:bg-[#121915] hover:shadow-[0_10px_35px_-10px_rgba(197,162,89,0.2)]">
            <div class="flex items-center justify-between mb-4">
              <span class="font-display text-3xl text-[#c5a259] tracking-wider">FLORIST</span>
              <span class="text-xs tracking-widest uppercase text-white/50 border border-white/15 px-2.5 py-1 rounded-full">ดอกไม้</span>
            </div>
            <h3 class="font-serif text-xl text-white font-medium mb-3">
              Florist (ดอกไม้)
            </h3>
            <p class="font-sans text-sm sm:text-[15px] text-white/80 leading-relaxed font-light text-left">
              สะท้อนถึงความละเมียดละไม บรรยากาศร้านที่ร่มรื่น และการปรุงแต่งรสชาติที่พิถีพิถันเสมือนการประดิดประดอยดอกไม้
            </p>
            <div class="mt-6 h-[1px] w-16 bg-[#c5a259]/40 transition-all duration-300 group-hover:w-full"></div>
          </div>

        </div>
      </div>
    </section>

    <!-- ──────── SECTION 3: CORE VALUES & PHILOSOPHY (IMAGE 2) ──────── -->
    <section class="relative px-6 py-16 sm:px-10 lg:px-16">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Philosophy Narrative Column -->
          <div class="lg:col-span-6 space-y-6">
            <div>
              <span class="text-xs font-semibold uppercase tracking-widest text-[#c5a259]">Chapter 03</span>
              <h2 class="mt-2 font-display text-3xl sm:text-4xl text-white uppercase tracking-wide">
                3. ปรัชญาและคุณค่าของแบรนด์
              </h2>
              <p class="mt-1 font-serif text-sm text-[#c5a259]/80 tracking-wider">
                Core Values
              </p>
            </div>

            <!-- Pillar 1 -->
            <div class="rounded-xl border border-white/10 bg-[#121915]/50 p-6 sm:p-7 transition hover:border-[#c5a259]/40">
              <div class="flex items-center gap-3 mb-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#c5a259]/20 text-xs font-semibold text-[#c5a259]">01</span>
                <h3 class="font-serif text-xl text-[#c5a259] font-medium">
                  Craftsmanship & Pairing:
                </h3>
              </div>
              <p class="font-sans text-sm sm:text-[15px] text-white/80 leading-relaxed font-light text-left mt-2">
                ความเชื่อที่ว่ามัทฉะที่ดีต้องมาพร้อมกับขนมที่ดี การรังสรรค์เมนูจึงเน้นการจับคู่รสชาติ (Pairing) ระหว่างมัทฉะสายพันธุ์ต่างๆ กับเบเกอรีสูตรพิเศษของทางร้าน
              </p>
            </div>

            <!-- Pillar 2 -->
            <div class="rounded-xl border border-white/10 bg-[#121915]/50 p-6 sm:p-7 transition hover:border-[#c5a259]/40">
              <div class="flex items-center gap-3 mb-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-[#c5a259]/20 text-xs font-semibold text-[#c5a259]">02</span>
                <h3 class="font-serif text-xl text-[#c5a259] font-medium">
                  Accessibility to Specialty Matcha:
                </h3>
              </div>
              <p class="font-sans text-sm sm:text-[15px] text-white/80 leading-relaxed font-light text-left mt-2">
                การทำให้มัทฉะเกรดพิธีการ (Ceremonial Grade) และผงชาเฉพาะสายพันธุ์ (Single Cultivar) เข้าถึงง่ายสำหรับคนทั่วไป ไม่ว่าจะเป็นสายชงใส (Clear) หรือสายลาเต้ (Latte)
              </p>
            </div>

          </div>

          <!-- Image 2 Column -->
          <div class="lg:col-span-6">
            <div class="relative group">
              <!-- Decorative Frame Offset -->
              <div class="absolute -inset-2 rounded-2xl border border-[#c5a259]/30 -translate-x-2 translate-y-2 transition-transform duration-500 group-hover:-translate-x-3 group-hover:translate-y-3 pointer-events-none"></div>
              
              <div class="relative overflow-hidden rounded-xl border border-white/15 bg-[#121915] shadow-2xl">
                <Image
                  src={pic2}
                  alt="FLOURIST Matchahouse 2"
                  quality={100}
                  class="w-full h-auto max-h-[580px] object-cover object-center transition duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[#080a09]/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs text-white/80 bg-[#080a09]/70 backdrop-blur-sm px-4 py-2 rounded-lg border border-white/10">
                  <span class="text-[#c5a259] font-medium font-serif">SPECIALTY MATCHA</span>
                  <span class="text-white/60">From Terroir to Ritual</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ──────── CALL TO ACTION ──────── -->
    <section class="relative px-6 py-20 sm:px-10 lg:px-16 border-t border-white/10">
      <div class="mx-auto max-w-4xl text-center space-y-6">
        <p class="font-display text-2xl sm:text-3xl lg:text-4xl text-[#c5a259] uppercase tracking-wider">
          From Japan’s Finest Terroir to Your Daily Ritual.
        </p>
        <p class="font-sans text-sm sm:text-base text-white/70 max-w-2xl mx-auto leading-relaxed">
          ร่วมสัมผัสประสบการณ์มัทฉะระดับสเปเชียลตี และขนมหวานที่รังสรรค์ด้วยความรักได้ที่ FLOURIST Matchahouse ทุกสาขา
        </p>
        
        <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/#best-sellers"
            class="inline-flex rounded-md bg-white px-7 py-3 font-sans text-xs font-bold text-[#12221b] transition hover:bg-[#eee9e3] uppercase tracking-wider shadow-lg"
          >
            Explore Menu
          </a>
          <a
            href="/map"
            class="inline-flex rounded-md border border-[#c5a259] bg-[#c5a259]/10 px-7 py-3 font-sans text-xs font-bold text-[#c5a259] transition hover:bg-[#c5a259] hover:text-[#080a09] uppercase tracking-wider"
          >
            Find Our Stores
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>
