---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import { Image } from "astro:assets";
import originImage from "../assets/About/pic1.jpg";
import specialtyMatchaImage from "../assets/About/p2.jpg";
import pic1 from "../assets/About/Asset_1-100.jpg";
---

<Layout>
  <Navbar />
  <main class="min-h-screen bg-[#080a09] text-white pt-28 sm:pt-40 lg:pt-48 pb-20 sm:pb-32 selection:bg-[#c5a259] selection:text-[#080a09]">
    <div class="page-container mx-auto max-w-6xl">
      
      <!-- Section 1: Hero & Philosophy -->
      <header class="text-center max-w-5xl mx-auto">
        <p class="text-[10px] sm:text-xs tracking-[0.25em] uppercase text-[#c5a259] font-light">
          ABOUT FLOURIST
        </p>
        <h1 class="mt-2.5 sm:mt-3 font-display uppercase text-2xl sm:text-3xl md:text-[36px] leading-snug sm:leading-relaxed text-white tracking-wider">
          Our Story &amp; Philosophy
        </h1>
        <p class="font-sans text-xs sm:text-sm text-white/60 mt-2 sm:mt-4 tracking-wider font-light">
          เรื่องราว ความหลงใหล และศิลปะแห่งมัทฉะของ FLOURIST
        </p>

        <!-- Brand Intro Paragraph -->
        <p
          lang="th"
          class="mt-6 sm:mt-8 font-sans font-light text-[13px] sm:text-sm md:text-[14.5px] leading-relaxed sm:leading-[2.2] text-white/80 text-justify sm:text-center [text-align-last:center] [text-justify:inter-word] max-w-5xl mx-auto px-1 sm:px-4"
        >
          <span class="text-[#c5a259] font-normal">FLOURIST Matchahouse</span> เริ่มต้นเส้นทางธุรกิจจากความชื่นชอบในขนมหวานโฮมเมด โดยเฉพาะไดฟูกุ ก่อนจะขยายมิติของแบรนด์เข้าสู่วัฒนธรรมชาเขียวอย่างเต็มรูปแบบ ด้วยการคัดสรรผงมัทฉะคุณภาพสูงจากหลากหลายแหล่งปลูกในประเทศญี่ปุ่น เพื่อสร้างสุนทรียภาพในการจับคู่รสชาติระหว่างมัทฉะและขนมหวาน จากจุดเริ่มต้นสาขาแรกสู่การขยายสาขาในเขตเมือง แบรนด์ยังคงยึดมั่นในความพิถีพิถัน ละเมียดละไม และการส่งมอบประสบการณ์มัทฉะระดับสเปเชียลตีให้แก่ผู้บริโภค
        </p>
      </header>

      <!-- Section 2: Journey Milestones (3 Clean Columns like Contact Channels) -->
      <div class="mt-12 sm:mt-20 max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10 md:gap-8 lg:gap-14 text-center">
        
        <!-- Milestone 1 -->
        <div class="flex flex-col items-center h-full">
          <span class="text-[11px] sm:text-xs tracking-[0.2em] uppercase text-[#c5a259] font-medium">01</span>
          <h2 class="font-sans text-sm sm:text-base font-medium text-white tracking-wider mt-2">
            จุดเริ่มต้นจากขนมหวาน
          </h2>
          <p class="mt-2 sm:mt-3 font-sans font-light text-xs sm:text-[13px] leading-relaxed text-white/60 max-w-[280px]">
            เริ่มต้นจากการทำ "ไดฟูกุ (Signature Daifuku)" และเบเกอรีโฮมเมด ด้วยความตั้งใจที่จะส่งมอบความอร่อยที่ละมุนละไมในทุกคำ
          </p>
        </div>

        <!-- Milestone 2 -->
        <div class="flex flex-col items-center h-full">
          <span class="text-[11px] sm:text-xs tracking-[0.2em] uppercase text-[#c5a259] font-medium">02</span>
          <h2 class="font-sans text-sm sm:text-base font-medium text-white tracking-wider mt-2">
            ก้าวสู่ Matcha Specialty
          </h2>
          <p class="mt-2 sm:mt-3 font-sans font-light text-xs sm:text-[13px] leading-relaxed text-white/60 max-w-[280px]">
            ด้วยความหลงใหลในศาสตร์ของชาเขียว จึงได้คัดสรรผงมัทฉะเกรดพรีเมียมจากแหล่งปลูกชั้นนำในญี่ปุ่น สู่การเป็น Specialty House เต็มรูปแบบ
          </p>
        </div>

        <!-- Milestone 3 -->
        <div class="flex flex-col items-center h-full">
          <span class="text-[11px] sm:text-xs tracking-[0.2em] uppercase text-[#c5a259] font-medium">03</span>
          <h2 class="font-sans text-sm sm:text-base font-medium text-white tracking-wider mt-2">
            สาขาแรกและการเติบโต
          </h2>
          <p class="mt-2 sm:mt-3 font-sans font-light text-xs sm:text-[13px] leading-relaxed text-white/60 max-w-[280px]">
            จากสาขาแรกในบรรยากาศร่มรื่น สู่การขยายสาขาทั่วเมือง เพื่อให้ทุกคนเข้าถึงสุนทรียรสของมัทฉะแท้ได้ในทุกช่วงเวลาของชีวิต
          </p>
        </div>

      </div>

      <!-- Section 3: The Meaning of FLOURIST -->
      <section class="mt-16 sm:mt-28 lg:mt-36 border-t border-white/10 pt-14 sm:pt-24 lg:pt-28 text-center">
        <h2 class="font-display uppercase text-xl sm:text-2xl md:text-[28px] tracking-wider text-white">
          THE MEANING OF FLOURIST
        </h2>
        <p class="font-sans font-light text-xs sm:text-sm text-white/70 max-w-2xl mx-auto mt-3 sm:mt-5 leading-relaxed px-2 sm:px-4">
          การผสานคำระหว่างสองโลกแห่งความประณีต สะท้อนจิตวิญญาณและหัวใจของแบรนด์
        </p>

        <!-- Minimalist Equation (Mobile-Optimized on 1 Line) -->
        <div
          class="mt-8 sm:mt-14 flex items-center justify-center gap-2 sm:gap-5 md:gap-7 font-display text-[clamp(15px,4.5vw,34px)] uppercase tracking-[0.06em] sm:tracking-[0.12em] whitespace-nowrap"
          aria-label="FLOURIST = FLOUR + FLORIST"
        >
          <span class="text-[#c5a259]">FLOURIST</span>
          
          <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#c5a259] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
            <line x1="4" y1="9" x2="20" y2="9" />
            <line x1="4" y1="15" x2="20" y2="15" />
          </svg>

          <span class="text-white font-light">FLOUR</span>

          <svg class="w-3.5 h-3.5 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#c5a259] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
            <line x1="12" y1="4" x2="12" y2="20" />
            <line x1="4" y1="12" x2="20" y2="12" />
          </svg>

          <span class="text-white font-light">FLORIST</span>
        </div>

        <!-- Meaning Breakdown (2 Columns) -->
        <div class="mt-10 sm:mt-16 max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 text-center">
          <div class="flex flex-col items-center">
            <h3 class="font-sans text-sm sm:text-base font-medium text-white tracking-widest uppercase">
              FLOUR <span class="text-xs text-[#c5a259] font-normal tracking-wider">(แป้ง)</span>
            </h3>
            <p class="mt-2 sm:mt-3 font-sans font-light text-xs sm:text-[13px] leading-relaxed text-white/60 max-w-[300px]">
              สะท้อนถึงรากเหง้าของแบรนด์ที่เริ่มต้นจากการทำขนมหวาน เบเกอรี และไดฟูกุโฮมเมดที่ใส่ใจในทุกขั้นตอน
            </p>
          </div>

          <div class="flex flex-col items-center">
            <h3 class="font-sans text-sm sm:text-base font-medium text-white tracking-widest uppercase">
              FLORIST <span class="text-xs text-[#c5a259] font-normal tracking-wider">(ดอกไม้)</span>
            </h3>
            <p class="mt-2 sm:mt-3 font-sans font-light text-xs sm:text-[13px] leading-relaxed text-white/60 max-w-[300px]">
              สะท้อนถึงความละเมียดละไม ความสงบ และการรังสรรค์รสชาติอย่างประณีตเสมือนการจัดเรียงกลีบดอกไม้
            </p>
          </div>
        </div>

        <!-- Showcase Image 1: Brand Craft & Journey -->
        <div class="mt-10 sm:mt-16 mx-auto w-full max-w-[620px] px-1 sm:px-4">
          <div class="relative overflow-hidden rounded-lg sm:rounded-xl border border-white/10 shadow-2xl bg-[#121915]">
            <Image
              src={originImage}
              alt="FLOURIST Matchahouse Brand Journey & Craft"
              quality={100}
              class="w-full h-auto object-cover max-h-[380px] sm:max-h-[560px]"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <!-- Section 4: Core Values & Craftsmanship -->
      <section class="mt-16 sm:mt-28 lg:mt-36 border-t border-white/10 pt-14 sm:pt-24 lg:pt-28 text-center">
        <h2 class="font-display uppercase text-xl sm:text-2xl md:text-[28px] tracking-wider text-white">
          OUR CORE VALUES
        </h2>
        <p class="font-sans font-light text-xs sm:text-sm text-white/70 max-w-2xl mx-auto mt-3 sm:mt-5 leading-relaxed px-2 sm:px-4">
          ปรัชญาที่เรายึดมั่น เพื่อส่งมอบประสบการณ์มัทฉะที่แท้จริงและไร้ที่ติ
        </p>

        <!-- 2 Core Values -->
        <div class="mt-10 sm:mt-16 max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 text-center">
          <div class="flex flex-col items-center">
            <h3 class="font-sans text-sm sm:text-base font-medium text-white tracking-wider">
              Craftsmanship &amp; Pairing
            </h3>
            <p class="mt-2 sm:mt-3 font-sans font-light text-xs sm:text-[13px] leading-relaxed text-white/60 max-w-[320px]">
              ความเชื่อที่ว่ามัทฉะที่ดีต้องมาพร้อมกับขนมที่ดี การรังสรรค์เมนูจึงเน้นการจับคู่รสชาติ (Pairing) ระหว่างมัทฉะสายพันธุ์ต่างๆ กับเบเกอรีสูตรพิเศษของทางร้าน
            </p>
          </div>

          <div class="flex flex-col items-center">
            <h3 class="font-sans text-sm sm:text-base font-medium text-white tracking-wider">
              Accessibility to Specialty Matcha
            </h3>
            <p class="mt-2 sm:mt-3 font-sans font-light text-xs sm:text-[13px] leading-relaxed text-white/60 max-w-[320px]">
              การทำให้มัทฉะเกรดพิธีการ (Ceremonial Grade) และผงชาเฉพาะสายพันธุ์ (Single Cultivar) เข้าถึงง่ายสำหรับทุกคน ไม่ว่าจะเป็นสายชงใส (Clear) หรือสายลาเต้ (Latte)
            </p>
          </div>
        </div>

        <!-- Showcase Image 2: Specialty Matcha -->
        <div class="mt-10 sm:mt-16 mx-auto w-full max-w-[540px] px-1 sm:px-4">
          <div class="relative overflow-hidden rounded-lg sm:rounded-xl border border-white/10 shadow-2xl bg-[#121915]">
            <Image
              src={specialtyMatchaImage}
              alt="FLOURIST Matchahouse Specialty Matcha"
              quality={100}
              class="w-full h-auto object-cover max-h-[380px] sm:max-h-[580px]"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <!-- Section 5: Signature Brand Photo Banner -->
      <section class="mt-16 sm:mt-28 lg:mt-36 border-t border-white/10 pt-14 sm:pt-24 lg:pt-28 text-center">
        <div class="mx-auto w-full max-w-5xl px-1 sm:px-4">
          <div class="relative overflow-hidden rounded-lg sm:rounded-xl border border-white/10 shadow-2xl bg-[#121915]">
            <Image
              src={pic1}
              alt="FLOURIST Matchahouse Specialty Matcha & Atmosphere"
              quality={100}
              class="w-full h-auto object-cover max-h-[260px] sm:max-h-[540px]"
              loading="lazy"
            />
          </div>
        </div>
      </section>

      <!-- Section 6: Closing & Call to Action (In contactUs luxury style) -->
      <section class="mt-16 sm:mt-28 text-center pt-6 sm:pt-8">
        <p class="text-[10px] sm:text-xs tracking-[0.25em] uppercase text-[#c5a259] font-light">
          FLOURIST MATCHAHOUSE
        </p>
        <h2 class="mt-3 w-full min-w-0 flex flex-col items-center text-center gap-1 sm:gap-2 font-display uppercase text-[clamp(14px,3.8vw,34px)] leading-tight tracking-wide sm:tracking-wider max-w-4xl mx-auto">
          <span class="block whitespace-nowrap text-white">From Japan’s Finest Terroir</span>
          <span class="block whitespace-nowrap text-[#c5a259]">to Your Daily Ritual.</span>
        </h2>
        <p class="font-sans font-light text-[clamp(9.5px,2.4vw,14px)] text-white/60 max-w-none mx-auto mt-3 sm:mt-4 leading-relaxed px-1 whitespace-nowrap text-center">
          สัมผัสสุนทรียภาพแห่งมัทฉะและขนมอบโฮมเมดได้ที่หน้าร้าน หรือเลือกชมเมนูประจำฤดูกาลของเรา
        </p>

        <!-- Action Links matching contactUs style -->
        <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row items-center justify-center gap-5 sm:gap-12">
          <a
            href="/menu"
            class="inline-flex items-center gap-2 text-xs sm:text-sm text-white hover:text-[#c5a259] transition-colors underline underline-offset-8 decoration-1 decoration-[#c5a259] hover:decoration-white"
          >
            <svg class="w-4 h-4 text-[#c5a259] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <span>Explore Matcha Menu</span>
          </a>

          <a
            href="/map"
            class="inline-flex items-center gap-2 text-xs sm:text-sm text-white hover:text-[#c5a259] transition-colors underline underline-offset-8 decoration-1 decoration-[#c5a259] hover:decoration-white"
          >
            <svg class="w-4 h-4 text-[#c5a259] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>ดูสาขาของเรา</span>
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>
