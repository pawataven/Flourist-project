---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductBoxCard from "../components/ProductBoxCard.astro";
import { products } from "../Bestsellerdata";
import { boxsets } from "../Boxsetdata";
import banner from "../assets/banner.jpg";

---


<Layout>
  <Navbar />
  <main>
    <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-black text-white">
      <img src={banner.src} alt="Tea producers in a Japanese tea field" class="absolute inset-0 size-full object-cover" />
      <div class="absolute inset-0 bg-black/50"></div>

      <div class="relative z-10 mx-auto mt-16 px-6 text-center">
        <h1 class="font-sans text-3xl leading-tight sm:text-4xl md:text-[28px]">
          From Japan’s Finest Terroir to Your Daily Ritual.
        </h1>
        <a href="#best-sellers" class="mt-7 inline-flex rounded-md bg-white px-5 py-3 font-sans text-[12px] font-bold text-[#12221b] transition hover:bg-[#eee9e3]">
          Explore Matcha
        </a>
      </div>
    </section>

    <section id="best-sellers" class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#171513] sm:text-[22px]">Best Sellers - สินค้าขายดี</h2>

      <div class="group relative">
        <div data-product-carousel class="cursor-grab overflow-hidden select-none touch-pan-y active:cursor-grabbing">
          <div data-product-track class="flex gap-4 sm:gap-5 will-change-transform">
          {
            products.map((product) => (
              <div data-product-item class="w-[calc(50%-8px)] sm:w-[calc(50%-10px)] lg:w-[calc(25%-15px)] shrink-0">
                <ProductCard product={product} />
              </div>
            ))
          }
          </div>
        </div>

        <button
          type="button"
          data-carousel-prev
          aria-label="Previous products"
          class="pointer-events-auto absolute left-1 top-[100px] sm:top-[150px] z-10 inline-flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-3xl leading-none text-white opacity-100 transition hover:bg-black/65 focus-visible:opacity-100 lg:pointer-events-none lg:opacity-0 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
        >
          &lsaquo;
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Next products"
          class="pointer-events-auto absolute right-1 top-[100px] sm:top-[150px] z-10 inline-flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-3xl leading-none text-white opacity-100 transition hover:bg-black/65 focus-visible:opacity-100 lg:pointer-events-none lg:opacity-0 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
        >
          &rsaquo;
        </button>
      </div>

      <div class="mt-8 flex justify-center gap-2" data-carousel-dots aria-label="Choose product page">
        {
          Array.from({ length: 4 }).map((_, index) => (
            <button
              type="button"
              data-carousel-dot={index}
              aria-label={`Go to product page ${index + 1}`}
              class:list={[
                "size-2.5 rounded-full bg-[#d1d1d1] transition-colors",
                index === 0 && "bg-[#333333]",
                index >= 2 && "lg:hidden"
              ]}
            ></button>
          ))
        }
      </div>
    </section>

    <section class="bg-[#12221b]">
      <div class="mx-auto max-w-5xl px-6 py-12 text-center text-white sm:py-16 md:py-20">
        <h3 class="font-sans text-sm sm:text-base md:text-lg lg:text-xl font-normal leading-relaxed md:leading-loose">
          รับข่าวสารเกี่ยวกับการเปิดตัวคอลเล็กชั่น การติดต่อเพื่อส่งข่าวสารสุดพิเศษ <br class="hidden sm:inline" />
          และข่าวสารล่าสุดจากแบรนด์สุดเอ็กซ์คลูซีฟได้ที่นี่
        </h3>
      </div>
    </section>

    <section id="sokutai-collection" class="mx-auto max-w-7xl px-6 py-24 sm:px-8 lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#171513] sm:text-[22px]">The Sokutai Collection - โซกุไต Box set </h2>
      <div class="group relative">
        <div class="flex gap-5 sm:gap-6 overflow-x-auto select-none [scrollbar-width:none]">
          <div class="flex gap-5 sm:gap-6 w-full">
          {
            boxsets.map((boxset) => (
              <div class="w-[400px] max-w-full shrink-0">
                <ProductBoxCard boxset={boxset} />
              </div>
            ))
          }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-product-carousel]");
  const track = document.querySelector<HTMLElement>("[data-product-track]");
  const realItems = Array.from(track?.querySelectorAll<HTMLElement>("[data-product-item]") ?? []);
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
  const previous = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");

  if (carousel && track && realItems.length > 1) {
    const realCount = realItems.length;
    const CLONE_COUNT = 4;

    for (let i = realCount - 1; i >= realCount - CLONE_COUNT; i--) {
      const clone = realItems[i].cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      track.prepend(clone);
    }
    for (let i = 0; i < CLONE_COUNT; i++) {
      const clone = realItems[i].cloneNode(true) as HTMLElement;
      clone.setAttribute("aria-hidden", "true");
      track.appendChild(clone);
    }

    let activePage = 0;
    let currentX = 0;
    let animationId: number | null = null;

    const getCardsPerPage = () => (window.innerWidth >= 1024 ? 4 : 2);

    const getCardStep = () => {
      const item = track.querySelector<HTMLElement>("[data-product-item]");
      const gap = window.innerWidth >= 640 ? 20 : 16;
      return (item?.offsetWidth ?? 0) + gap;
    };

    const setTransform = (x: number) => {
      currentX = x;
      track.style.transform = `translateX(${x}px)`;
    };

    const normalizePosition = () => {
      const cardsPerPage = getCardsPerPage();
      const step = getCardStep();
      const realTargetX = -(CLONE_COUNT + activePage * cardsPerPage) * step;
      setTransform(realTargetX);
    };

    const updateDots = () => {
      const cardsPerPage = getCardsPerPage();
      const totalPages = Math.ceil(realCount / cardsPerPage);
      dots.forEach((dot, i) => {
        if (i < totalPages) {
          dot.style.display = "";
          dot.classList.toggle("bg-[#333333]", i === activePage);
          dot.classList.toggle("bg-[#d1d1d1]", i !== activePage);
        } else {
          dot.style.display = "none";
        }
      });
    };

    const wrapPosition = (): number => {
      const step = getCardStep();
      const range = realCount * step;
      const leftEdge = 0;
      const rightEdge = -(CLONE_COUNT + realCount + (CLONE_COUNT - getCardsPerPage())) * step;

      if (currentX > leftEdge) {
        const shift = -range;
        setTransform(currentX + shift);
        return shift;
      } else if (currentX < rightEdge) {
        const shift = range;
        setTransform(currentX + shift);
        return shift;
      }
      return 0;
    };

    normalizePosition();
    updateDots();

    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    const animateTo = (targetX: number, duration = 450, onDone?: () => void) => {
      if (animationId !== null) cancelAnimationFrame(animationId);

      const startX = currentX;
      const distance = targetX - startX;

      if (Math.abs(distance) < 0.5) {
        setTransform(targetX);
        onDone?.();
        return;
      }

      const startTime = performance.now();

      const step = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        setTransform(startX + distance * easeOutCubic(progress));

        if (progress < 1) {
          animationId = requestAnimationFrame(step);
        } else {
          animationId = null;
          onDone?.();
        }
      };

      animationId = requestAnimationFrame(step);
    };

    const goToPage = (pageIndex: number) => {
      const cardsPerPage = getCardsPerPage();
      const step = getCardStep();
      const totalPages = Math.ceil(realCount / cardsPerPage);

      const targetX = -(CLONE_COUNT + pageIndex * cardsPerPage) * step;

      activePage = ((pageIndex % totalPages) + totalPages) % totalPages;
      updateDots();

      animateTo(targetX, 450, () => {
        normalizePosition();
      });
    };

    previous?.addEventListener("click", () => goToPage(activePage - 1));
    next?.addEventListener("click", () => goToPage(activePage + 1));

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => goToPage(index));
    });

    window.addEventListener("resize", () => {
      if (isDragging) return;
      normalizePosition();
      updateDots();
    });

    /* ── Drag-to-swipe ── */
    let isDragging = false;
    let hasDragged = false;
    let dragStartX = 0;
    let dragStartTranslate = 0;
    let startPage = 0;

    let lastMoveX = 0;
    let lastMoveTime = 0;
    let velocity = 0;

    const DRAG_THRESHOLD = 25;
    const VELOCITY_THRESHOLD = 0.25;

    const stopDragging = () => {
      if (!isDragging) return;
      isDragging = false;

      if (!hasDragged) return;

      const dragDistance = currentX - dragStartTranslate;
      let targetPage = startPage;

      if (Math.abs(velocity) > VELOCITY_THRESHOLD) {
        targetPage = velocity > 0 ? startPage + 1 : startPage - 1;
      } else if (Math.abs(dragDistance) > DRAG_THRESHOLD) {
        targetPage = dragDistance < 0 ? startPage + 1 : startPage - 1;
      }

      goToPage(targetPage);
    };

    const handleDragMove = (clientX: number) => {
      if (!isDragging) return;

      const now = performance.now();
      const dt = now - lastMoveTime;
      const dx = clientX - lastMoveX;

      if (dt > 0) {
        const instantVelocity = -dx / dt;
        velocity = 0.7 * velocity + 0.3 * instantVelocity;
      }

      lastMoveX = clientX;
      lastMoveTime = now;

      const distance = clientX - dragStartX;
      if (Math.abs(distance) > 3) hasDragged = true;
      setTransform(dragStartTranslate + distance);

      const shift = wrapPosition();
      if (shift !== 0) {
        dragStartTranslate += shift;
        const cardsPerPage = getCardsPerPage();
        const step = getCardStep();
        const currentCard = Math.round(-currentX / step - CLONE_COUNT);
        startPage = Math.round(currentCard / cardsPerPage);
      }
    };

    const handleDragStart = (clientX: number) => {
      if (animationId !== null) {
        cancelAnimationFrame(animationId);
        animationId = null;
      }

      isDragging = true;
      hasDragged = false;
      dragStartX = clientX;
      dragStartTranslate = currentX;
      const cardsPerPage = getCardsPerPage();
      const step = getCardStep();
      const currentCard = Math.round(-currentX / step - CLONE_COUNT);
      startPage = Math.round(currentCard / cardsPerPage);
      lastMoveX = clientX;
      lastMoveTime = performance.now();
      velocity = 0;
    };

    carousel.addEventListener("mousedown", (event) => {
      if (event.button !== 0 || (event.target as HTMLElement).closest("button, a")) return;
      handleDragStart(event.clientX);
      event.preventDefault();
    });

    window.addEventListener("mousemove", (event) => handleDragMove(event.clientX));
    window.addEventListener("mouseup", stopDragging);
    window.addEventListener("blur", stopDragging);

    carousel.addEventListener("click", (event) => {
      if (!hasDragged) return;
      event.preventDefault();
      event.stopPropagation();
      hasDragged = false;
    }, true);

    carousel.addEventListener("touchstart", (event) => {
      if ((event.target as HTMLElement).closest("button, a")) return;
      handleDragStart(event.touches[0].clientX);
    }, { passive: true });

    window.addEventListener("touchmove", (event) => {
      if (!isDragging) return;
      handleDragMove(event.touches[0].clientX);
    }, { passive: true });

    window.addEventListener("touchend", stopDragging);
  }
</script>
