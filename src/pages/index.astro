---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import ProductBoxCard from "../components/ProductBoxCard.astro";
import { products } from "../Bestsellerdata";
import { boxsets } from "../Boxsetdata";
import banner from "../assets/banner.jpg";
import bannerMobile from "../assets/banner_mobile.jpg";
import cocoaDutch from "../assets/Cocoa Dutch.jpg";
import { getImage, Image } from "astro:assets";

const [mobileBanner, desktopBanner] = await Promise.all([
  getImage({
    src: bannerMobile,
    format: "webp",
    quality: 80,
    width: 960,
    widths: [480, 640, 960, 1280, 1440],
  }),
  getImage({
    src: banner,
    format: "webp",
    quality: 80,
    width: 1920,
    widths: [1024, 1280, 1600, 1920],
  }),
]);
---

<Layout>
  <Navbar />
  <main>
    <section class="relative flex min-h-[92svh] sm:min-h-screen flex-col justify-end lg:flex-row lg:items-center overflow-hidden bg-[#080a09] text-white">
      <!-- Select one banner source for the current viewport. -->
      <picture>
        <source
          media="(min-width: 1024px)"
          type="image/webp"
          srcset={desktopBanner.srcSet.attribute}
          sizes="100vw"
          width={desktopBanner.attributes.width}
          height={desktopBanner.attributes.height}
        />
        <img
          src={mobileBanner.src}
          srcset={mobileBanner.srcSet.attribute}
          sizes="100vw"
          width={mobileBanner.attributes.width}
          height={mobileBanner.attributes.height}
          alt="Tea producers in a Japanese tea field"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute top-0 inset-x-0 w-full h-[65%] object-cover object-[50%_20%] lg:inset-0 lg:size-full lg:object-right"
        />
      </picture>

      <div class="lg:hidden absolute top-0 inset-x-0 h-28 bg-linear-to-b from-[#080a09]/80 via-[#080a09]/30 to-transparent pointer-events-none z-5"></div>
      <div class="lg:hidden absolute inset-0 bg-linear-to-b from-transparent via-[#080a09]/40 via-40% to-[#080a09] to-70% pointer-events-none z-5"></div>

      <div class="page-container relative z-10 pb-24 sm:pb-16 lg:pb-0 lg:mt-16 text-left">
        <h1 class="min-w-0 flex flex-col gap-2 sm:gap-3.5 lg:gap-5 max-w-4xl font-display text-[#c5a259] text-[clamp(13px,3.8vw,44px)] leading-none uppercase tracking-wide sm:tracking-wider [-webkit-text-stroke:0.8px_#c5a259] sm:[-webkit-text-stroke:1.5px_#c5a259] lg:[-webkit-text-stroke:2px_#c5a259] [paint-order:stroke_fill]">
          <span class="block whitespace-nowrap">From Japan’s Finest</span>
          <span class="block whitespace-nowrap">Terroir to Your Daily Ritual.</span>
        </h1>
        <div class="mt-5 sm:mt-7">
          <a href="#best-sellers" class="inline-flex rounded-md bg-white px-6 py-3 font-sans text-[12px] font-bold text-[#12221b] transition hover:bg-[#eee9e3]">
            Explore Matcha
          </a>
        </div>
      </div>
    </section>

    <section id="special-selection" aria-labelledby="special-selection-title" class="border-y border-[#C5A259] bg-[#12221B] text-[#FFFFFF]">
      <div class="page-container mx-auto max-w-7xl py-12 sm:py-16 lg:py-20">
        <div class="grid min-w-0 items-stretch gap-6 lg:grid-cols-12 lg:gap-0">
          <div class="min-w-0 bg-[#080A09] p-2 sm:p-3 lg:col-span-7 lg:p-4">
            <Image
              src={cocoaDutch}
              alt="Cocoa Dutch by Flourist, a Dutch cocoa drink priced at 100 THB"
              format="webp"
              quality={82}
              width={900}
              widths={[360, 540, 720, 900, 1200]}
              sizes="(min-width: 1280px) 700px, (min-width: 1024px) 58vw, calc(100vw - 40px)"
              loading="lazy"
              class="block h-auto w-full"
            />
          </div>

          <div class="min-w-0 flex flex-col justify-center border border-[#C5A259] p-6 sm:p-8 md:p-10 lg:col-span-5 lg:border-l-0 lg:p-10 xl:p-14">
            <p class="font-sans text-[10px] tracking-[0.28em] text-[#C5A259] uppercase sm:text-xs">
              Flourist / Special Selection
            </p>
            <h2 id="special-selection-title" class="mt-6 max-w-full break-words font-display text-[clamp(2.5rem,10vw,4rem)] uppercase leading-[1.1] tracking-normal text-[#FFFFFF] sm:mt-7 sm:text-[clamp(3rem,7vw,4.5rem)] lg:text-[clamp(3rem,3.8vw,4.5rem)]">
              Cocoa<br />Dutch
            </h2>
            <div class="mt-9 h-px w-14 bg-[#C5A259]"></div>
            <p class="mt-7 max-w-sm font-sans text-sm leading-7 text-[#FFFFFF] sm:text-base sm:leading-8">
              Deep Dutch cocoa, poured slowly. A rich and velvety house special for unhurried afternoons.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-[#C5A259] pt-5">
              <span class="font-sans text-2xl font-light text-[#FFFFFF]">100 THB</span>
              <span class="font-sans text-xs text-[#FFFFFF] sm:text-sm">Available at all branches</span>
            </div>
            <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
              <a href="/map" class="inline-flex min-h-11 w-fit items-center gap-3 border-b border-[#C5A259] py-2 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">
                Find a branch <span aria-hidden="true">↗</span>
              </a>
              <button type="button" aria-controls="delivery-options" aria-expanded="false" aria-haspopup="dialog" class="delivery-trigger inline-flex min-h-11 w-fit cursor-pointer items-center gap-3 border-b border-[#C5A259] bg-transparent py-2 font-sans text-sm text-[#FFFFFF] transition-colors hover:text-[#C5A259] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#C5A259]">
                Order delivery <span aria-hidden="true">↗</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section id="best-sellers" class="page-container mx-auto max-w-7xl lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#c5a259] sm:text-[22px]">Best Sellers - สินค้าขายดี</h2>
      <ProductCarousel products={products} />
    </section>

    <section class="bg-[#12221b]">
      <div class="page-container mx-auto max-w-5xl py-12 text-center text-white sm:py-16 md:py-20">
        <h3 class="font-sans text-sm sm:text-base md:text-lg lg:text-xl font-normal leading-relaxed md:leading-loose">
          รับข่าวสารเกี่ยวกับการเปิดตัวคอลเล็กชั่น การติดต่อเพื่อส่งข่าวสารสุดพิเศษ <br class="hidden sm:inline" />
          และข่าวสารล่าสุดจากแบรนด์สุดเอ็กซ์คลูซีฟได้ที่นี่
        </h3>
      </div>
    </section>

    <section id="sokutai-collection" class="page-container mx-auto max-w-7xl py-16 lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#c5a259] sm:text-[22px]">The Sokutai Collection - โซกุไต Box set </h2>
      <div class="space-y-12">
        {
          boxsets.map((boxset) => (
            <ProductBoxCard boxset={boxset} />
          ))
        }
      </div>
    </section>
  </main>
</Layout>
