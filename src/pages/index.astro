---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductBoxCard from "../components/ProductBoxCard.astro";
import { products } from "../Bestsellerdata";
import { boxsets } from "../Boxsetdata";
import banner from "../assets/banner.jpg";

const pageSize = 4;
const productPages = Array.from(
  { length: Math.ceil(products.length / pageSize) },
  (_, pageIndex) => products.slice(pageIndex * pageSize, (pageIndex + 1) * pageSize),
);
const boxsetPages = Array.from(
  { length: Math.ceil(boxsets.length / pageSize) },
  (_, pageIndex) => boxsets.slice(pageIndex * pageSize, (pageIndex + 1) * pageSize),
);
---

<Layout>
  <Navbar />
  <main>
    <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-black text-white">
      <img src={banner.src} alt="Tea producers in a Japanese tea field" class="absolute inset-0 size-full object-cover" />
      <div class="absolute inset-0 bg-black/50"></div>

      <div class="relative z-10 mx-auto mt-16 px-6 text-center">
        <h1 class="font-sans text-3xl leading-tight sm:text-4xl md:text-[28px]">
          From Japan’s Finest Terroir to Your Daily Ritual.
        </h1>
        <a href="#best-sellers" class="mt-7 inline-flex rounded-md bg-white px-5 py-3 font-sans text-[12px] font-bold text-[#12221b] transition hover:bg-[#eee9e3]">
          Explore Matcha
        </a>
      </div>
    </section>

    <section id="best-sellers" class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#171513] sm:text-[22px]">Best Sellers - สินค้าขายดี</h2>

      <div class="group relative">
        <div data-product-carousel class="cursor-grab overflow-hidden select-none active:cursor-grabbing">
          <div data-product-track class="flex gap-5 will-change-transform">
          {
            productPages.map((page) => (
              <div data-product-page class="grid min-w-full grid-cols-4 gap-4">
                {page.map((product) => <ProductCard product={product} />)}
              </div>
            ))
          }
          </div>
        </div>

        <button
          type="button"
          data-carousel-prev
          aria-label="Previous products"
          class="pointer-events-auto absolute left-1 top-[150px] z-10 inline-flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-3xl leading-none text-white opacity-100 transition hover:bg-black/65 focus-visible:opacity-100 lg:pointer-events-none lg:opacity-0 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
        >
          &lsaquo;
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Next products"
          class="pointer-events-auto absolute right-1 top-[150px] z-10 inline-flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-3xl leading-none text-white opacity-100 transition hover:bg-black/65 focus-visible:opacity-100 lg:pointer-events-none lg:opacity-0 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
        >
          &rsaquo;
        </button>
      </div>

      <div class="mt-8 flex justify-center gap-2" aria-label="Choose product page">
        {
          productPages.map((_, index) => (
            <button
              type="button"
              data-carousel-dot={index}
              aria-label={`Go to product page ${index + 1}`}
              class:list={["size-2.5 rounded-full bg-[#d1d1d1] transition-colors", index === 0 && "bg-[#333333]"]}
            ></button>
          ))
        }
      </div>
    </section>

    <section>
      <div class="p-20 bg-[#12221b]">
       <div class="mx-auto max-w-7xl px-6 text-center text-white sm:px-8 text-2xl">
        <h3>รับข่าวสารเกี่ยวกับการเปิดตัวคอลเล็กชั่น การติดต่อเพื่อส่งข่าวสารสุดพิเศษ <br>
        และข่าวสารล่าสุดจากแบรนด์สุดเอ็กซ์คลูซีฟได้ที่นี่</h3>
      </div>
      </div>
    </section>

        <section id="best-sellers" class="mx-auto max-w-7xl px-6 py-24 sm:px-8 lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#171513] sm:text-[22px]">The Sokutai Collection - โซกุไต Box set </h2>
      <div class="group relative">
        <div data-product-carousel class="flex cursor-grab gap-5 overflow-x-auto select-none overscroll-x-contain active:cursor-grabbing [scrollbar-width:none]">
          {
            boxsetPages.map((page) => (
              <div data-product-page class="grid min-w-full grid-cols-4 gap-4">
                {page.map((boxset) => <ProductBoxCard boxset={boxset} />)}
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const carousel = document.querySelector<HTMLElement>("[data-product-carousel]");
  const track = document.querySelector<HTMLElement>("[data-product-track]");
  const realPages = Array.from(track?.querySelectorAll<HTMLElement>("[data-product-page]") ?? []);
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
  const previous = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");

  if (carousel && track && realPages.length > 1) {
    /* ── Clone first & last pages for infinite illusion ── */
    const firstClone = realPages[0].cloneNode(true) as HTMLElement;
    const lastClone = realPages[realPages.length - 1].cloneNode(true) as HTMLElement;
    firstClone.setAttribute("aria-hidden", "true");
    lastClone.setAttribute("aria-hidden", "true");
    track.appendChild(firstClone);
    track.prepend(lastClone);

    // Layout: [clone-last][page-0][page-1]...[page-n-1][clone-first]
    // Slide indices: 0=clone-last, 1=page-0, ..., n=page-n-1, n+1=clone-first
    const len = realPages.length;
    let activePage = 0;
    let currentX = 0;
    let animationId: number | null = null;

    const getPageWidth = () => realPages[0].offsetWidth + 20;

    const setTransform = (x: number) => {
      currentX = x;
      track.style.transform = `translateX(${x}px)`;
    };

    const setActivePage = (index: number) => {
      activePage = index;
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-[#333333]", i === index);
        dot.classList.toggle("bg-[#d1d1d1]", i !== index);
      });
    };

    // Wrap currentX into the real-page range, returns the shift applied
    const wrapPosition = (): number => {
      const pw = getPageWidth();
      const range = len * pw;
      // Only wrap when we've scrolled PAST the clone entirely
      // This ensures after wrapping we land inside the real-page range
      const leftEdge = 0;                  // fully past clone-last
      const rightEdge = -(len + 1) * pw;   // fully past clone-first

      if (currentX > leftEdge) {
        const shift = -range;
        setTransform(currentX + shift);
        return shift;
      } else if (currentX < rightEdge) {
        const shift = range;
        setTransform(currentX + shift);
        return shift;
      }
      return 0;
    };

    // Start at real page 0 = slide 1
    setTransform(-getPageWidth());

    /* ── Smooth animation with easing ── */
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

    const animateTo = (targetX: number, duration = 450, onDone?: () => void) => {
      if (animationId !== null) cancelAnimationFrame(animationId);

      const startX = currentX;
      const distance = targetX - startX;

      if (Math.abs(distance) < 0.5) {
        setTransform(targetX);
        onDone?.();
        return;
      }

      const startTime = performance.now();

      const step = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        setTransform(startX + distance * easeOutCubic(progress));

        if (progress < 1) {
          animationId = requestAnimationFrame(step);
        } else {
          animationId = null;
          // Wrap after animation completes (in case we animated to a clone)
          wrapPosition();
          onDone?.();
        }
      };

      animationId = requestAnimationFrame(step);
    };

    const goToPage = (index: number) => {
      const pw = getPageWidth();
      // Slide index = real page index + 1
      const slideIndex = index + 1;
      const targetX = -slideIndex * pw;

      animateTo(targetX, 450);

      const wrappedIndex = ((index % len) + len) % len;
      setActivePage(wrappedIndex);
    };

    previous?.addEventListener("click", () => goToPage(activePage - 1));
    next?.addEventListener("click", () => goToPage(activePage + 1));

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => goToPage(index));
    });

    /* ── Drag-to-swipe ── */
    let isDragging = false;
    let hasDragged = false;
    let dragStartX = 0;
    let dragStartTranslate = 0;
    let startPage = 0;

    let lastMoveX = 0;
    let lastMoveTime = 0;
    let velocity = 0;

    const DRAG_THRESHOLD = 30;
    const VELOCITY_THRESHOLD = 0.3;

    const findNearestPage = (): number => {
      const pw = getPageWidth();
      // Current slide index (fractional)
      const slideIndex = -currentX / pw;
      // Real page index = slide index - 1
      const realIndex = Math.round(slideIndex - 1);
      return ((realIndex % len) + len) % len;
    };

    const stopDragging = () => {
      if (!isDragging) return;
      isDragging = false;

      if (!hasDragged) return;

      const dragDistance = currentX - dragStartTranslate;
      let targetPage = startPage;

      if (Math.abs(velocity) > VELOCITY_THRESHOLD) {
        targetPage = velocity > 0 ? startPage + 1 : startPage - 1;
      } else if (Math.abs(dragDistance) > DRAG_THRESHOLD) {
        targetPage = dragDistance < 0 ? startPage + 1 : startPage - 1;
      }

      goToPage(targetPage);
    };

    const handleDragMove = (clientX: number) => {
      if (!isDragging) return;

      const now = performance.now();
      const dt = now - lastMoveTime;
      const dx = clientX - lastMoveX;

      if (dt > 0) {
        const instantVelocity = -dx / dt;
        velocity = 0.7 * velocity + 0.3 * instantVelocity;
      }

      lastMoveX = clientX;
      lastMoveTime = now;

      const distance = clientX - dragStartX;
      if (Math.abs(distance) > 3) hasDragged = true;
      setTransform(dragStartTranslate + distance);

      // Live wrap: if dragged into clone territory, teleport seamlessly
      const shift = wrapPosition();
      if (shift !== 0) {
        dragStartTranslate += shift;
        // Update startPage to reflect new position
        startPage = findNearestPage();
      }
    };

    const handleDragStart = (clientX: number) => {
      if (animationId !== null) {
        cancelAnimationFrame(animationId);
        animationId = null;
      }

      isDragging = true;
      hasDragged = false;
      dragStartX = clientX;
      dragStartTranslate = currentX;
      startPage = activePage;
      lastMoveX = clientX;
      lastMoveTime = performance.now();
      velocity = 0;
    };

    // Mouse events
    carousel.addEventListener("mousedown", (event) => {
      if (event.button !== 0 || (event.target as HTMLElement).closest("button, a")) return;
      handleDragStart(event.clientX);
      event.preventDefault();
    });

    window.addEventListener("mousemove", (event) => handleDragMove(event.clientX));
    window.addEventListener("mouseup", stopDragging);
    window.addEventListener("blur", stopDragging);

    carousel.addEventListener("click", (event) => {
      if (!hasDragged) return;
      event.preventDefault();
      event.stopPropagation();
      hasDragged = false;
    }, true);

    // Touch events
    carousel.addEventListener("touchstart", (event) => {
      if ((event.target as HTMLElement).closest("button, a")) return;
      handleDragStart(event.touches[0].clientX);
    }, { passive: true });

    window.addEventListener("touchmove", (event) => {
      if (!isDragging) return;
      handleDragMove(event.touches[0].clientX);
    }, { passive: true });

    window.addEventListener("touchend", stopDragging);
  }
</script>
