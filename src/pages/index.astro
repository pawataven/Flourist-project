---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import ProductCard from "../components/ProductCard.astro";
import ProductBoxCard from "../components/ProductBoxCard.astro";
import { products } from "../Bestsellerdata";
import { boxsets } from "../Boxsetdata";
import banner from "../assets/banner.jpg";

---

<script>
  const carousel = document.querySelector<HTMLElement>("[data-product-carousel]");
  const track = document.querySelector<HTMLElement>("[data-product-track]");
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"));
  const previous = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-carousel-next]");

  if (carousel && track) {
    const originalItems = Array.from(track.querySelectorAll<HTMLElement>("[data-product-item]"));
    const realCount = originalItems.length;

    if (realCount > 1) {
      // Create a 3-set infinite track ([Set 0: 8 items][Set 1: 8 items (Home)][Set 2: 8 items])
      // This allows infinite continuous scrolling in both directions with zero boundaries
      for (let i = realCount - 1; i >= 0; i--) {
        const cloneBefore = originalItems[i].cloneNode(true) as HTMLElement;
        cloneBefore.setAttribute("aria-hidden", "true");
        track.prepend(cloneBefore);
      }
      for (let i = 0; i < realCount; i++) {
        const cloneAfter = originalItems[i].cloneNode(true) as HTMLElement;
        cloneAfter.setAttribute("aria-hidden", "true");
        track.appendChild(cloneAfter);
      }

      let cardStep = 0;
      let cardsPerPage = 2;
      let totalPages = 4;
      let pageStep = 0;
      let cycleWidth = 0;

      let currentX = 0;
      let targetX = 0;
      let rafId: number | null = null;

      const measure = () => {
        cardsPerPage = window.innerWidth >= 1024 ? 4 : 2;
        totalPages = Math.ceil(realCount / cardsPerPage);

        const firstItem = track.querySelector<HTMLElement>("[data-product-item]");
        const gap = window.innerWidth >= 640 ? 20 : 16;
        cardStep = (firstItem?.offsetWidth ?? 0) + gap;
        pageStep = cardsPerPage * cardStep;
        cycleWidth = realCount * cardStep;
      };

      measure();
      currentX = -cycleWidth;
      targetX = -cycleWidth;
      track.style.transform = `translate3d(${currentX}px, 0, 0)`;

      const normalizeBounds = () => {
        while (currentX < -2 * cycleWidth) {
          currentX += cycleWidth;
          targetX += cycleWidth;
        }
        while (currentX > -cycleWidth) {
          currentX -= cycleWidth;
          targetX -= cycleWidth;
        }
      };

      const updateDots = () => {
        const normPos = ((-currentX - cycleWidth) % cycleWidth + cycleWidth) % cycleWidth;
        const activeIndex = Math.min(totalPages - 1, Math.max(0, Math.round(normPos / pageStep) % totalPages));

        dots.forEach((dot, i) => {
          if (i < totalPages) {
            dot.style.display = "";
            if (i === activeIndex) {
              dot.classList.add("bg-[#333333]");
              dot.classList.remove("bg-[#d1d1d1]");
            } else {
              dot.classList.remove("bg-[#333333]");
              dot.classList.add("bg-[#d1d1d1]");
            }
          } else {
            dot.style.display = "none";
          }
        });
      };

      // Fluid Spring/Lerp Physics Loop (60/120fps hardware compositor)
      const tick = () => {
        const dist = targetX - currentX;
        if (Math.abs(dist) > 0.3) {
          currentX += dist * 0.18; // snappy, instantaneous response with soft landing
          normalizeBounds();
          track.style.transform = `translate3d(${currentX}px, 0, 0)`;
          updateDots();
          rafId = requestAnimationFrame(tick);
        } else {
          currentX = targetX;
          normalizeBounds();
          track.style.transform = `translate3d(${currentX}px, 0, 0)`;
          updateDots();
          rafId = null;
        }
      };

      const startAnimation = () => {
        if (rafId === null) {
          rafId = requestAnimationFrame(tick);
        }
      };

      // Rapid-click support with ZERO delay:
      // Each click instantly advances targetX by pageStep without waiting for any animation
      const goNext = () => {
        const currentTargetPage = Math.round((-targetX - cycleWidth) / pageStep);
        targetX = -(cycleWidth + (currentTargetPage + 1) * pageStep);
        startAnimation();
      };

      const goPrev = () => {
        const currentTargetPage = Math.round((-targetX - cycleWidth) / pageStep);
        targetX = -(cycleWidth + (currentTargetPage - 1) * pageStep);
        startAnimation();
      };

      next?.addEventListener("click", goNext);
      previous?.addEventListener("click", goPrev);

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          const currentTargetPage = Math.round((-targetX - cycleWidth) / pageStep);
          const currentPageMod = ((currentTargetPage % totalPages) + totalPages) % totalPages;
          let diff = i - currentPageMod;
          if (diff > totalPages / 2) diff -= totalPages;
          if (diff < -totalPages / 2) diff += totalPages;
          targetX = -(cycleWidth + (currentTargetPage + diff) * pageStep);
          startAnimation();
        });
      });

      window.addEventListener("resize", () => {
        measure();
        const nearestPage = Math.round((-currentX - cycleWidth) / pageStep);
        currentX = -(cycleWidth + nearestPage * pageStep);
        targetX = currentX;
        normalizeBounds();
        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
        updateDots();
      });

      /* ── Touch & Pointer Gesture Handling (Exact 1 Dot per Swipe) ── */
      let isTouching = false;
      let isHorizontalSwipe: boolean | undefined = undefined;
      let touchStartX = 0;
      let touchStartY = 0;
      let touchStartPage = 0;
      let dragStartCurrentX = 0;
      let lastTouchX = 0;
      let lastTouchTime = 0;
      let touchVelocity = 0;
      let touchLastDx = 0;
      let hasMoved = false;

      const onTouchStart = (e: TouchEvent) => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }

        isTouching = true;
        hasMoved = false;
        isHorizontalSwipe = undefined;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        lastTouchX = touchStartX;
        lastTouchTime = performance.now();
        dragStartCurrentX = currentX;
        touchStartPage = Math.round((-currentX - cycleWidth) / pageStep);
        touchVelocity = 0;
        touchLastDx = 0;
      };

      const onTouchMove = (e: TouchEvent) => {
        if (!isTouching) return;

        const currentClientX = e.touches[0].clientX;
        const currentClientY = e.touches[0].clientY;
        const dx = currentClientX - touchStartX;
        const dy = currentClientY - touchStartY;

        // Detect swipe angle on first 5px
        if (isHorizontalSwipe === undefined) {
          const absX = Math.abs(dx);
          const absY = Math.abs(dy);
          if (absX > 5 || absY > 5) {
            isHorizontalSwipe = absX > absY;
          }
        }

        // Vertical scroll -> release touch to browser
        if (isHorizontalSwipe === false) {
          isTouching = false;
          return;
        }

        // Horizontal swipe -> lock vertical page and track finger 1:1
        if (isHorizontalSwipe === true) {
          if (e.cancelable) e.preventDefault();
          hasMoved = true;
          touchLastDx = dx;

          const now = performance.now();
          const dt = now - lastTouchTime;
          if (dt > 0) {
            const instantV = (currentClientX - lastTouchX) / dt;
            touchVelocity = 0.7 * touchVelocity + 0.3 * instantV;
          }
          lastTouchX = currentClientX;
          lastTouchTime = now;

          currentX = dragStartCurrentX + dx;
          targetX = currentX;

          // Continuous wrap during drag
          while (currentX < -2 * cycleWidth) {
            currentX += cycleWidth;
            targetX += cycleWidth;
            dragStartCurrentX += cycleWidth;
          }
          while (currentX > -cycleWidth) {
            currentX -= cycleWidth;
            targetX -= cycleWidth;
            dragStartCurrentX -= cycleWidth;
          }

          track.style.transform = `translate3d(${currentX}px, 0, 0)`;
          updateDots();
        }
      };

      const onTouchEnd = () => {
        if (!isTouching) return;
        isTouching = false;

        if (!hasMoved) return;

        // Strictly move at most 1 page (1 dot) per swipe
        const threshold = pageStep * 0.15;
        let pageDiff = 0;

        if (touchVelocity < -0.25 || touchLastDx < -threshold) {
          pageDiff = 1;
        } else if (touchVelocity > 0.25 || touchLastDx > threshold) {
          pageDiff = -1;
        }

        targetX = -(cycleWidth + (touchStartPage + pageDiff) * pageStep);
        startAnimation();
      };

      carousel.addEventListener("touchstart", onTouchStart, { passive: false });
      carousel.addEventListener("touchmove", onTouchMove, { passive: false });
      carousel.addEventListener("touchend", onTouchEnd, { passive: true });
      carousel.addEventListener("touchcancel", onTouchEnd, { passive: true });

      /* ── Desktop Mouse Drag Support (Exact 1 Dot per Drag) ── */
      let isMouseDown = false;
      let mouseStartX = 0;
      let mouseStartCurrentX = 0;
      let mouseStartPage = 0;
      let mouseLastDx = 0;
      let lastMouseX = 0;
      let lastMouseTime = 0;
      let mouseVelocity = 0;

      carousel.addEventListener("mousedown", (e) => {
        if (e.button !== 0 || (e.target as HTMLElement).closest("button, a")) return;
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }

        isMouseDown = true;
        hasMoved = false;
        mouseStartX = e.pageX;
        lastMouseX = mouseStartX;
        lastMouseTime = performance.now();
        mouseStartCurrentX = currentX;
        mouseStartPage = Math.round((-currentX - cycleWidth) / pageStep);
        mouseVelocity = 0;
        mouseLastDx = 0;
      });

      window.addEventListener("mousemove", (e) => {
        if (!isMouseDown) return;
        e.preventDefault();

        const dx = e.pageX - mouseStartX;
        if (Math.abs(dx) > 3) hasMoved = true;
        mouseLastDx = dx;

        const now = performance.now();
        const dt = now - lastMouseTime;
        if (dt > 0) {
          const instantV = (e.pageX - lastMouseX) / dt;
          mouseVelocity = 0.7 * mouseVelocity + 0.3 * instantV;
        }
        lastMouseX = e.pageX;
        lastMouseTime = now;

        currentX = mouseStartCurrentX + dx;
        targetX = currentX;

        while (currentX < -2 * cycleWidth) {
          currentX += cycleWidth;
          targetX += cycleWidth;
          mouseStartCurrentX += cycleWidth;
        }
        while (currentX > -cycleWidth) {
          currentX -= cycleWidth;
          targetX -= cycleWidth;
          mouseStartCurrentX -= cycleWidth;
        }

        track.style.transform = `translate3d(${currentX}px, 0, 0)`;
        updateDots();
      });

      const onMouseUp = () => {
        if (!isMouseDown) return;
        isMouseDown = false;
        if (!hasMoved) return;

        // Strictly move at most 1 page (1 dot) per drag
        const threshold = pageStep * 0.15;
        let pageDiff = 0;

        if (mouseVelocity < -0.25 || mouseLastDx < -threshold) {
          pageDiff = 1;
        } else if (mouseVelocity > 0.25 || mouseLastDx > threshold) {
          pageDiff = -1;
        }

        targetX = -(cycleWidth + (mouseStartPage + pageDiff) * pageStep);
        startAnimation();
      };

      window.addEventListener("mouseup", onMouseUp);

      carousel.addEventListener(
        "click",
        (e) => {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
            hasMoved = false;
          }
        },
        true
      );

      updateDots();
    }
  }
</script>


<Layout>
  <Navbar />
  <main>
    <section class="relative flex min-h-[92svh] sm:min-h-screen flex-col justify-end lg:flex-row lg:items-center overflow-hidden bg-[#080a09] text-white">
      <!-- Banner Image: Optimized for both mobile framing (people centered) and desktop right-side framing -->
      <img
        src={banner.src}
        alt="Tea producers in a Japanese tea field"
        class="absolute top-0 inset-x-0 h-[58%] sm:h-[65%] lg:inset-y-0 lg:left-auto lg:right-0 lg:h-full lg:w-[70%] object-cover object-[52%_20%] lg:object-right"
      />

      <!-- Mobile Top Navbar blend overlay -->
      <div class="lg:hidden absolute top-0 inset-x-0 h-28 bg-gradient-to-b from-[#080a09]/80 via-[#080a09]/30 to-transparent pointer-events-none z-[5]"></div>

      <!-- Mobile Vertical Gradient: Smooth fade from photo into #080a09 content base -->
      <div class="lg:hidden absolute inset-0 bg-gradient-to-b from-transparent via-[#080a09]/40 via-40% to-[#080a09] to-70% pointer-events-none z-[5]"></div>

      <!-- Desktop Luxury #080a09 horizontal gradient fade from left to right — smooth multi-stop -->
      <div class="hidden lg:block absolute inset-0 bg-[linear-gradient(to_right,#080a09_0%,#080a09_25%,rgba(8,10,9,0.92)_35%,rgba(8,10,9,0.75)_45%,rgba(8,10,9,0.55)_55%,rgba(8,10,9,0.3)_65%,rgba(8,10,9,0.12)_78%,transparent_92%)] pointer-events-none z-[5]"></div>
      <!-- Desktop Subtle top and bottom blend -->
      <div class="hidden lg:block absolute inset-0 bg-[linear-gradient(to_bottom,rgba(8,10,9,0.5)_0%,rgba(8,10,9,0.15)_25%,transparent_45%,transparent_60%,rgba(8,10,9,0.2)_80%,rgba(8,10,9,0.7)_100%)] pointer-events-none z-[5]"></div>

      <!-- Headline & Call to action -->
      <div class="relative z-10 w-full px-6 sm:px-10 lg:px-16 pb-12 sm:pb-16 lg:pb-0 lg:mt-16 text-left">
        <h1 class="max-w-4xl font-display text-[#c5a259] text-2xl sm:text-4xl md:text-[36px] lg:text-[42px] leading-tight uppercase [-webkit-text-stroke:1.5px_#c5a259] sm:[-webkit-text-stroke:2px_#c5a259] [paint-order:stroke_fill]">
          From Japan’s Finest Terroir to Your Daily Ritual.
        </h1>
        <div class="mt-5 sm:mt-7">
          <a href="#best-sellers" class="inline-flex rounded-md bg-white px-6 py-3 font-sans text-[12px] font-bold text-[#12221b] transition hover:bg-[#eee9e3]">
            Explore Matcha
          </a>
        </div>
      </div>
    </section>

    <section id="best-sellers" class="mx-auto max-w-7xl px-6 py-16 sm:px-8 lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#c5a259] sm:text-[22px]">Best Sellers - สินค้าขายดี</h2>

      <div class="group relative">
        <div data-product-carousel class="cursor-grab overflow-hidden select-none touch-pan-y active:cursor-grabbing">
          <div data-product-track class="flex gap-4 sm:gap-5 will-change-transform">
          {
            products.map((product) => (
              <div data-product-item class="w-[calc(50%-8px)] sm:w-[calc(50%-10px)] lg:w-[calc(25%-15px)] shrink-0">
                <ProductCard product={product} />
              </div>
            ))
          }
          </div>
        </div>

        <button
          type="button"
          data-carousel-prev
          aria-label="Previous products"
          class="pointer-events-auto absolute left-1 top-[100px] sm:top-[150px] z-10 inline-flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-3xl leading-none text-white opacity-100 transition hover:bg-black/65 focus-visible:opacity-100 lg:pointer-events-none lg:opacity-0 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
        >
          &lsaquo;
        </button>
        <button
          type="button"
          data-carousel-next
          aria-label="Next products"
          class="pointer-events-auto absolute right-1 top-[100px] sm:top-[150px] z-10 inline-flex size-9 -translate-y-1/2 items-center justify-center rounded-full bg-black/45 text-3xl leading-none text-white opacity-100 transition hover:bg-black/65 focus-visible:opacity-100 lg:pointer-events-none lg:opacity-0 lg:group-hover:pointer-events-auto lg:group-hover:opacity-100"
        >
          &rsaquo;
        </button>
      </div>

      <div class="mt-8 flex justify-center gap-2" data-carousel-dots aria-label="Choose product page">
        {
          Array.from({ length: 4 }).map((_, index) => (
            <button
              type="button"
              data-carousel-dot={index}
              aria-label={`Go to product page ${index + 1}`}
              class:list={[
                "size-2.5 rounded-full bg-[#d1d1d1] transition-colors",
                index === 0 && "bg-[#333333]",
                index >= 2 && "lg:hidden"
              ]}
            ></button>
          ))
        }
      </div>
    </section>

    <section class="bg-[#12221b]">
      <div class="mx-auto max-w-5xl px-6 py-12 text-center text-white sm:py-16 md:py-20">
        <h3 class="font-sans text-sm sm:text-base md:text-lg lg:text-xl font-normal leading-relaxed md:leading-loose">
          รับข่าวสารเกี่ยวกับการเปิดตัวคอลเล็กชั่น การติดต่อเพื่อส่งข่าวสารสุดพิเศษ <br class="hidden sm:inline" />
          และข่าวสารล่าสุดจากแบรนด์สุดเอ็กซ์คลูซีฟได้ที่นี่
        </h3>
      </div>
    </section>

    <section id="sokutai-collection" class="mx-auto max-w-7xl px-6 py-24 sm:px-8 lg:py-24">
      <h2 class="mb-8 font-sans text-[20px] text-[#c5a259] sm:text-[22px]">The Sokutai Collection - โซกุไต Box set </h2>
      <div class="group relative">
        <div class="flex gap-5 sm:gap-6 overflow-x-auto select-none [scrollbar-width:none]">
          <div class="flex gap-5 sm:gap-6 w-full">
          {
            boxsets.map((boxset) => (
              <div class="w-[400px] max-w-full shrink-0">
                <ProductBoxCard boxset={boxset} />
              </div>
            ))
          }
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
