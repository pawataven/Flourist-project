---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";

import eventpic from "../assets/events/Evens.jpg";
---

<Layout>
  <Navbar />

  <main class="bg-[#080a09] text-white overflow-x-hidden">
    <div class="page-container mx-auto">

      <!-- HEADER -->
      <header class="pt-16 sm:pt-24 lg:pt-32 pb-8 sm:pb-10 lg:pb-12">

        <!-- overline -->
        <div class="flex items-center gap-3 mb-4 sm:mb-5">
          <span class="w-4 sm:w-5 h-px bg-[#c5a259]"></span>
          <span class="font-sans text-[9px] sm:text-[10px] tracking-[0.3em] sm:tracking-[0.35em] uppercase text-[#c5a259]">
            Flourist Matchahouse &bull; Special Event
          </span>
        </div>

        <!-- Title + date row -->
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3 sm:gap-4 lg:gap-6">
          <h1 class="font-display text-[clamp(1.1rem,5.5vw,38px)] uppercase leading-none tracking-[-0.01em] text-white whitespace-nowrap">
            The Leaf&rsquo;s <span class="text-[#c5a259]">Secret</span>
          </h1>

          <div class="flex flex-col gap-1 text-left lg:text-right shrink-0 pb-0.5">
            <div class="flex items-center lg:justify-end gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-[#c5a259] animate-pulse shrink-0"></span>
              <span class="font-sans text-[11px] sm:text-[13px] lg:text-[14px] text-white/60 tracking-[0.1em] lg:tracking-[0.12em]">
                23 กันยายน &ndash; 4 ตุลาคม 2026
              </span>
            </div>
            <p class="font-sans text-[9px] sm:text-[11px] lg:text-[12px] text-white/30 tracking-[0.15em] lg:tracking-[0.2em]">
              Seacon Bangkae Hall &middot; 10:30 &ndash; 21:30 น.
            </p>
          </div>
        </div>
      </header>

      <!-- IMAGE -->
      <section class="pb-10 sm:pb-12 lg:pb-16">
        <img
          src={eventpic.src}
          alt="THONBURI CAFE: The Leaf's Secret — Flourist Events"
          width={eventpic.width}
          height={eventpic.height}
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="w-full max-w-9xl mx-auto block h-auto select-none rounded-lg sm:rounded-xl"
        />
      </section>


      <!-- CONTENT -->
      <section class="pb-24 sm:pb-28 lg:pb-32">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] xl:grid-cols-[1fr_300px] gap-10 sm:gap-12 lg:gap-20 items-start max-w-6xl mx-auto">

          <!-- LEFT -->
          <div>
            <p class="font-sans text-lg sm:text-xl lg:text-3xl text-white/85 leading-relaxed mb-4 sm:mb-5 max-w-3xl">
              ความลับของมัจจะ กำลังจะถูกเผยที่ฝั่งธนฯ
            </p>

            <p class="font-sans text-xs sm:text-[16px] text-white/50 leading-[1.9] sm:leading-[2] font-light mb-3 sm:mb-4 max-w-lg">
              สาวกมัทฉะห้ามพลาด! <span class="text-white/75">FLOURIST Matcha House</span> ขอเชิญชวนทุกคนมาร่วมค้นหาความอร่อยในงาน
              <span class="text-white/75">&ldquo;THONBURI CAF&Eacute;: The Leaf&rsquo;s Secret&rdquo;</span>
            </p>

            <p class="font-sans text-xs sm:text-[16px] text-white/35 leading-[1.9] sm:leading-[2] font-light max-w-lg mb-10 sm:mb-12">
              ครั้งนี้เรายกความประณีตระดับพรีเมียมมาเสิร์ฟให้ถึงที่ พร้อมไฮไลต์สุดพิเศษที่คุณไม่ควรพลาด
            </p>

            <!-- numbered highlight list -->
            <div class="divide-y divide-white/8 border-t border-white/8 max-w-lg">

              <div class="py-4 sm:py-5 flex items-start gap-4 sm:gap-5">
                <span class="font-sans text-[9px] sm:text-[12px] tracking-widest text-[#c5a259] shrink-0 mt-0.5">01</span>
                <div>
                  <p class="font-sans text-xs sm:text-[16px] text-white/85 font-medium mb-1">Special Event Menu</p>
                  <p class="font-sans text-[11px] sm:text-[16px] text-white/38 font-light leading-relaxed">
                    สัมผัสรสชาติเมนูพิเศษที่สร้างสรรค์ขึ้นเฉพาะงานนี้เท่านั้น
                  </p>
                </div>
              </div>

              <div class="py-4 sm:py-5 flex items-start gap-4 sm:gap-5">
                <span class="font-sans text-[9px] sm:text-[12px] tracking-widest text-[#c5a259] shrink-0 mt-0.5">02</span>
                <div>
                  <p class="font-sans text-xs sm:text-[16px] text-white/85 font-medium mb-1">Ceremonial Grade Matcha</p>
                  <p class="font-sans text-[11px] sm:text-[16px] text-white/38 font-light leading-relaxed">
                    คัดสรรผงมัทฉะเกรดพิธีการ หอม นุ่ม ละมุน รสอูมามิกลมกล่อม
                  </p>
                </div>
              </div>

              <div class="py-4 sm:py-5 flex items-start gap-4 sm:gap-5 border-b border-white/8">
                <span class="font-sans text-[9px] sm:text-[12px] tracking-widest text-[#c5a259] shrink-0 mt:0.5">03</span>
                <div>
                  <p class="font-sans text-xs sm:text-[16px] text-white/85 font-medium mb-1">Crafted with Care</p>
                  <p class="font-sans text-[11px] sm:text-[16px] text-white/38 font-light leading-relaxed">
                    ขนมหวานและเครื่องดื่มมัทฉะสูตรพิเศษที่คราฟต์อย่างตั้งใจในทุกขั้นตอน
                  </p>
                </div>
              </div>

            </div>
          </div>

          <!-- RIGHT: sticky event info -->
          <aside class="lg:sticky lg:top-32 pt-2">
            <p class="font-sans text-[12px] tracking-[0.4em] uppercase text-[#c5a259]/60 mb-6 sm:mb-8">Event Info</p>

            <div class="space-y-5 sm:space-y-7">

              <div>
                <p class="font-sans text-[12px] tracking-[0.28em] uppercase text-white/22 mb-1.5 sm:mb-2">วันที่</p>
                <p class="font-sans text-base sm:text-lg text-white/88 leading-snug">23 กันยายน &ndash; 4 ตุลาคม 2026</p>
              </div>

              <div class="h-px bg-white/7"></div>

              <div>
                <p class="font-sans text-[12px] tracking-[0.28em] uppercase text-white/22 mb-1.5 sm:mb-2">สถานที่</p>
                <p class="font-sans text-base sm:text-lg text-white/88 leading-snug">Seacon Bangkae Hall</p>
                <p class="font-sans text-[11px] sm:text-[12px] text-white/28 mt-1">ซีคอน บางแค</p>
                <a
                  href="https://www.google.com/maps/place/ซีคอน+บางแค/@13.711446,100.4334605,19z/data=!3m2!4b1!5s0x30e297f47543c249:0x468cd99c0c265335!4m6!3m5!1s0x30e297f475a6cc69:0x8eddef9a39ba368a!8m2!3d13.711446!4d100.4341056!16s%2Fm%2F0zbv18_?entry=ttu&g_ep=EgoyMDI2MDkyOS4wIKXMDSoASAFQAw%3D%3D"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 mt-3 font-sans text-[11px] sm:text-xs text-[#c5a259]/70 hover:text-[#c5a259] transition-colors duration-200 group"
                >
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="shrink-0" aria-hidden="true">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
                  </svg>
                  <span class="border-b border-[#c5a259]/30 group-hover:border-[#c5a259]/70 transition-colors pb-px">เปิดใน Google Maps</span>
                  <svg width="8" height="8" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M1 9L9 1M9 1H3M9 1V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>

              <div class="h-px bg-white/7"></div>

              <div>
                <p class="font-sans text-[12px] tracking-[0.28em] uppercase text-white/22 mb-1.5 sm:mb-2">เวลา</p>
                <p class="font-sans text-base sm:text-lg text-white/88 leading-snug">10:30 &ndash; 21:30 น.</p>
              </div>

            </div>
          </aside>

        </div>
      </section>

    </div>
  </main>
</Layout>