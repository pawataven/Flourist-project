---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import MenuBook from "../components/menu/MenuBook.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import { productsSignature } from "../data/Bestsellerdata";
import { productsDessert } from "../data/DessertData";
---

<Layout>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/menu-pages/page-1-cover.svg" type="image/svg+xml" fetchpriority="high" />
    <link rel="preload" as="image" href="/menu-pages/page-2.svg" type="image/svg+xml" />
    <link rel="preload" as="image" href="/menu-pages/page-3.svg" type="image/svg+xml" />
  </Fragment>

  <Navbar />

  <!-- Fullscreen viewport layout containing Navbar spacer and Book stage -->
  <div
    class="relative h-[100dvh] w-full flex flex-col bg-[#080a09] text-white overflow-hidden box-border"
  >
    <!-- Navbar Spacer: dynamically matches the fixed header height so book is guaranteed to sit BELOW navbar -->
    <div
      id="menu-nav-spacer"
      class="w-full shrink-0 h-[112px] sm:h-[124px] xl:h-[64px] transition-all pointer-events-none"
    >
    </div>

    <!-- Centered Book Stage within remaining space strictly below navbar (explicit 0 padding to override global main pb-24) -->
    <main
      id="menu-stage-container"
      class="w-full flex-1 min-h-0 flex items-center justify-center relative !p-0 !pb-0 overflow-hidden box-border"
    >
      <MenuBook />
    </main>

    <!-- Mobile / Tablet Quick Scroll Indicator to Carousels -->
    <div class="xl:hidden absolute bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 z-30 pointer-events-auto">
      <a
        href="#signature"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-black/80 backdrop-blur-md border border-[#c5a259]/60 text-[#c5a259] text-[11px] sm:text-xs font-sans tracking-wider shadow-lg hover:bg-[#c5a259] hover:text-black transition-all active:scale-95"
        aria-label="เลื่อนลงเพื่อดูรายการสินค้า"
      >
        <span>เลื่อนดูสินค้า</span>
        <svg class="w-3.5 h-3.5 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <section
    id="signature"
    class="page-container mx-auto max-w-7xl py-12 sm:py-16 lg:pt-20 scroll-mt-20 sm:scroll-mt-24"
  >
    <h2
      class="mb-6 sm:mb-8 font-display uppercase text-[clamp(15px,4.5vw,22px)] tracking-[0.1em] sm:tracking-[0.14em] text-[#c5a259] whitespace-nowrap"
    >
      Signature
    </h2>
    <ProductCarousel products={productsSignature} />
  </section>

  <section
    id="dessert"
    class="page-container mx-auto max-w-7xl py-12 sm:py-16 lg:mb-20 scroll-mt-20 sm:scroll-mt-24"
  >
    <h2
      class="mb-6 sm:mb-8 font-display uppercase text-[clamp(15px,4.5vw,22px)] tracking-[0.1em] sm:tracking-[0.14em] text-[#c5a259] whitespace-nowrap"
    >
      Dessert
    </h2>
    <ProductCarousel products={productsDessert} />
  </section>

</Layout>

<style>
  main#menu-stage-container {
    padding: 0 !important;
    padding-bottom: 0 !important;
    margin: 0 !important;
  }
</style>
