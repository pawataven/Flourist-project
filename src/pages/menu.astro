---
import Layout from "../layouts/Layout.astro";
import Navbar from "../layouts/Navbar.astro";
import menuA2 from "../assets/menu/menuA2.jpg";
---

<Layout>
  <Navbar />

  <main class="relative min-h-screen bg-[#080a09] text-white pt-40 sm:pt-48 lg:pt-56 pb-16 sm:pb-24 overflow-hidden">
    <!-- Ambient Gold Glow -->
    <div class="pointer-events-none absolute top-12 left-1/4 -translate-x-1/2 w-[500px] h-[280px] bg-[#c5a259]/10 blur-[130px] rounded-full -z-10" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-[96vw] 2xl:max-w-[1860px] px-2 sm:px-4 md:px-6">
      <!-- Page Header -->
      <div class="mb-8 sm:mb-10 text-center md:text-left flex flex-col md:flex-row md:items-end justify-between gap-6 px-1 sm:px-2">
        <div>
          <div class="flex items-center justify-center md:justify-start gap-2.5">
            <span class="inline-block w-5 h-px bg-[#c5a259]"></span>
            <p class="font-sans text-[11px] sm:text-xs tracking-[0.3em] uppercase text-[#c5a259] font-medium">
              Flourist Matchahouse &bull; Menu
            </p>
          </div>
          <div>
            <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl uppercase tracking-[0.08em] leading-normal text-[#c5a259] [-webkit-text-stroke:0.8px_#c5a259] sm:[-webkit-text-stroke:1.2px_#c5a259] lg:[-webkit-text-stroke:1.5px_#c5a259] [paint-order:stroke_fill] drop-shadow-[0_2px_12px_rgba(197,162,89,0.2)]">
              Menu
            </h1>
          </div>
          <div class="mt-2 h-0.5 w-20 bg-linear-to-r from-[#c5a259] to-transparent mx-auto md:mx-0"></div>
          <p class="mt-3 font-sans text-xs sm:text-sm text-white/75 max-w-xl font-light leading-relaxed">
            สัมผัสรสชาติมัทฉะแท้จากญี่ปุ่น เครื่องดื่ม และขนมหวานสุดพิเศษ
          </p>
        </div>

        <div class="flex items-center justify-center md:justify-end gap-3">
          <a
            href={menuA2.src}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2.5 rounded-lg border border-[#c5a259]/70 bg-[#12221b] px-5 py-2.5 font-sans text-xs sm:text-sm font-medium text-[#c5a259] transition-all duration-300 hover:bg-[#c5a259] hover:text-[#080a09] hover:shadow-[0_0_20px_rgba(197,162,89,0.3)] hover:scale-[1.02] focus-visible:outline-2 focus-visible:outline-[#c5a259]"
          >
            <span>ดูภาพขนาดเต็ม (Full Resolution)</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
          </a>
        </div>
      </div>

      <!-- Menu Image Display (Large, almost edge-to-edge) -->
      <div class="relative overflow-hidden rounded-xl border border-[#c5a259]/40 bg-[#0e1b15] shadow-2xl transition hover:border-[#c5a259]/70">
        <a
          href={menuA2.src}
          target="_blank"
          rel="noopener noreferrer"
          class="group block relative cursor-zoom-in overflow-hidden"
          title="คลิกเพื่อดูภาพขนาดเต็ม"
        >
          <img
            src={menuA2.src}
            alt="Flourist Menu - เมนูเครื่องดื่มและมัทฉะ"
            width={menuA2.width}
            height={menuA2.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="w-full h-auto block select-none"
          />
        </a>
      </div>

      <p class="mt-4 text-center font-sans text-xs text-white/50">
        * แตะหรือคลิกที่รูปเพื่อเปิดดูภาพขนาดเต็มความละเอียดสูง
      </p>
    </div>
  </main>
</Layout>
