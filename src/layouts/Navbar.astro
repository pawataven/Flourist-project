---
import logo from "../assets/Asset 2-8.png";
import logohover from "../assets/Asset_hover.png";
import { stores } from "../StoreData";

const menuItems = [
    { label: "Menu", href: "/", detail: "Find your daily ritual" },
    { label: "Events", href: "#", detail: "Coming soon" },
    { label: "Maps", href: "/map", detail: "Visit our matchahouse" },
    { label: "About", href: "/about", detail: "The story of Flourist" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<flourist-navigation>
    <header class="site-header group fixed inset-x-0 top-0 z-50 text-white">
        <div class="announcement">
            <span class="announcement-mark" aria-hidden="true">✦</span>
            <p>Orders over $150 receive free shipping.<span class="announcement-extra"> All Subscriptions ship free in the USA.</span></p>
            <span class="announcement-mark" aria-hidden="true">✦</span>
        </div>
        <nav aria-label="Main navigation" class="desktop-nav hidden h-[92px] w-full items-center justify-between gap-6 bg-[#12221b] px-16 transition-colors duration-300 group-data-[scrolled]:bg-transparent xl:flex">
            <a href="/" aria-label="Flourist Matchahouse home" class="shrink-0">
                <span class="relative block h-[50px] w-auto">
                    <img src={logo.src} width={logo.width} height={logo.height} alt="Flourist Matchahouse" class="h-[50px] w-auto object-contain transition-opacity duration-300 group-data-[scrolled]:opacity-0" />
                    <img src={logohover.src} width={logohover.width} height={logohover.height} alt="" aria-hidden="true" class="absolute inset-0 h-[50px] w-auto object-contain opacity-0 transition-opacity duration-300 group-data-[scrolled]:opacity-100" />
                </span>
            </a>
            <ul class="flex items-center gap-10 text-[16px]">
                {menuItems.map(({ label, href }) => (
                    <li>
                        {href === "#" ? <span class="cursor-default opacity-60">{label}</span> : <a href={href} aria-current={href === currentPath ? "page" : undefined} class="transition-opacity hover:opacity-60">{label}</a>}
                    </li>
                ))}
            </ul>
            <button type="button" class="delivery-trigger rounded-md border border-current px-5 py-2 text-sm transition hover:bg-white hover:text-black" aria-label="Order Delivery" aria-controls="delivery-options" aria-expanded="false">
                <span class="delivery-label-full">Order Delivery</span>
                <span class="delivery-label-short">Order</span>
            </button>
        </nav>
        <nav aria-label="Mobile navigation" class="compact-nav">
            <button type="button" class="menu-toggle nav-control" aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog">
                <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M3 8h18M3 16h12" /></svg>
                <span class="control-label">Menu</span>
            </button>
            <a href="/" aria-label="Flourist Matchahouse home" class="compact-logo">
                <img src={logo.src} width={logo.width} height={logo.height} alt="Flourist Matchahouse" />
                <img src={logohover.src} width={logohover.width} height={logohover.height} alt="" aria-hidden="true" class="logo-dark" />
            </a>
            <button type="button" class="delivery-trigger delivery-control" aria-label="Order Delivery" aria-controls="delivery-options" aria-expanded="false">
                <span class="delivery-label-full">Order Delivery</span>
                <span class="delivery-label-short">Order</span>
            </button>
        </nav>
    </header>
    <dialog id="mobile-menu" class="menu-dialog" aria-labelledby="menu-title">
        <div class="menu-sheet">
            <div class="sheet-header">
                <a href="/" aria-label="Flourist Matchahouse home" class="sheet-logo"><img src={logohover.src} width={logohover.width} height={logohover.height} alt="Flourist Matchahouse" /></a>
                <button type="button" class="close-menu nav-control" aria-label="Close menu" autofocus>
                    <span class="control-label">Close</span>
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>
            <div class="sheet-content">
                <div class="menu-intro"><span class="eyebrow" id="menu-title">Explore Flourist</span><span class="intro-line" aria-hidden="true"></span><span class="intro-mark" aria-hidden="true">茶</span></div>
                <nav aria-label="Explore Flourist">
                    <ul class="menu-links">
                        {menuItems.map(({ label, href, detail }, index) => (
                            <li>
                                {href === "#" ? (
                                    <span class="menu-link unavailable" aria-disabled="true">
                                        <span class="link-number" aria-hidden="true">0{index + 1}</span>
                                        <span class="link-copy"><span class="link-title">{label}</span><span class="link-detail">{detail}</span></span>
                                        <span class="soon-mark" aria-hidden="true">Soon</span>
                                    </span>
                                ) : (
                                    <a href={href} class="menu-link" aria-current={href === currentPath ? "page" : undefined}>
                                        <span class="link-number" aria-hidden="true">0{index + 1}</span>
                                        <span class="link-copy"><span class="link-title">{label}</span><span class="link-detail">{detail}</span></span>
                                        <svg class="link-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
                                    </a>
                                )}
                            </li>
                        ))}
                    </ul>
                </nav>
                <div class="menu-footer">
                    <p class="ritual-copy">A little pause.<br /><em>A finer daily ritual.</em></p>
                    <a href="/#best-sellers" class="explore-link"><span>Explore Matcha</span><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg></a>
                    <div class="footer-note"><span>Flourist Matchahouse</span><span aria-hidden="true">✦</span><span>Made for slow moments</span></div>
                </div>
            </div>
        </div>
    </dialog>
    <dialog id="delivery-options" class="delivery-dialog" aria-labelledby="delivery-dialog-title">
        <div class="delivery-sheet">
            <div class="delivery-dialog-header">
                <div>
                    <span class="eyebrow">Order online</span>
                    <h2 id="delivery-dialog-title">Order delivery</h2>
                </div>
                <button type="button" class="close-delivery nav-control" aria-label="Close delivery options">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </div>
            <div class="delivery-progress" data-delivery-progress role="status">Step 1 of 3</div>
            <p class="delivery-context" data-delivery-context hidden>กำลังเลือกสาขาสำหรับ <strong data-selected-provider></strong></p>
            <div class="delivery-step" data-delivery-step="provider">
                <p class="delivery-copy">เลือกแพลตฟอร์มที่ต้องการสั่ง</p>
                <div class="delivery-links">
                    <button type="button" class="delivery-provider" data-provider="lineMan">
                        <span class="delivery-provider-name">สั่งผ่าน LINE MAN</span>
                        <svg class="delivery-provider-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
                    </button>
                    <button type="button" class="delivery-provider" data-provider="grab">
                        <span class="delivery-provider-name">สั่งผ่าน Grab</span>
                        <svg class="delivery-provider-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
                    </button>
                </div>
            </div>
            <div class="delivery-step" data-delivery-step="mode" hidden>
                <button type="button" class="delivery-back" data-delivery-back="provider">← เปลี่ยนผู้ให้บริการ</button>
                <p class="delivery-copy">เลือกวิธีค้นหาสาขาที่ต้องการสั่ง</p>
                <div class="delivery-mode-links">
                    <button type="button" class="delivery-mode" data-delivery-mode="nearby">
                        <span><strong>สาขาใกล้ฉัน</strong><small>ใช้ตำแหน่งปัจจุบันเพื่อหาสาขาที่ใกล้ที่สุด</small></span>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                    </button>
                    <button type="button" class="delivery-mode" data-delivery-mode="manual">
                        <span><strong>เลือกสาขาเอง</strong><small>เลือกจากรายชื่อสาขาทั้งหมด</small></span>
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
                    </button>
                </div>
            </div>
            <div class="delivery-step" data-delivery-step="nearby" hidden>
                <button type="button" class="delivery-back" data-delivery-back="mode">← ย้อนกลับ</button>
                <p class="delivery-copy">ระบบจะใช้ตำแหน่งปัจจุบันของคุณเพื่อเลือกสาขาที่ใกล้ที่สุด</p>
                <p class="delivery-status" data-nearby-status role="status">กำลังค้นหาสาขาที่ใกล้คุณจากตำแหน่งปัจจุบัน…</p>
                <div class="delivery-nearby-result" data-nearby-result hidden>
                    <span class="eyebrow">Nearest branch</span>
                    <strong data-nearby-name></strong>
                    <small data-nearby-distance></small>
                    <a class="delivery-confirm" data-nearby-link target="_blank" rel="noopener noreferrer" href="#">ยืนยันสาขาและไปสั่ง</a>
                </div>
                <button type="button" class="delivery-secondary" data-delivery-back="mode">เลือกสาขาเอง</button>
            </div>
            <div class="delivery-step" data-delivery-step="manual" hidden>
                <button type="button" class="delivery-back" data-delivery-back="mode">← ย้อนกลับ</button>
                <p class="delivery-copy">เลือกสาขาที่ต้องการสั่ง</p>
                <label class="sr-only" for="delivery-branch-search">Search branches</label>
                <input id="delivery-branch-search" class="delivery-search" type="search" placeholder="ค้นหาชื่อสาขาหรือเขต" autocomplete="off" />
                <p class="delivery-count" data-branch-count></p>
                <div class="delivery-branch-list" data-branch-list>
                    {stores.map((store) => (
                        <a
                            class="delivery-branch"
                            href="#"
                            target="_blank"
                            rel="noopener noreferrer"
                            data-store-id={store.id}
                            data-store-name={store.name}
                            data-store-district={store.district}
                            data-store-province={store.province}
                            data-store-lat={store.lat}
                            data-store-lng={store.lng}
                            data-line-man-url={store.delivery.lineManUrl}
                            data-grab-url={store.delivery.grabUrl}
                        >
                            <span><strong>{store.name}</strong><small>{store.district} · {store.province}</small></span>
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" /></svg>
                        </a>
                    ))}
                </div>
                <p class="delivery-empty" data-branch-empty hidden>ไม่พบสาขาที่ค้นหา</p>
            </div>
        </div>
    </dialog>
</flourist-navigation>

<script>
    class FlouristNavigation extends HTMLElement {
        private cleanup?: () => void;

        connectedCallback() {
            this.cleanup?.();
            const header = this.querySelector<HTMLElement>(".site-header");
            const toggle = this.querySelector<HTMLButtonElement>(".menu-toggle");
            const dialog = this.querySelector<HTMLDialogElement>(".menu-dialog");
            const close = this.querySelector<HTMLButtonElement>(".close-menu");
            const deliveryDialog = this.querySelector<HTMLDialogElement>("#delivery-options");
            const deliveryClose = this.querySelector<HTMLButtonElement>(".close-delivery");
            const deliveryTriggers = Array.from(this.querySelectorAll<HTMLButtonElement>(".delivery-trigger"));
            const deliverySteps = Array.from(this.querySelectorAll<HTMLElement>("[data-delivery-step]"));
            const providerButtons = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-provider]"));
            const modeButtons = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-delivery-mode]"));
            const backButtons = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-delivery-back]"));
            const branchLinks = Array.from(this.querySelectorAll<HTMLAnchorElement>(".delivery-branch"));
            const branchSearch = this.querySelector<HTMLInputElement>("#delivery-branch-search");
            const branchCount = this.querySelector<HTMLElement>("[data-branch-count]");
            const branchEmpty = this.querySelector<HTMLElement>("[data-branch-empty]");
            const nearbyStatus = this.querySelector<HTMLElement>("[data-nearby-status]");
            const nearbyResult = this.querySelector<HTMLElement>("[data-nearby-result]");
            const nearbyName = this.querySelector<HTMLElement>("[data-nearby-name]");
            const nearbyDistance = this.querySelector<HTMLElement>("[data-nearby-distance]");
            const nearbyLink = this.querySelector<HTMLAnchorElement>("[data-nearby-link]");
            const deliveryProgress = this.querySelector<HTMLElement>("[data-delivery-progress]");
            const deliveryContext = this.querySelector<HTMLElement>("[data-delivery-context]");
            const selectedProviderName = this.querySelector<HTMLElement>("[data-selected-provider]");
            if (!header || !toggle || !dialog || !close || !deliveryDialog || !deliveryClose || !deliveryTriggers.length || !branchSearch || !branchCount || !branchEmpty || !nearbyStatus || !nearbyResult || !nearbyName || !nearbyDistance || !nearbyLink || !deliveryProgress || !deliveryContext || !selectedProviderName) return;

            const controller = new AbortController();
            const { signal } = controller;
            const desktop = window.matchMedia("(min-width: 1280px)");
            let previousY = window.scrollY;
            let frame = 0;
            let lockedScrollY = 0;
            let savedBodyStyle: string | null = null;
            let scrollLocked = false;
            let lastDeliveryTrigger: HTMLButtonElement | null = null;
            let selectedProvider: "lineMan" | "grab" | null = null;

            const updateHeader = () => {
                frame = 0;
                if (dialog.open || deliveryDialog.open) return;
                const y = Math.max(0, window.scrollY);
                header.toggleAttribute("data-scrolled", y > 16);
                // Keep touch navigation available; only desktop hides on scroll.
                if (!desktop.matches || y <= 60 || header.contains(document.activeElement)) {
                    header.removeAttribute("data-hidden");
                } else if (Math.abs(y - previousY) > 8) {
                    header.toggleAttribute("data-hidden", y > previousY);
                }
                previousY = y;
            };

            const unlockScroll = () => {
                if (!scrollLocked) return;
                scrollLocked = false;
                if (savedBodyStyle === null) document.body.removeAttribute("style");
                else document.body.setAttribute("style", savedBodyStyle);
                window.scrollTo(0, lockedScrollY);
                previousY = lockedScrollY;
            };

            const closeMenu = () => {
                if (!dialog.open) return;
                dialog.close();
                toggle.setAttribute("aria-expanded", "false");
                unlockScroll();
                updateHeader();
            };

            const openDelivery = (trigger: HTMLButtonElement) => {
                if (dialog.open) closeMenu();
                if (deliveryDialog.open) return;
                lastDeliveryTrigger = trigger;
                deliveryDialog.showModal();
                deliveryTriggers.forEach((entry) => entry.setAttribute("aria-expanded", "true"));
                if (!scrollLocked) {
                    lockedScrollY = window.scrollY;
                    savedBodyStyle = document.body.getAttribute("style");
                    Object.assign(document.body.style, {
                        position: "fixed", top: `-${lockedScrollY}px`, width: "100%", overflow: "hidden",
                    });
                    scrollLocked = true;
                }
                header.removeAttribute("data-hidden");
            };

            const closeDelivery = () => {
                if (!deliveryDialog.open) return;
                deliveryDialog.close();
            };

            const showDeliveryStep = (step: string) => {
                deliverySteps.forEach((entry) => {
                    entry.hidden = entry.dataset.deliveryStep !== step;
                });
                deliveryProgress.textContent = step === "provider" ? "Step 1 of 3" : step === "mode" ? "Step 2 of 3" : "Step 3 of 3";
            };

            const providerUrlKey = () => selectedProvider === "lineMan" ? "lineManUrl" : "grabUrl";

            const updateBranchLinks = () => {
                branchLinks.forEach((link) => {
                    const href = selectedProvider ? link.dataset[providerUrlKey()] : "";
                    link.href = href || "#";
                    link.toggleAttribute("aria-disabled", !href);
                });
                nearbyLink.href = "#";
            };

            const filterBranches = () => {
                const query = branchSearch.value.trim().toLocaleLowerCase();
                let visibleCount = 0;
                branchLinks.forEach((link) => {
                    const haystack = [link.dataset.storeName, link.dataset.storeDistrict, link.dataset.storeProvince].join(" ").toLocaleLowerCase();
                    const visible = !query || haystack.includes(query);
                    link.hidden = !visible;
                    if (visible) visibleCount += 1;
                });
                branchEmpty.hidden = visibleCount > 0;
            };

            branchCount.textContent = `มี ${branchLinks.length} สาขาให้เลือก`;

            const distanceInKm = (lat1: number, lng1: number, lat2: number, lng2: number) => {
                const earthRadius = 6371;
                const radians = (degrees: number) => degrees * Math.PI / 180;
                const dLat = radians(lat2 - lat1);
                const dLng = radians(lng2 - lng1);
                const a = Math.sin(dLat / 2) ** 2 + Math.cos(radians(lat1)) * Math.cos(radians(lat2)) * Math.sin(dLng / 2) ** 2;
                return earthRadius * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            };

            const showNearbyError = (message: string) => {
                nearbyResult.hidden = true;
                nearbyStatus.textContent = message;
            };

            const findNearbyBranch = () => {
                nearbyResult.hidden = true;
                nearbyStatus.textContent = "กำลังค้นหาสาขาที่ใกล้คุณจากตำแหน่งปัจจุบัน…";
                if (!navigator.geolocation) {
                    showNearbyError("เบราว์เซอร์นี้ไม่รองรับการค้นหาตำแหน่ง กรุณาเลือกสาขาเอง");
                    return;
                }
                navigator.geolocation.getCurrentPosition(({ coords }) => {
                    const nearest = branchLinks
                        .map((link) => ({
                            link,
                            distance: distanceInKm(coords.latitude, coords.longitude, Number(link.dataset.storeLat), Number(link.dataset.storeLng)),
                        }))
                        .sort((a, b) => a.distance - b.distance)[0];
                    if (!nearest) {
                        showNearbyError("ยังไม่มีข้อมูลสาขา กรุณาเลือกสาขาเอง");
                        return;
                    }
                    const href = selectedProvider ? nearest.link.dataset[providerUrlKey()] : "";
                    nearbyName.textContent = nearest.link.dataset.storeName || "";
                    nearbyDistance.textContent = `ห่างจากตำแหน่งปัจจุบันประมาณ ${nearest.distance.toFixed(1)} กม.`;
                    nearbyLink.href = href || "#";
                    nearbyLink.toggleAttribute("aria-disabled", !href);
                    nearbyLink.dataset.empty = href ? "false" : "true";
                    nearbyStatus.textContent = "พบสาขาที่ใกล้ที่สุดแล้ว";
                    nearbyResult.hidden = false;
                }, () => {
                    showNearbyError("ไม่สามารถเข้าถึงตำแหน่งได้ กรุณาอนุญาต location หรือเลือกสาขาเอง");
                }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 });
            };

            const resetDelivery = () => {
                selectedProvider = null;
                deliveryContext.hidden = true;
                selectedProviderName.textContent = "";
                branchSearch.value = "";
                filterBranches();
                updateBranchLinks();
                nearbyResult.hidden = true;
                nearbyStatus.textContent = "กำลังค้นหาสาขาที่ใกล้คุณจากตำแหน่งปัจจุบัน…";
                showDeliveryStep("provider");
            };

            toggle.addEventListener("click", () => {
                if (dialog.open || desktop.matches) return;
                lockedScrollY = window.scrollY;
                savedBodyStyle = document.body.getAttribute("style");
                dialog.showModal();
                scrollLocked = true;
                Object.assign(document.body.style, {
                    position: "fixed", top: `-${lockedScrollY}px`, width: "100%", overflow: "hidden",
                });
                toggle.setAttribute("aria-expanded", "true");
                header.removeAttribute("data-hidden");
            }, { signal });
            deliveryTriggers.forEach((trigger) => {
                trigger.addEventListener("click", () => openDelivery(trigger), { signal });
            });
            providerButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    selectedProvider = button.dataset.provider === "lineMan" ? "lineMan" : "grab";
                    selectedProviderName.textContent = selectedProvider === "lineMan" ? "LINE MAN" : "Grab";
                    deliveryContext.hidden = false;
                    updateBranchLinks();
                    showDeliveryStep("mode");
                    window.setTimeout(() => modeButtons[0]?.focus(), 0);
                }, { signal });
            });
            modeButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    const mode = button.dataset.deliveryMode;
                    if (mode === "nearby") {
                        showDeliveryStep("nearby");
                        findNearbyBranch();
                    } else {
                        showDeliveryStep("manual");
                        filterBranches();
                        window.setTimeout(() => branchSearch.focus(), 0);
                    }
                }, { signal });
            });
            backButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    const destination = button.dataset.deliveryBack || "provider";
                    if (destination === "provider") {
                        selectedProvider = null;
                        deliveryContext.hidden = true;
                        selectedProviderName.textContent = "";
                        updateBranchLinks();
                    }
                    showDeliveryStep(destination);
                    if (destination === "provider") window.setTimeout(() => providerButtons[0]?.focus(), 0);
                }, { signal });
            });
            branchSearch.addEventListener("input", filterBranches, { signal });
            branchLinks.forEach((link) => {
                link.addEventListener("click", (event) => {
                    if (!selectedProvider || link.getAttribute("href") === "#") event.preventDefault();
                }, { signal });
            });
            nearbyLink.addEventListener("click", (event) => {
                if (nearbyLink.getAttribute("href") === "#" || nearbyLink.dataset.empty === "true") event.preventDefault();
            }, { signal });
            close.addEventListener("click", closeMenu, { signal });
            deliveryClose.addEventListener("click", closeDelivery, { signal });
            dialog.addEventListener("cancel", (event) => {
                event.preventDefault();
                closeMenu();
            }, { signal });
            dialog.addEventListener("close", () => {
                // A queued close event must not unlock a newly reopened menu.
                if (!dialog.open) {
                    toggle.setAttribute("aria-expanded", "false");
                    unlockScroll();
                }
            }, { signal });
            let backdropPressed = false;
            dialog.addEventListener("pointerdown", (event) => {
                backdropPressed = event.target === dialog;
            }, { signal });
            dialog.addEventListener("click", (event) => {
                if (backdropPressed && event.target === dialog) closeMenu();
                backdropPressed = false;
                if (event.target instanceof Element && event.target.closest("a[href]")) closeMenu();
            }, { signal });
            deliveryDialog.addEventListener("cancel", (event) => {
                event.preventDefault();
                closeDelivery();
            }, { signal });
            deliveryDialog.addEventListener("close", () => {
                deliveryTriggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
                unlockScroll();
                const trigger = lastDeliveryTrigger;
                lastDeliveryTrigger = null;
