---
import logo from "../assets/Asset 2-8.png";

interface MenuItem {
    label: string;
    href: string;
}

interface ActionItem {
    label: string;
    path: string;
}

const menuItems: MenuItem[] = [
    { label: "Shop", href: "#" },
    { label: "Events", href: "#" },
    { label: "Maps", href: "#" },
    { label: "About", href: "#" },
];

const actionItems: ActionItem[] = [
    {
        label: "Search",
        path: "m21 21-4.35-4.35m0 0A7.5 7.5 0 1 0 6.15 6.15a7.5 7.5 0 0 0 10.5 10.5Z",
    },
    {
        label: "Account",
        path: "M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.25a8.25 8.25 0 0 1 15 0",
    },
    {
        label: "Shopping bag",
        path: "M15.75 10.5V6a3.75 3.75 0 0 0-7.5 0v4.5m-3 0h13.5l-.75 10.5H6l-.75-10.5Z",
    },
];
---

<script>
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const menu = document.querySelector<HTMLElement>("#mobile-menu");
    const bars = document.querySelector<SVGElement>(".menu-bars");
    const close = document.querySelector<SVGElement>(".menu-close");

    toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
        menu?.setAttribute("aria-hidden", String(isOpen));
        menu?.toggleAttribute("data-open", !isOpen);
        bars?.classList.toggle("hidden", !isOpen);
        close?.classList.toggle("hidden", isOpen);
    });

    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            toggle?.setAttribute("aria-expanded", "false");
            toggle?.setAttribute("aria-label", "Open menu");
            menu.setAttribute("aria-hidden", "true");
            menu.removeAttribute("data-open");
            bars?.classList.remove("hidden");
            close?.classList.add("hidden");
        });
    });

    const siteHeader = document.querySelector<HTMLElement>(".site-header");

    const updateHeader = () => {
        siteHeader?.toggleAttribute("data-scrolled", window.scrollY > 16);
    };

    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
</script>

<header
    class="site-header group fixed inset-x-0 top-0 z-50 border-b border-transparent text-white transition-colors duration-300 data-[scrolled]:border-[#eee9e3] data-[scrolled]:bg-[#faf8f5] data-[scrolled]:text-[#2d2926]"
>
    <div
        class="flex h-9 items-center justify-between bg-[#fff] px-5 text-[11px] tracking-tight text-white sm:px-7 sm:text-xs"
    >
        <button
            type="button"
            aria-label="Previous announcement"
            class="text-lg text-black leading-none transition-opacity hover:opacity-60"
            >‹</button
        >
        <p class="text-center font-sans text-black">
            Orders over $150 receive free shipping. All Subscriptions ship free
            in the USA.
        </p>
        <button
            type="button"
            aria-label="Next announcement"
            class="text-lg text-black leading-none transition-opacity hover:opacity-60"
            >›</button
        >
    </div>

    <nav
        aria-label="Main navigation"
        class="hidden h-[92px] w-full items-center justify-between gap-6 bg-[rgb(18_34_27_/_1)] px-5 transition-colors duration-300 group-data-[scrolled]:bg-transparent sm:px-8 lg:flex"
    >
        <a href="/" aria-label="Flourist Matchahouse home" class="shrink-0">
            <img
                src={logo.src}
                alt="Flourist Matchahouse"
                class="h-[50px] w-auto object-contain"
            />
        </a>

        <ul class="flex items-center gap-10 text-[16px]">
            {
                menuItems.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class="transition-opacity hover:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
                        >
                            {label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex items-center gap-3 sm:gap-5">
            <button
                type="button"
                class="hidden rounded-md border border-current px-5 py-2 text-sm transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 sm:inline-flex"
            >
                Wholesale
            </button>

            {
                actionItems.map(({ label, path }) => (
                    <button
                        type="button"
                        aria-label={label}
                        class="inline-flex size-9 items-center justify-center rounded-full transition-opacity hover:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
                    >
                        <svg
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                            class="size-5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d={path}
                            />
                        </svg>
                    </button>
                ))
            }
        </div>
    </nav>

    <nav
        aria-label="Mobile navigation"
        class="relative flex h-[72px] items-center justify-between bg-[rgb(18_34_27_/_0.7)] px-5 transition-colors duration-300 group-data-[scrolled]:bg-transparent lg:hidden"
    >
        <div class="flex items-center gap-5">
            <button
                type="button"
                aria-label="Open menu"
                aria-controls="mobile-menu"
                aria-expanded="false"
                class="menu-toggle inline-flex size-8 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            >
                <span class="sr-only">Open menu</span>
                <span class="inline-flex" aria-hidden="true">
                    <svg
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.25"
                        class="menu-bars size-5"
                    >
                        <path stroke-linecap="round" d="M4 8h16M4 16h16"></path>
                    </svg>
                    <svg
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.25"
                        class="menu-close hidden size-5"
                    >
                        <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"
                        ></path>
                    </svg>
                </span>
            </button>

            <button
                type="button"
                aria-label="Search"
                class="inline-flex size-8 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            >
                <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.25"
                    class="size-5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d={actionItems[0].path}></path>
                </svg>
            </button>
        </div>

        <a
            href="/"
            aria-label="Flourist Matchahouse home"
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
        >
            <img
                src={logo.src}
                alt="Flourist Matchahouse"
                class="h-11 w-auto object-contain"
            />
        </a>

        <div class="flex items-center gap-4">
            {
                actionItems.slice(1).map(({ label, path }) => (
                    <button
                        type="button"
                        aria-label={label}
                        class="inline-flex size-8 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
                    >
                        <svg
                            aria-hidden="true"
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.25"
                            class="size-5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d={path}
                            />
                        </svg>
                    </button>
                ))
            }
        </div>
    </nav>

    <div
        id="mobile-menu"
        class="max-h-0 overflow-hidden opacity-0 transition-[max-height,opacity] duration-[450ms] ease-in-out data-[open]:max-h-[1000px] data-[open]:bg-[#faf8f5] data-[open]:text-[#171513] data-[open]:opacity-100 lg:hidden"
        aria-hidden="true"
    >
        <ul
            class="divide-y divide-dotted divide-[#8f8982] border-t border-dotted border-[#8f8982] px-5 text-[#171513]"
        >
            {
                menuItems.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class="flex items-center justify-between py-5 font-serif text-[32px] leading-none"
                        >
                            <span>{label}</span>
                            <span
                                class="text-[30px] font-light leading-none"
                                aria-hidden="true"
                            >
                                +
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <div
            class="flex min-h-[calc(100vh-360px)] flex-col justify-end px-5 pb-10 pt-24 font-serif text-[#171513]"
        >
            <p class="mb-5 text-[17px]">Looking for wholesale information?</p>
            <a href="#" class="pl-3 text-[15px]">Learn More</a>
        </div>
    </div>
</header>
