---
import logo from "../assets/Asset 2-8.png";
import logohover from "../assets/Asset_hover.png";

interface MenuItem {
    label: string;
    href: string;
}

interface ActionItem {
    label: string;
    path: string;
}

const menuItems: MenuItem[] = [
    { label: "Menu", href: "/" },
    { label: "Events", href: "#" },
    { label: "Maps", href: "/map" },
    { label: "About", href: "/about" },
];


---

<script>
    const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const menu = document.querySelector<HTMLElement>("#mobile-menu");
    const bars = document.querySelector<SVGElement>(".menu-bars");
    const close = document.querySelector<SVGElement>(".menu-close");

    toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        toggle.setAttribute("aria-label", isOpen ? "Open menu" : "Close menu");
        menu?.setAttribute("aria-hidden", String(isOpen));
        menu?.toggleAttribute("data-open", !isOpen);
        bars?.classList.toggle("hidden", !isOpen);
        close?.classList.toggle("hidden", isOpen);
        if (!isOpen) {
            siteHeader?.removeAttribute("data-hidden");
        }
    });

    menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            toggle?.setAttribute("aria-expanded", "false");
            toggle?.setAttribute("aria-label", "Open menu");
            menu.setAttribute("aria-hidden", "true");
            menu.removeAttribute("data-open");
            bars?.classList.remove("hidden");
            close?.classList.add("hidden");
        });
    });

    const siteHeader = document.querySelector<HTMLElement>(".site-header");
    let lastScrollY = window.scrollY;
    let ticking = false;

    const updateHeader = () => {
        const currentScrollY = window.scrollY;
        const isMenuOpen = menu?.hasAttribute("data-open");

        siteHeader?.toggleAttribute("data-scrolled", currentScrollY > 16);

        if (isMenuOpen || currentScrollY <= 60) {
            siteHeader?.removeAttribute("data-hidden");
            lastScrollY = currentScrollY;
            ticking = false;
            return;
        }

        const diff = currentScrollY - lastScrollY;

        if (diff > 8) {
            // Scrolling down -> hide navbar
            siteHeader?.setAttribute("data-hidden", "");
        } else if (diff < -4) {
            // Scrolling up slightly -> reveal navbar smoothly
            siteHeader?.removeAttribute("data-hidden");
        }

        lastScrollY = currentScrollY;
        ticking = false;
    };

    updateHeader();

    window.addEventListener(
        "scroll",
        () => {
            if (!ticking) {
                window.requestAnimationFrame(updateHeader);
                ticking = true;
            }
        },
        { passive: true }
    );
</script>

<header
    class="site-header group fixed inset-x-0 top-0 z-50 border-b border-transparent text-white transition-all duration-300 ease-in-out data-[scrolled]:border-[#eee9e3] data-[scrolled]:bg-[#faf8f5] data-[scrolled]:text-[#2d2926] data-[hidden]:-translate-y-full"
>
    <div
        class="flex h-9 items-center justify-between bg-[#fff] px-5 text-[11px] tracking-tight text-white sm:px-7 sm:text-xs"
    >
        <button
            type="button"
            aria-label="Previous announcement"
            class="text-lg text-black leading-none transition-opacity hover:opacity-60"
            >‹</button
        >
        <p class="text-center font-sans text-black">
            Orders over $150 receive free shipping. All Subscriptions ship free
            in the USA.
        </p>
        <button
            type="button"
            aria-label="Next announcement"
            class="text-lg text-black leading-none transition-opacity hover:opacity-60"
            >›</button
        >
    </div>

    <nav
        aria-label="Main navigation"
        class="hidden h-[92px] w-full items-center justify-between gap-6 bg-[rgb(18_34_27_/_1)] px-6 sm:px-10 lg:px-16 transition-colors duration-300 group-data-[scrolled]:bg-transparent lg:flex"
    >
        <a href="/" aria-label="Flourist Matchahouse home" class="shrink-0">
            <span class="relative block h-[50px] w-auto">
                <img
                    src={logo.src}
                    alt="Flourist Matchahouse"
                    class="h-[50px] w-auto object-contain transition-opacity duration-300 group-data-[scrolled]:opacity-0"
                />
                <img
                    src={logohover.src}
                    alt=""
                    aria-hidden="true"
                    class="absolute inset-0 h-[50px] w-auto object-contain opacity-0 transition-opacity duration-300 group-data-[scrolled]:opacity-100"
                />
            </span>
        </a>

        <ul class="flex items-center gap-10 text-[16px]">
            {
                menuItems.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class="transition-opacity hover:opacity-60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
                        >
                            {label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex items-center gap-3 sm:gap-5">
            <button
                type="button"
                class="hidden rounded-md border border-current px-5 py-2 text-sm transition hover:bg-white hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 sm:inline-flex"
            >
                Delivery & Pickup
            </button>
        </div>
    </nav>

    <nav
        aria-label="Mobile navigation"
        class="relative flex h-[72px] items-center justify-between bg-[rgb(18_34_27_/_0.7)] px-5 transition-colors duration-300 group-data-[scrolled]:bg-transparent lg:hidden"
    >
        <div class="flex items-center gap-5">
            <button
                type="button"
                aria-label="Open menu"
                aria-controls="mobile-menu"
                aria-expanded="false"
                class="menu-toggle inline-flex size-8 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            >
                <span class="sr-only">Open menu</span>
                <span class="inline-flex" aria-hidden="true">
                    <svg
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.25"
                        class="menu-bars size-5"
                    >
                        <path stroke-linecap="round" d="M4 8h16M4 16h16"></path>
                    </svg>
                    <svg
                        aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="1.25"
                        class="menu-close hidden size-5"
                    >
                        <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18"
                        ></path>
                    </svg>
                </span>
            </button>

            <button
                type="button"
                aria-label="Search"
                class="inline-flex size-8 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            >
                <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.25"
                    class="size-5"
                >
                </svg>
            </button>
        </div>

        <a
            href="/"
            aria-label="Flourist Matchahouse home"
            class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
        >
            <span class="relative block h-11 w-auto">
                <img
                    src={logo.src}
                    alt="Flourist Matchahouse"
                    class="h-11 w-auto object-contain transition-opacity duration-300 group-data-[scrolled]:opacity-0"
                />
                <img
                    src={logohover.src}
                    alt=""
                    aria-hidden="true"
                    class="absolute inset-0 h-11 w-auto object-contain opacity-0 transition-opacity duration-300 group-data-[scrolled]:opacity-100"
                />
            </span>
        </a>
    </nav>

    <div
        id="mobile-menu"
        class="max-h-0 overflow-hidden opacity-0 transition-[max-height,opacity] duration-[450ms] ease-in-out data-[open]:max-h-[1000px] data-[open]:bg-[#faf8f5] data-[open]:text-[#171513] data-[open]:opacity-100 lg:hidden"
        aria-hidden="true"
    >
        <ul
            class="divide-y divide-dotted divide-[#8f8982] border-t border-dotted border-[#8f8982] px-5 text-[#171513]"
        >
            {
                menuItems.map(({ label, href }) => (
                    <li>
                        <a
                            href={href}
                            class="flex items-center justify-between py-5 font-serif text-[32px] leading-none"
                        >
                            <span>{label}</span>
                            <span
                                class="text-[30px] font-light leading-none"
                                aria-hidden="true"
                            >
                                +
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>

        <div
            class="flex min-h-[calc(100vh-360px)] flex-col justify-end px-5 pb-10 pt-24 font-serif text-[#171513]"
        >
            <p class="mb-5 text-[17px]">Looking for wholesale information?</p>
            <a href="#" class="pl-3 text-[15px]">Learn More</a>
        </div>
    </div>
</header>
