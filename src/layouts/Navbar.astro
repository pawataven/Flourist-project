---
import logo from "../assets/Asset 2-8.png";
import logohover from "../assets/Asset_hover.png";
import AnnouncementBar from "../components/navbar/AnnouncementBar.astro";
import DesktopNav, { type MenuItem } from "../components/navbar/DesktopNav.astro";
import CompactNav from "../components/navbar/CompactNav.astro";
import MobileMenu from "../components/navbar/MobileMenu.astro";
import DeliveryModal from "../components/delivery/DeliveryModal.astro";

const menuItems: MenuItem[] = [
    { label: "Menu", href: "/menu", detail: "Find your daily ritual" },
    { label: "Events", href: "#", detail: "Coming soon" },
    { label: "Maps", href: "/map", detail: "Visit our matchahouse" },
    { label: "About", href: "/about", detail: "The story of Flourist" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<flourist-navigation class="contents">
    <header class="site-header group fixed inset-x-0 top-0 z-50 text-white transition-transform duration-300 ease-in-out data-[scrolled]:bg-[#faf8f5] data-[scrolled]:text-[#2d2926] data-[hidden]:-translate-y-full">
        <AnnouncementBar />
        <DesktopNav menuItems={menuItems} currentPath={currentPath} logo={logo} logohover={logohover} />
        <CompactNav logo={logo} logohover={logohover} />
    </header>
    <MobileMenu menuItems={menuItems} currentPath={currentPath} logohover={logohover} />
    <DeliveryModal />
</flourist-navigation>

<script>
    import { lockScroll, unlockScroll } from "../utils/scrollLock";

    class FlouristNavigation extends HTMLElement {
        private cleanup?: () => void;

        connectedCallback() {
            this.cleanup?.();
            const header = this.querySelector<HTMLElement>(".site-header");
            const toggle = this.querySelector<HTMLButtonElement>(".menu-toggle");
            const dialog = this.querySelector<HTMLDialogElement>(".menu-dialog");
            const close = this.querySelector<HTMLButtonElement>(".close-menu");

            if (!header || !toggle || !dialog || !close) return;

            const controller = new AbortController();
            const { signal } = controller;
            const desktop = window.matchMedia("(min-width: 1280px)");
            let previousY = window.scrollY;
            let frame = 0;
            let isDeliveryOpen = false;

            const updateHeader = () => {
                frame = 0;
                if (dialog.open || isDeliveryOpen) return;
                const y = Math.max(0, window.scrollY);
                header.toggleAttribute("data-scrolled", y > 16);

                const maxScrollY = document.documentElement.scrollHeight - window.innerHeight;
                if (y <= 60) {
                    header.removeAttribute("data-hidden");
                } else if (y < maxScrollY && Math.abs(y - previousY) > 6) {
                    const isScrollingDown = y > previousY;
                    if (isScrollingDown) {
                        if (header.contains(document.activeElement)) {
                            (document.activeElement as HTMLElement)?.blur();
                        }
                        header.setAttribute("data-hidden", "");
                    } else {
                        header.removeAttribute("data-hidden");
                    }
                }
                previousY = y;
            };

            const closeMenu = () => {
                if (!dialog.open) return;
                dialog.close();
                toggle.setAttribute("aria-expanded", "false");
                unlockScroll();
                previousY = Math.max(0, window.scrollY);
                updateHeader();
            };

            const openMenu = () => {
                if (dialog.open || desktop.matches) return;
                lockScroll();
                dialog.showModal();
                toggle.setAttribute("aria-expanded", "true");
                header.removeAttribute("data-hidden");
            };

            toggle.addEventListener("click", openMenu, { signal });
            close.addEventListener("click", closeMenu, { signal });

            dialog.addEventListener(
                "cancel",
                (event) => {
                    event.preventDefault();
                    closeMenu();
                },
                { signal }
            );

            dialog.addEventListener(
                "close",
                () => {
                    if (!dialog.open) {
                        toggle.setAttribute("aria-expanded", "false");
                        unlockScroll();
                    }
                },
                { signal }
            );

            let backdropPressed = false;
            dialog.addEventListener(
                "pointerdown",
                (event) => {
                    backdropPressed = event.target === dialog;
                },
                { signal }
            );

            dialog.addEventListener(
                "click",
                (event) => {
                    if (backdropPressed && event.target === dialog) closeMenu();
                    backdropPressed = false;
                    if (event.target instanceof Element && event.target.closest("a[href]")) closeMenu();
                },
                { signal }
            );

            // Close mobile menu if delivery modal opens
            window.addEventListener(
                "flourist:delivery-opened",
                () => {
                    isDeliveryOpen = true;
                    if (dialog.open) closeMenu();
                    header.setAttribute("data-hidden", "");
                },
                { signal }
            );

            window.addEventListener(
                "flourist:delivery-closed",
                () => {
                    isDeliveryOpen = false;
                    previousY = Math.max(0, window.scrollY);
                    updateHeader();
                },
                { signal }
            );

            desktop.addEventListener(
                "change",
                () => {
                    if (desktop.matches) closeMenu();
                    updateHeader();
                },
                { signal }
            );

            header.addEventListener("focusin", () => header.removeAttribute("data-hidden"), { signal });

            window.addEventListener(
                "scroll",
                () => {
                    if (!frame) frame = window.requestAnimationFrame(updateHeader);
                },
                { passive: true, signal }
            );

            window.addEventListener("pagehide", closeMenu, { signal });
            document.addEventListener("astro:before-swap", closeMenu, { signal });
            updateHeader();

            this.cleanup = () => {
                closeMenu();
                controller.abort();
                window.cancelAnimationFrame(frame);
            };
        }

        disconnectedCallback() {
            this.cleanup?.();
        }
    }

    if (!customElements.get("flourist-navigation")) {
        customElements.define("flourist-navigation", FlouristNavigation);
    }
</script>
