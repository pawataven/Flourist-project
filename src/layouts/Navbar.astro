---
import logo from "../assets/Asset 2-8.png";
import logohover from "../assets/Asset_hover.png";
import DesktopNav, { type MenuItem } from "../components/navbar/DesktopNav.astro";
import CompactNav from "../components/navbar/CompactNav.astro";
import MobileMenu from "../components/navbar/MobileMenu.astro";
import DeliveryModal from "../components/delivery/DeliveryModal.astro";

const menuItems: MenuItem[] = [
    { label: "Menu", href: "/menu", detail: "Find your daily ritual" },
    { label: "Events", href: "/events", detail: "Special events & pop-ups" },
    { label: "Maps", href: "/map", detail: "Visit our matchahouse" },
    { label: "About", href: "/about", detail: "The story of Flourist" },
    { label: "Contact Us", href: "/contactUs", detail: "Customer care & visit us" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<flourist-navigation class="contents">
    <header class="site-header w-full text-white bg-[#12221b] border-b border-[#c5a259]/20 relative z-50">
        <DesktopNav menuItems={menuItems} currentPath={currentPath} logo={logo} logohover={logohover} />
        <CompactNav logo={logo} logohover={logohover} />
    </header>
    <MobileMenu menuItems={menuItems} currentPath={currentPath} logohover={logohover} />
    <DeliveryModal />
</flourist-navigation>

<script>
    import { lockScroll, unlockScroll } from "../utils/scrollLock";
    import "../components/delivery/deliveryModal";

    class FlouristNavigation extends HTMLElement {
        private cleanup?: () => void;

        connectedCallback() {
            this.cleanup?.();
            const toggle = this.querySelector<HTMLButtonElement>(".menu-toggle");
            const dialog = this.querySelector<HTMLDialogElement>(".menu-dialog");
            const close = this.querySelector<HTMLButtonElement>(".close-menu");

            if (!toggle || !dialog || !close) return;

            const controller = new AbortController();
            const { signal } = controller;
            const desktop = window.matchMedia("(min-width: 1280px)");

            const closeMenu = () => {
                if (!dialog.open) return;
                dialog.close();
                toggle.setAttribute("aria-expanded", "false");
                unlockScroll();
            };

            const openMenu = () => {
                if (dialog.open || desktop.matches) return;
                lockScroll();
                dialog.showModal();
                toggle.setAttribute("aria-expanded", "true");
            };

            toggle.addEventListener("click", openMenu, { signal });
            close.addEventListener("click", closeMenu, { signal });

            dialog.addEventListener(
                "cancel",
                (event) => {
                    event.preventDefault();
                    closeMenu();
                },
                { signal }
            );

            dialog.addEventListener(
                "close",
                () => {
                    if (!dialog.open) {
                        toggle.setAttribute("aria-expanded", "false");
                        unlockScroll();
                    }
                },
                { signal }
            );

            let backdropPressed = false;
            dialog.addEventListener(
                "pointerdown",
                (event) => {
                    backdropPressed = event.target === dialog;
                },
                { signal }
            );

            dialog.addEventListener(
                "click",
                (event) => {
                    if (backdropPressed && event.target === dialog) closeMenu();
                    backdropPressed = false;
                    if (event.target instanceof Element && event.target.closest("a[href]")) closeMenu();
                },
                { signal }
            );

            // Close mobile menu if delivery modal opens
            window.addEventListener(
                "flourist:delivery-opened",
                () => {
                    if (dialog.open) closeMenu();
                },
                { signal }
            );

            desktop.addEventListener(
                "change",
                () => {
                    if (desktop.matches) closeMenu();
                },
                { signal }
            );

            window.addEventListener("pagehide", closeMenu, { signal });
            document.addEventListener("astro:before-swap", closeMenu, { signal });

            this.cleanup = () => {
                closeMenu();
                controller.abort();
            };
        }

        disconnectedCallback() {
            this.cleanup?.();
        }
    }

    if (!customElements.get("flourist-navigation")) {
        customElements.define("flourist-navigation", FlouristNavigation);
    }
</script>
